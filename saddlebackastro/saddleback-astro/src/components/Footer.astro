---
// Site-wide footer. Same on every page.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-top">
    <div>
      <div class="footer-brand">
        <span class="logo-line1">Saddleback Valley</span>
        <span class="logo-line2">Endodontics</span>
      </div>
      <p class="footer-tag">A specialist practice built around the patient — diagnosis first, decisions together, recovery supported.</p>
    </div>

    <div class="footer-col">
      <h4>Practice</h4>
      <ul>
        <li><a href="/#diagnosis">Diagnosis</a></li>
        <li><a href="/#services">Services</a></li>
        <li><a href="/#team">Team</a></li>
        <li><a href="/#tech">Technology</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Patients</h4>
      <ul>
        <li><a href="/#new-patient">New Patient Forms</a></li>
        <li><a href="/#insurance">Insurance &amp; Billing</a></li>
        <li><a href="/#portal">Patient Portal</a></li>
        <li><a href="/blog/">Journal</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Connect</h4>
      <ul>
        <li><a href="/#contact">Contact</a></li>
        <li><a href="/#doctors">For Doctors</a></li>
        <li><a href="/#careers">Careers</a></li>
        <li><a href="/#press">Press</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div>© {year} Saddleback Valley Endodontics. All rights reserved.</div>
    <div>
      <a href="/#privacy">Privacy</a>
      <a href="/#terms">Terms</a>
      <a href="/#accessibility">Accessibility</a>
    </div>
  </div>
</footer>
