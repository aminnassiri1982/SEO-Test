---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-top">

    <!-- Brand + contact -->
    <div class="footer-brand-col">
      <a href="/" class="footer-brand">
        <span class="footer-logo-line1">Saddleback Valley</span>
        <span class="footer-logo-line2">Endodontics</span>
      </a>
      <p class="footer-tag">Fellowship-trained specialist endodontics in Laguna Hills — saving teeth with precision, technology, and care.</p>
      <ul class="footer-contact-list">
        <li>
          <a href="tel:+19495818890">(949) 581-8890</a>
        </li>
        <li>
          <a href="mailto:office@sbvendo.com">office@sbvendo.com</a>
        </li>
        <li>
          <a href="https://maps.app.goo.gl/x2rcKTvkHVg4LKfw8" target="_blank" rel="noopener noreferrer">
            25261 Paseo De Valencia, Suite 3<br/>Laguna Hills, CA 92637
          </a>
        </li>
        <li class="footer-hours">
          Mon – Fri: 8 am – 5 pm<br/>Answering service after hours
        </li>
      </ul>
    </div>

    <!-- Treatments -->
    <div class="footer-col">
      <h4 class="footer-col-heading">Treatments</h4>
      <ul>
        <li><a href="/treatments/root-canal-treatment/">Root Canal Treatment</a></li>
        <li><a href="/treatments/root-canal-retreatment/">Root Canal Retreatment</a></li>
        <li><a href="/treatments/apical-surgery-apicoectomy/">Apical Surgery</a></li>
        <li><a href="/treatments/anxiety-sedation/">Anxiety &amp; Sedation</a></li>
        <li><a href="/treatments/dental-implant/">Dental Implants</a></li>
        <li><a href="/treatments/">All Treatments</a></li>
      </ul>
    </div>

    <!-- Our Practice -->
    <div class="footer-col">
      <h4 class="footer-col-heading">Our Practice</h4>
      <ul>
        <li><a href="/our-practice/about-us/">About Us</a></li>
        <li><a href="/team/">Meet Our Doctors</a></li>
        <li><a href="/technology/">Advanced Technology</a></li>
        <li><a href="/our-practice/why-choose-us/">Why Choose Us</a></li>
        <li><a href="/our-practice/patient-reviews/">Patient Reviews</a></li>
      </ul>
    </div>

    <!-- For Patients -->
    <div class="footer-col">
      <h4 class="footer-col-heading">For Patients</h4>
      <ul>
        <li><a href="/patients/first-visit/">Your First Visit</a></li>
        <li><a href="/patients/insurance-financing/">Insurance &amp; Financing</a></li>
        <li><a href="/patients/post-operative-instructions/">Post-Op Instructions</a></li>
        <li><a href="/request-an-appointment/">Request an Appointment</a></li>
        <li><a href="/contact/">Contact Us</a></li>
        <li><a href="/for-doctors/">For Referring Doctors</a></li>
        <li><a href="https://securesite29.tdo4endo.com/PatientsLogin.aspx" target="_blank" rel="noopener noreferrer">Patient Login</a></li>
      </ul>
    </div>

  </div>

  <!-- Map -->
  <div class="footer-map">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3323.8842881135997!2d-117.70186509999999!3d33.5958922!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80dce8dacfacc399%3A0xd9b6dad4e546c5a6!2sSaddleback%20Valley%20Endodontics!5e0!3m2!1sen!2sus!4v1779246585496!5m2!1sen!2sus"
      width="600"
      height="360"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="Saddleback Valley Endodontics location"
    ></iframe>
  </div>

  <div class="footer-service-area">
    Proudly serving Laguna Hills, Laguna Beach, Mission Viejo, Laguna Niguel, Aliso Viejo, Lake Forest, Dana Point, Rancho Santa Margarita, Foothill Ranch, Irvine, San Clemente, San Juan Capistrano, and surrounding South Orange County since 1983.
  </div>

  <div class="footer-bottom">
    <div>© {year} Saddleback Valley Endodontics. All rights reserved.</div>
    <div class="footer-legal">
      <a href="/privacy-policy/">Privacy Policy</a>
      <a href="/terms-of-use/">Terms of Use</a>
      <a href="/sitemap.xml">Sitemap</a>
    </div>
  </div>
</footer>

<style is:global>
  .site-footer {
    background: var(--color-ink);
    color: rgba(255,255,255,0.55);
    padding: clamp(64px, 10vh, 100px) clamp(28px, 6vw, 88px) 0;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: clamp(40px, 5vw, 72px);
    padding-bottom: clamp(56px, 8vh, 80px);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .footer-brand {
    display: block;
    text-decoration: none;
    margin-bottom: 20px;
  }
  .footer-logo-line1,
  .footer-logo-line2 {
    display: block;
    font-family: var(--font-display);
    color: #fff;
    font-weight: 300;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }
  .footer-logo-line1 { font-size: clamp(16px, 1.6vw, 20px); }
  .footer-logo-line2 { font-size: clamp(22px, 2.2vw, 28px); }

  .footer-tag {
    font-size: 13px;
    line-height: 1.6;
    color: rgba(255,255,255,0.4);
    margin: 0 0 28px;
    max-width: 30ch;
  }

  .footer-contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-contact-list li { font-size: 13px; line-height: 1.5; }
  .footer-contact-list a {
    color: rgba(255,255,255,0.65);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-contact-list a:hover { color: #fff; }
  .footer-hours {
    color: rgba(255,255,255,0.4);
    font-size: 12px;
    margin-top: 4px;
  }

  .footer-col-heading {
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-weight: 500;
    color: rgba(255,255,255,0.35);
    margin: 0 0 20px;
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .footer-col ul li a {
    display: block;
    font-size: 13px;
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    padding: 7px 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    transition: color 0.2s;
  }
  .footer-col ul li:first-child a { border-top: 1px solid rgba(255,255,255,0.06); }
  .footer-col ul li a:hover { color: #fff; }

  .footer-service-area {
    font-size: 12px;
    line-height: 1.7;
    color: rgba(255,255,255,0.28);
    padding: 20px 0;
    border-top: 1px solid rgba(255,255,255,0.08);
    text-align: center;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 24px 0;
    font-size: 12px;
    color: rgba(255,255,255,0.3);
  }
  .footer-legal {
    display: flex;
    gap: 24px;
  }
  .footer-legal a {
    color: rgba(255,255,255,0.3);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-legal a:hover { color: rgba(255,255,255,0.7); }

  .footer-map {
    border-top: 1px solid rgba(255,255,255,0.08);
    margin: 0 calc(clamp(28px, 6vw, 88px) * -1);
  }
  .footer-map iframe {
    display: block;
    width: 100%;
    height: 320px;
    filter: grayscale(30%) contrast(1.05);
  }

  @media (max-width: 1024px) {
    .footer-top { grid-template-columns: 1fr 1fr; }
    .footer-brand-col { grid-column: 1 / -1; }
    .footer-tag { max-width: 100%; }
  }
  @media (max-width: 560px) {
    .footer-top { grid-template-columns: 1fr; }
    .footer-bottom { flex-direction: column; align-items: flex-start; gap: 12px; }
    .footer-legal { flex-wrap: wrap; gap: 16px; }
  }
</style>
