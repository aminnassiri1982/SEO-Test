---
export interface Props {
  variant?: 'transparent' | 'solid';
  active?: 'services' | 'team' | 'tech' | 'journal' | 'faq' | 'contact';
}

const { variant = 'transparent', active } = Astro.props;
const headerClass = variant === 'solid' ? 'site-header is-inner' : 'site-header';
---

<!-- Single-row header: hamburger | logo | utility — on every viewport -->
<header class={headerClass} id="siteHeader">
  <div class="header-top">

    <!-- LEFT: Hamburger (always visible — opens full-screen menu) -->
    <div class="header-utility header-utility--left">
      <button class="menu-toggle" id="menuToggle" aria-label="Open menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <!-- CENTER: Logo -->
    <a href="/" class="logo" aria-label="Saddleback Valley Endodontics — Home">
      <span class="logo-line1">Saddleback Valley</span>
      <span class="logo-line2">Endodontics</span>
    </a>

    <!-- RIGHT: Contact Us + Search -->
    <div class="header-utility header-utility--right">
      <a href="/contact/" class="header-contact-link">Contact Us</a>
      <button class="search-btn underline-on-hover" aria-label="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="20" y1="20" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
    </div>

  </div>
</header>

<!-- =====================================================
     FULL-SCREEN OVERLAY MENU (Omega-style)
     Works on every viewport — desktop & mobile
     ===================================================== -->
<div class="mobile-menu" id="mobileMenu" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Navigation">

  <!-- Overlay top bar: logo + close -->
  <div class="mobile-menu-bar">
    <a href="/" class="mobile-menu-logo" tabindex="-1">
      <span class="logo-line1">Saddleback Valley</span>
      <span class="logo-line2">Endodontics</span>
    </a>
    <button class="mobile-menu-close" id="menuClose" aria-label="Close menu">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
        <line x1="5"  y1="5"  x2="19" y2="19"></line>
        <line x1="19" y1="5"  x2="5"  y2="19"></line>
      </svg>
    </button>
  </div>

  <!-- Primary nav links — --i drives the stagger delay -->
  <nav class="mobile-menu-nav" aria-label="Site navigation">
    <a href="/services/"   style="--i:0" tabindex="-1">Services</a>
    <a href="/team/"       style="--i:1" tabindex="-1">Team</a>
    <a href="/technology/" style="--i:2" tabindex="-1">Technology</a>
    <a href="/blog/"       style="--i:3" tabindex="-1">Journal</a>
    <a href="/faq/"        style="--i:4" tabindex="-1">FAQ</a>
    <a href="/contact/"    style="--i:5" tabindex="-1">Contact</a>
  </nav>

  <!-- Bottom utility strip -->
  <div class="mobile-menu-footer">
    <a href="tel:+19496001234" tabindex="-1">(949) 600-1234</a>
    <span class="mobile-menu-sep" aria-hidden="true">·</span>
    <a href="/contact/" tabindex="-1">Book a Consultation</a>
  </div>

</div>

<script>
  const header   = document.getElementById('siteHeader');
  const toggle   = document.getElementById('menuToggle');
  const menu     = document.getElementById('mobileMenu');
  const closeBtn = document.getElementById('menuClose');

  // Transparent → solid on scroll (pages without .is-inner hero)
  if (header && !header.classList.contains('is-inner')) {
    const threshold = () => window.innerHeight - 80;
    const onScroll  = () => header.classList.toggle('is-solid', window.scrollY > threshold());
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  function openMenu() {
    if (!menu || !toggle) return;
    menu.classList.add('is-open');
    menu.setAttribute('aria-hidden', 'false');
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    menu.querySelectorAll('[tabindex="-1"]').forEach(el => el.removeAttribute('tabindex'));
    setTimeout(() => closeBtn?.focus(), 60);
  }

  function closeMenu() {
    if (!menu || !toggle) return;
    menu.classList.remove('is-open');
    menu.setAttribute('aria-hidden', 'true');
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    menu.querySelectorAll('a').forEach(el => el.setAttribute('tabindex', '-1'));
    toggle.focus();
  }

  toggle?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('is-open')) closeMenu();
  });

  menu?.querySelectorAll('.mobile-menu-nav a').forEach(link =>
    link.addEventListener('click', closeMenu)
  );
</script>
