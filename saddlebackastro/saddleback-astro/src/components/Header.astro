---
export interface Props {
  variant?: 'transparent' | 'solid';
  active?: 'diagnosis' | 'services' | 'team' | 'tech' | 'journal' | 'faq' | 'contact' | 'patients' | 'practice';
}

const { variant = 'transparent', active } = Astro.props;
const headerClass = variant === 'solid' ? 'site-header is-inner' : 'site-header';

const treatments = [
  { label: 'Root Canal Treatment',         href: '/treatments/root-canal-treatment/' },
  { label: 'Root Canal Retreatment',       href: '/treatments/root-canal-retreatment/' },
  { label: 'Apical Surgery / Apicoectomy', href: '/treatments/apical-surgery-apicoectomy/' },
  { label: 'Anxiety & Sedation',           href: '/treatments/anxiety-sedation/' },
  { label: 'Dental Implants',              href: '/treatments/dental-implant/' },
];

const patients = [
  { label: 'Your First Visit',              href: '/patients/first-visit/' },
  { label: 'Insurance & Financing',         href: '/patients/insurance-financing/' },
  { label: 'Post-Operative Instructions',   href: '/patients/post-operative-instructions/' },
  { label: 'Patient Login',                 href: 'https://securesite29.tdo4endo.com/PatientsLogin.aspx', external: true },
];

const practice = [
  { label: 'About Us',             href: '/our-practice/about-us/' },
  { label: 'Meet Our Doctors',     href: '/team/' },
  { label: 'Advanced Technology',  href: '/technology/' },
  { label: 'Why Choose Us',        href: '/our-practice/why-choose-us/' },
  { label: 'Patient Reviews',      href: '/our-practice/patient-reviews/' },
];
---

<header class={headerClass} id="siteHeader">
  <div class="header-top">

    <!-- LEFT: Contact Us (desktop) / Hamburger (mobile) -->
    <div class="header-utility header-utility--left">
      <a href="/contact/" class="label-long desktop-only">Contact Us</a>
      <button class="menu-toggle mobile-only" id="menuToggle" aria-label="Open menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <!-- CENTER: Logo -->
    <a href="/" class="logo" aria-label="Saddleback Valley Endodontics — Home">
      <span class="logo-line1">Saddleback Valley</span>
      <span class="logo-line2">Endodontics</span>
    </a>

    <!-- RIGHT: For Doctors + Search -->
    <div class="header-utility header-utility--right">
      <a href="/for-doctors/" class="label-long desktop-only">For Doctors</a>
      <button class="search-btn underline-on-hover" aria-label="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="20" y1="20" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
    </div>

  </div>

  <!-- DESKTOP NAV — centered under logo -->
  <nav class="main-nav desktop-only" aria-label="Primary">
    <a href="/#diagnosis" class={active === 'diagnosis' ? 'is-active' : ''}>Diagnosis</a>

    <!-- Services with mega-menu dropdown -->
    <div class="nav-has-dropdown" id="servicesNav">
      <a href="/services/"
         class={`nav-dropdown-trigger ${active === 'services' ? 'is-active' : ''}`}
         aria-haspopup="true"
         aria-expanded="false"
         id="servicesToggle">
        Services
        <svg class="nav-chevron" viewBox="0 0 24 24" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </a>
      <div class="nav-dropdown" id="servicesDropdown" role="region" aria-label="Treatment pages">
        <div class="nav-dropdown-inner">
          <p class="nav-dropdown-eyebrow">Treatments · Laguna Hills, CA</p>
          <ul class="nav-dropdown-list">
            {treatments.map(t => (
              <li>
                <a href={t.href} class="nav-dropdown-link">
                  <span>{t.label}</span>
                  <span class="nav-dropdown-arrow" aria-hidden="true"></span>
                </a>
              </li>
            ))}
          </ul>
          <a href="/treatments/" class="nav-dropdown-all">
            All treatments
            <span class="nav-dropdown-arrow" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </div>

    <!-- For Patients dropdown -->
    <div class="nav-has-dropdown" id="patientsNav">
      <a href="/patients/"
         class={`nav-dropdown-trigger ${active === 'patients' ? 'is-active' : ''}`}
         aria-haspopup="true"
         aria-expanded="false"
         id="patientsToggle">
        For Patients
        <svg class="nav-chevron" viewBox="0 0 24 24" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </a>
      <div class="nav-dropdown" id="patientsDropdown" role="region" aria-label="Patient pages">
        <div class="nav-dropdown-inner">
          <p class="nav-dropdown-eyebrow">Patient Resources</p>
          <ul class="nav-dropdown-list">
            {patients.map(p => (
              <li>
                <a href={p.href} class="nav-dropdown-link" target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener noreferrer' : undefined}>
                  <span>{p.label}</span>
                  <span class="nav-dropdown-arrow" aria-hidden="true"></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Our Practice dropdown -->
    <div class="nav-has-dropdown" id="practiceNav">
      <a href="/our-practice/about-us/"
         class={`nav-dropdown-trigger ${active === 'practice' ? 'is-active' : ''}`}
         aria-haspopup="true"
         aria-expanded="false"
         id="practiceToggle">
        Our Practice
        <svg class="nav-chevron" viewBox="0 0 24 24" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </a>
      <div class="nav-dropdown" id="practiceDropdown" role="region" aria-label="Our Practice pages">
        <div class="nav-dropdown-inner">
          <p class="nav-dropdown-eyebrow">Our Practice</p>
          <ul class="nav-dropdown-list">
            {practice.map(p => (
              <li>
                <a href={p.href} class="nav-dropdown-link">
                  <span>{p.label}</span>
                  <span class="nav-dropdown-arrow" aria-hidden="true"></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

  </nav>
</header>

<!-- =====================================================
     FULL-SCREEN OVERLAY — mobile (Omega-style)
     ===================================================== -->
<div class="mobile-menu" id="mobileMenu" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Navigation">

  <div class="mobile-menu-bar">
    <a href="/" class="mobile-menu-logo" tabindex="-1">
      <span class="logo-line1">Saddleback Valley</span>
      <span class="logo-line2">Endodontics</span>
    </a>
    <button class="mobile-menu-close" id="menuClose" aria-label="Close menu">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
        <line x1="5"  y1="5"  x2="19" y2="19"></line>
        <line x1="19" y1="5"  x2="5"  y2="19"></line>
      </svg>
    </button>
  </div>

  <nav class="mobile-menu-nav" aria-label="Mobile navigation">
    <a href="/#diagnosis" style="--i:0" tabindex="-1">Diagnosis</a>

    <!-- Services accordion in mobile -->
    <div class="mobile-acc" style="--i:1">
      <button class="mobile-acc-btn" aria-expanded="false" tabindex="-1">
        Services
        <svg class="mobile-acc-chevron" viewBox="0 0 24 24" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
      <div class="mobile-acc-panel">
        {treatments.map(t => (
          <a href={t.href} tabindex="-1">{t.label}</a>
        ))}
        <a href="/treatments/" tabindex="-1" class="mobile-acc-all">All treatments →</a>
      </div>
    </div>

    <!-- For Patients accordion in mobile -->
    <div class="mobile-acc" style="--i:2">
      <button class="mobile-acc-btn" aria-expanded="false" tabindex="-1">
        For Patients
        <svg class="mobile-acc-chevron" viewBox="0 0 24 24" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
      <div class="mobile-acc-panel">
        {patients.map(p => (
          <a href={p.href} tabindex="-1" target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener noreferrer' : undefined}>{p.label}</a>
        ))}
      </div>
    </div>

    <!-- Our Practice accordion in mobile -->
    <div class="mobile-acc" style="--i:3">
      <button class="mobile-acc-btn" aria-expanded="false" tabindex="-1">
        Our Practice
        <svg class="mobile-acc-chevron" viewBox="0 0 24 24" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
      <div class="mobile-acc-panel">
        {practice.map(p => (
          <a href={p.href} tabindex="-1">{p.label}</a>
        ))}
      </div>
    </div>

    <a href="/blog/"   style="--i:4" tabindex="-1">Journal</a>
    <a href="/contact/" style="--i:5" tabindex="-1">Contact</a>
  </nav>

  <div class="mobile-menu-footer">
    <a href="tel:+19495818890" tabindex="-1">(949) 581-8890</a>
    <span class="mobile-menu-sep" aria-hidden="true">·</span>
    <a href="/request-an-appointment/" tabindex="-1">Book a Visit</a>
  </div>

</div>

<script>
  const header   = document.getElementById('siteHeader');
  const toggle   = document.getElementById('menuToggle');
  const menu     = document.getElementById('mobileMenu');
  const closeBtn = document.getElementById('menuClose');

  // Transparent → solid on scroll (homepage only)
  if (header && !header.classList.contains('is-inner')) {
    const threshold = () => window.innerHeight - 80;
    const onScroll  = () => header.classList.toggle('is-solid', window.scrollY > threshold());
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // ── Mobile overlay ──────────────────────────────────────────
  function openMenu() {
    if (!menu || !toggle) return;
    menu.classList.add('is-open');
    menu.setAttribute('aria-hidden', 'false');
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    menu.querySelectorAll('[tabindex="-1"]').forEach(el => el.removeAttribute('tabindex'));
    setTimeout(() => closeBtn?.focus(), 60);
  }
  function closeMenu() {
    if (!menu || !toggle) return;
    menu.classList.remove('is-open');
    menu.setAttribute('aria-hidden', 'true');
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    menu.querySelectorAll('a, button').forEach(el => {
      if (!el.closest('.mobile-menu-bar')) el.setAttribute('tabindex', '-1');
    });
    toggle.focus();
  }
  toggle?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && menu?.classList.contains('is-open')) closeMenu();
  });
  menu?.querySelectorAll('.mobile-menu-nav > a').forEach(link =>
    link.addEventListener('click', closeMenu)
  );

  // ── Mobile Services accordion ────────────────────────────────
  const accBtns = document.querySelectorAll('.mobile-acc-btn');
  accBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const panel   = btn.nextElementSibling;
      const isOpen  = btn.getAttribute('aria-expanded') === 'true';
      // close all others
      accBtns.forEach(b => {
        b.setAttribute('aria-expanded', 'false');
        b.closest('.mobile-acc').classList.remove('is-open');
        b.nextElementSibling.style.maxHeight = '0';
      });
      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        btn.closest('.mobile-acc').classList.add('is-open');
        panel.style.maxHeight = panel.scrollHeight + 'px';
      }
    });
  });
  menu?.querySelectorAll('.mobile-acc-panel a').forEach(link =>
    link.addEventListener('click', closeMenu)
  );

  // ── Desktop Services dropdown ────────────────────────────────
  const servicesNav     = document.getElementById('servicesNav');
  const servicesToggle  = document.getElementById('servicesToggle');
  const servicesDropdown = document.getElementById('servicesDropdown');

  if (servicesNav && servicesToggle && servicesDropdown) {
    let closeTimer;

    function openDropdown() {
      clearTimeout(closeTimer);
      servicesNav.classList.add('is-open');
      servicesToggle.setAttribute('aria-expanded', 'true');
    }
    function scheduleClose() {
      closeTimer = setTimeout(() => {
        servicesNav.classList.remove('is-open');
        servicesToggle.setAttribute('aria-expanded', 'false');
      }, 120);
    }

    servicesNav.addEventListener('mouseenter', openDropdown);
    servicesNav.addEventListener('mouseleave', scheduleClose);
    servicesDropdown.addEventListener('mouseenter', openDropdown);
    servicesDropdown.addEventListener('mouseleave', scheduleClose);

    // Keyboard: Enter/Space on trigger opens; Escape closes
    servicesToggle.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        servicesNav.classList.contains('is-open') ? scheduleClose() : openDropdown();
      }
      if (e.key === 'Escape') scheduleClose();
    });
    document.addEventListener('click', e => {
      if (!servicesNav.contains(e.target)) scheduleClose();
    });
  }

  // ── Desktop Our Practice dropdown ────────────────────────────
  const practiceNav      = document.getElementById('practiceNav');
  const practiceToggle   = document.getElementById('practiceToggle');
  const practiceDropdown = document.getElementById('practiceDropdown');

  if (practiceNav && practiceToggle && practiceDropdown) {
    let prCloseTimer;

    function openPracticeDropdown() {
      clearTimeout(prCloseTimer);
      practiceNav.classList.add('is-open');
      practiceToggle.setAttribute('aria-expanded', 'true');
    }
    function schedulePracticeClose() {
      prCloseTimer = setTimeout(() => {
        practiceNav.classList.remove('is-open');
        practiceToggle.setAttribute('aria-expanded', 'false');
      }, 120);
    }

    practiceNav.addEventListener('mouseenter', openPracticeDropdown);
    practiceNav.addEventListener('mouseleave', schedulePracticeClose);
    practiceDropdown.addEventListener('mouseenter', openPracticeDropdown);
    practiceDropdown.addEventListener('mouseleave', schedulePracticeClose);

    practiceToggle.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        practiceNav.classList.contains('is-open') ? schedulePracticeClose() : openPracticeDropdown();
      }
      if (e.key === 'Escape') schedulePracticeClose();
    });
    document.addEventListener('click', e => {
      if (!practiceNav.contains(e.target)) schedulePracticeClose();
    });
  }

  // ── Desktop For Patients dropdown ────────────────────────────
  const patientsNav      = document.getElementById('patientsNav');
  const patientsToggle   = document.getElementById('patientsToggle');
  const patientsDropdown = document.getElementById('patientsDropdown');

  if (patientsNav && patientsToggle && patientsDropdown) {
    let pCloseTimer;

    function openPatientsDropdown() {
      clearTimeout(pCloseTimer);
      patientsNav.classList.add('is-open');
      patientsToggle.setAttribute('aria-expanded', 'true');
    }
    function schedulePatientsClose() {
      pCloseTimer = setTimeout(() => {
        patientsNav.classList.remove('is-open');
        patientsToggle.setAttribute('aria-expanded', 'false');
      }, 120);
    }

    patientsNav.addEventListener('mouseenter', openPatientsDropdown);
    patientsNav.addEventListener('mouseleave', schedulePatientsClose);
    patientsDropdown.addEventListener('mouseenter', openPatientsDropdown);
    patientsDropdown.addEventListener('mouseleave', schedulePatientsClose);

    patientsToggle.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        patientsNav.classList.contains('is-open') ? schedulePatientsClose() : openPatientsDropdown();
      }
      if (e.key === 'Escape') schedulePatientsClose();
    });
    document.addEventListener('click', e => {
      if (!patientsNav.contains(e.target)) schedulePatientsClose();
    });
  }
</script>
