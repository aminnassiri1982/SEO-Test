</style>

<!-- Homepage JS — slideshow + FAQ accordion -->
<script>
  // SLIDESHOW
  (function () {
    const slides   = Array.from(document.querySelectorAll('.slide'));
    const prev     = document.getElementById('prevSlide');
    const next     = document.getElementById('nextSlide');
    const curEl    = document.getElementById('curSlide');
    const totEl    = document.getElementById('totSlide');
    const progress = document.getElementById('progressBar');
    const showcase = document.getElementById('showcase');
    if (!slides.length || !next || !prev || !curEl || !totEl || !progress || !showcase) return;

    const total = slides.length;
    let index = 0;
    let timer = null;
    let progressTimer = null;
    let progressStart = 0;
    let paused = false;
    const DURATION = 6500;

    totEl.textContent = String(total).padStart(2, '0');
    const pad = (n) => String(n + 1).padStart(2, '0');

    function go(toIndex, direction) {
      const from = index;
      const to = (toIndex + total) % total;
      if (from === to) return;
      const outgoing = slides[from];
      const incoming = slides[to];
      incoming.style.transition = 'none';
      incoming.style.transform  = `translateX(${direction === 'prev' ? '-100%' : '100%'})`;
      incoming.style.opacity    = '1';
      void incoming.offsetWidth;
      incoming.style.transition = '';
      outgoing.classList.remove('is-active');
      outgoing.classList.add('is-leaving');
      if (direction === 'prev') outgoing.style.transform = 'translateX(100%)';
      else                       outgoing.style.transform = '';
      incoming.classList.remove('is-leaving');
      incoming.classList.add('is-active');
      incoming.style.transform = '';
      setTimeout(() => {
        outgoing.classList.remove('is-leaving');
        outgoing.style.transform = '';
        outgoing.style.opacity = '';
      }, 1000);
      index = to;
      curEl.textContent = pad(index);
      restartProgress();
    }

    const nextSlide = () => go(index + 1, 'next');
    const prevSlide = () => go(index - 1, 'prev');

    function startTimer() { stopTimer(); timer = setTimeout(nextSlide, DURATION); }
    function stopTimer()  { if (timer) clearTimeout(timer); timer = null; }
    function restartProgress() {
      progressStart = performance.now();
      cancelAnimationFrame(progressTimer);
      stopTimer();
      if (!paused) startTimer();
      tickProgress();
    }
    function tickProgress() {
      const elapsed = performance.now() - progressStart;
      const pct = Math.min(100, (elapsed / DURATION) * 100);
      progress.style.width = pct + '%';
      if (pct < 100 && !paused) progressTimer = requestAnimationFrame(tickProgress);
    }

    next.addEventListener('click', nextSlide);
    prev.addEventListener('click', prevSlide);
    showcase.addEventListener('mouseenter', () => { paused = true; stopTimer(); cancelAnimationFrame(progressTimer); });
    showcase.addEventListener('mouseleave', () => { paused = false; restartProgress(); });
    window.addEventListener('keydown', (e) => {
      const rect = showcase.getBoundingClientRect();
      const inView = rect.top < window.innerHeight * 0.6 && rect.bottom > window.innerHeight * 0.4;
      if (!inView) return;
      if (e.key === 'ArrowRight') nextSlide();
      if (e.key === 'ArrowLeft')  prevSlide();
    });

    curEl.textContent = pad(0);
    restartProgress();
  })();

  // FAQ ACCORDION
  (function () {
    const items = document.querySelectorAll('.faq-item');
    const allowMultiple = true;
    items.forEach(item => {
      const btn = item.querySelector('.faq-q');
      const ans = item.querySelector('.faq-a');
      if (!btn || !ans) return;
      btn.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');
        if (!allowMultiple) {
          items.forEach(other => {
            if (other !== item) {
              other.classList.remove('is-open');
              other.querySelector('.faq-q').setAttribute('aria-expanded', 'false');
              other.querySelector('.faq-a').style.maxHeight = '0px';
            }
          });
        }
        if (isOpen) {
          item.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
          ans.style.maxHeight = '0px';
        } else {
          item.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
          ans.style.maxHeight = ans.scrollHeight + 'px';
        }
      });
    });
    window.addEventListener('resize', () => {
      document.querySelectorAll('.faq-item.is-open .faq-a').forEach(ans => {
        ans.style.maxHeight = ans.scrollHeight + 'px';
      });
    });
  })();
</script>
