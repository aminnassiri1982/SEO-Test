---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Replace these URLs when you have local assets in /public/images/
const HERO_VIDEO  = 'https://storage.googleapis.com/local-dentist-nearby/Videos/smile-dentistry.mp4';
const HERO_POSTER = 'https://cdn.shortpixel.ai/spai/q_lossless+w_838+to_webp+ret_img/sbvendo.dentistnerds.com/wp-content/uploads/2026/05/Saddleback-Valley-Endodontics-Team.webp';
const SLIDE_IMG   = 'https://cdn.shortpixel.ai/spai/q_lossless+w_838+to_webp+ret_img/sbvendo.dentistnerds.com/wp-content/uploads/2026/05/Saddleback-Valley-Endodontics-Team.webp';
---

<BaseLayout title="Saddleback Valley Endodontics">

  <Header variant="transparent" />

  <!-- HERO -->
  <section class="hero" id="top">
    <div class="hero-fallback" aria-hidden="true"></div>
    <video
      class="hero-media"
      autoplay muted loop playsinline
      poster={HERO_POSTER}>
      <source src={HERO_VIDEO} type="video/mp4">
    </video>

    <div class="hero-content">
      <p class="hero-eyebrow">Expertise · Technology · Compassion</p>
      <a href="#showcase" class="discover-btn">Discover</a>
    </div>

    <div class="scroll-cue">Scroll</div>
  </section>

  <!-- SLIDESHOW -->
  <section class="showcase" id="showcase" aria-roledescription="carousel">

    <article class="slide is-active" data-slide="0">
      <div class="slide-img" style={`background-image: url('${SLIDE_IMG}');`}></div>
      <div class="slide-content">
        <p class="slide-eyebrow">01 — The Team</p>
        <h2 class="slide-title">Decades of trust.</h2>
        <a href="#team" class="slide-btn">Meet the Team <span class="arrow"></span></a>
      </div>
    </article>

    <article class="slide" data-slide="1">
      <div class="slide-img" style={`background-image: url('${SLIDE_IMG}');`}></div>
      <div class="slide-content">
        <p class="slide-eyebrow">02 — Credentials</p>
        <h2 class="slide-title">Board-Certified<br/>expertise matters.</h2>
        <a href="#credentials" class="slide-btn">Learn Why <span class="arrow"></span></a>
      </div>
    </article>

    <article class="slide" data-slide="2">
      <div class="slide-img" style={`background-image: url('${SLIDE_IMG}');`}></div>
      <div class="slide-content">
        <p class="slide-eyebrow">03 — Technology</p>
        <h2 class="slide-title">Better results<br/>through technology.</h2>
        <a href="#tech" class="slide-btn">See Tech <span class="arrow"></span></a>
      </div>
    </article>

    <article class="slide" data-slide="3">
      <div class="slide-img" style={`background-image: url('${SLIDE_IMG}');`}></div>
      <div class="slide-content">
        <p class="slide-eyebrow">04 — Experience</p>
        <h2 class="slide-title">Comfortable<br/>and safe.</h2>
        <a href="#experience" class="slide-btn">Step Inside <span class="arrow"></span></a>
      </div>
    </article>

    <article class="slide" data-slide="4">
      <div class="slide-img" style={`background-image: url('${SLIDE_IMG}');`}></div>
      <div class="slide-content">
        <p class="slide-eyebrow">05 — Cases</p>
        <h2 class="slide-title">Cases as unique<br/>as you.</h2>
        <a href="#cases" class="slide-btn">Explore <span class="arrow"></span></a>
      </div>
    </article>

    <article class="slide" data-slide="5">
      <div class="slide-img" style={`background-image: url('${SLIDE_IMG}');`}></div>
      <div class="slide-content">
        <p class="slide-eyebrow">06 — Questions</p>
        <h2 class="slide-title">Answers, first.</h2>
        <a href="/blog/" class="slide-btn">Read the Journal <span class="arrow"></span></a>
      </div>
    </article>

    <div class="showcase-controls">
      <button class="showcase-arrow" id="prevSlide" aria-label="Previous slide">
        <svg viewBox="0 0 24 24"><polyline points="15 6 9 12 15 18"></polyline></svg>
      </button>
      <div class="showcase-count"><span id="curSlide">01</span> / <span id="totSlide">06</span></div>
      <button class="showcase-arrow" id="nextSlide" aria-label="Next slide">
        <svg viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"></polyline></svg>
      </button>
    </div>
    <div class="showcase-progress"><span id="progressBar"></span></div>
  </section>

  <!-- DIAGNOSIS -->
  <section class="section" id="diagnosis">
    <header class="section-header">
      <div>
        <p class="section-eyebrow">01 — Diagnosis</p>
        <h2 class="section-title">The diagnosis defines everything that follows.</h2>
      </div>
      <p class="section-lede">
        A thorough, unhurried evaluation is the single most important step in any
        treatment journey. Our process is built to surface the right answers before
        any plan is proposed.
      </p>
    </header>

    <ol class="process">
      <li class="process-step is-current">
        <p class="process-num">Step 01</p>
        <h3 class="process-title">Consultation</h3>
        <p class="process-desc">A focused conversation about history, symptoms, and goals — without the clock.</p>
      </li>
      <li class="process-step">
        <p class="process-num">Step 02</p>
        <h3 class="process-title">Imaging &amp; Workup</h3>
        <p class="process-desc">In-house diagnostics tailored to the case, often completed in a single visit.</p>
      </li>
      <li class="process-step">
        <p class="process-num">Step 03</p>
        <h3 class="process-title">Review</h3>
        <p class="process-desc">Findings reviewed by board-certified specialists and presented in plain language.</p>
      </li>
      <li class="process-step">
        <p class="process-num">Step 04</p>
        <h3 class="process-title">Plan</h3>
        <p class="process-desc">A personalized plan with clear options, expectations, and next steps.</p>
      </li>
    </ol>
  </section>

  <!-- SERVICES -->
  <section class="section section--warm" id="services">
    <header class="section-header">
      <div>
        <p class="section-eyebrow">02 — Services</p>
        <h2 class="section-title">Every treatment, one specialist team.</h2>
      </div>
      <p class="section-lede">
        From first consult through long-term follow-up, every service is delivered
        by the same team that knows your case.
      </p>
    </header>

    <ul class="services-list">
      <li><a href="/treatments/root-canal-treatment/"><span class="services-num">01</span><span class="services-name">Root Canal Treatment</span><span class="services-arrow"></span></a></li>
      <li><a href="/treatments/root-canal-retreatment/"><span class="services-num">02</span><span class="services-name">Root Canal Retreatment</span><span class="services-arrow"></span></a></li>
      <li><a href="/treatments/apical-surgery-apicoectomy/"><span class="services-num">03</span><span class="services-name">Apical Surgery / Apicoectomy</span><span class="services-arrow"></span></a></li>
      <li><a href="/treatments/anxiety-sedation/"><span class="services-num">04</span><span class="services-name">Anxiety &amp; Sedation</span><span class="services-arrow"></span></a></li>
      <li><a href="/treatments/dental-implant/"><span class="services-num">05</span><span class="services-name">Dental Implants</span><span class="services-arrow"></span></a></li>
    </ul>
  </section>

  <!-- TEAM -->
  <section class="section section--dark" id="team">
    <header class="section-header">
      <div>
        <p class="section-eyebrow">03 — The Team</p>
        <h2 class="section-title">Led by board-certified specialists.</h2>
      </div>
      <p class="section-lede">
        Every member of the practice has trained, and continues to train, at the
        highest level in their field.
      </p>
    </header>

    <div class="team-grid">
      <article class="team-card" onclick="location.href='/team/lars-jonsson/'">
        <div class="team-portrait">
          <img src="/images/LARS-BJoRN-JoNSSON-DDS-MS.webp" alt="Dr. Lars Björn Jönsson">
        </div>
        <h3 class="team-name">Dr. Lars B. Jönsson</h3>
        <p class="team-cred">DDS, MS · Diplomate ABE</p>
        <p class="team-specialty">Founding partner. Endodontics &amp; implant fellowship.</p>
      </article>
      <article class="team-card" onclick="location.href='/team/charles-tatosian/'">
        <div class="team-portrait">
          <img src="/images/Charles-Tatosian-DDS-MS.webp" alt="Dr. Charles Tatosian">
        </div>
        <h3 class="team-name">Dr. Charles Tatosian</h3>
        <p class="team-cred">DDS, MS · Diplomate ABE</p>
        <p class="team-specialty">In practice Mission Viejo since 1992.</p>
      </article>
      <article class="team-card" onclick="location.href='/team/wayland-chu/'">
        <div class="team-portrait">
          <img src="/images/WAYLAND-CHU-DDS-MSD.webp" alt="Dr. Wayland Chu">
        </div>
        <h3 class="team-name">Dr. Wayland Chu</h3>
        <p class="team-cred">DDS, MSD · Diplomate ABE</p>
        <p class="team-specialty">U of Washington residency. Southern CA raised.</p>
      </article>
    </div>
  </section>

  <!-- TECH -->
  <section class="section" id="tech">
    <header class="section-header">
      <div>
        <p class="section-eyebrow">04 — Technology</p>
        <h2 class="section-title">Precision, measured.</h2>
      </div>
      <p class="section-lede">
        Investment in the right equipment is not about novelty — it is about
        better answers, smaller incisions, and faster recoveries.
      </p>
    </header>

    <div class="tech-stats">
      <div class="tech-stat">
        <p class="tech-stat-num">0.3<sup>mm</sup></p>
        <p class="tech-stat-label">Imaging Resolution</p>
        <p class="tech-stat-desc">Sub-millimeter detail across every diagnostic scan.</p>
      </div>
      <div class="tech-stat">
        <p class="tech-stat-num">98<sup>%</sup></p>
        <p class="tech-stat-label">Same-Day Results</p>
        <p class="tech-stat-desc">Most workups completed before you leave the office.</p>
      </div>
      <div class="tech-stat">
        <p class="tech-stat-num">24<sup>/7</sup></p>
        <p class="tech-stat-label">Patient Portal</p>
        <p class="tech-stat-desc">Secure access to your records, imaging, and care team.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--warm" id="faq">
    <header class="section-header">
      <div>
        <p class="section-eyebrow">05 — Questions</p>
        <h2 class="section-title">Answers, plainly.</h2>
      </div>
      <p class="section-lede">
        A few of the questions we hear most often. If yours isn't here, we'd
        rather you ask us directly.
      </p>
    </header>

    <div class="faq-list">
      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">
          <span>Do I need a referral to schedule a consultation?</span>
          <span class="faq-toggle" aria-hidden="true"></span>
        </button>
        <div class="faq-a"><div class="faq-a-inner">
          No referral is required. Many patients come to us directly, and we
          coordinate with your general dentist as needed.
        </div></div>
      </div>
      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">
          <span>What insurance plans do you accept?</span>
          <span class="faq-toggle" aria-hidden="true"></span>
        </button>
        <div class="faq-a"><div class="faq-a-inner">
          We accept most major dental insurance plans. For specifics, please
          contact our office and we'll verify your benefits before your visit.
        </div></div>
      </div>
      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">
          <span>How quickly can I be seen?</span>
          <span class="faq-toggle" aria-hidden="true"></span>
        </button>
        <div class="faq-a"><div class="faq-a-inner">
          New patient consultations are typically available within one to two
          weeks. Urgent cases are prioritized and often seen the same week.
        </div></div>
      </div>
      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">
          <span>Are second opinions welcome?</span>
          <span class="faq-toggle" aria-hidden="true"></span>
        </button>
        <div class="faq-a"><div class="faq-a-inner">
          Always. Bring your imaging and records — we'll handle the rest.
        </div></div>
      </div>
      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">
          <span>What should I bring to my first visit?</span>
          <span class="faq-toggle" aria-hidden="true"></span>
        </button>
        <div class="faq-a"><div class="faq-a-inner">
          A photo ID, your insurance card, a list of current medications, and
          any imaging or records from previous providers if available.
        </div></div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section section--dark" id="contact">
    <div class="contact-grid">
      <div>
        <h2 class="contact-title">Begin with a conversation.</h2>
        <a href="#schedule" class="contact-cta">Request a Consultation <span class="arrow"></span></a>
      </div>
      <dl class="contact-meta">
        <div><dt>Office</dt><dd>123 Practice Way<br/>Suite 400<br/>City, ST 00000</dd></div>
        <div><dt>Hours</dt><dd>Mon — Fri · 8:00–5:00<br/>Sat · By appointment</dd></div>
        <div><dt>Phone</dt><dd>(000) 000 — 0000</dd></div>
        <div><dt>Email</dt><dd>hello@sbvendo.com</dd></div>
      </dl>
    </div>
  </section>

  <Footer />

</BaseLayout>

<!-- Page-scoped CSS — only loaded on the homepage -->
<style is:global>
  /* HERO */
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 720px;
    overflow: hidden;
    background: #0d0d0d;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }
  .hero-fallback {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.55) 100%),
      url('https://cdn.shortpixel.ai/spai/q_lossless+w_838+to_webp+ret_img/sbvendo.dentistnerds.com/wp-content/uploads/2026/05/Saddleback-Valley-Endodontics-Team.webp');
    background-size: cover;
    background-position: center;
    z-index: 0;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg,
      rgba(0,0,0,0.15) 0%,
      rgba(0,0,0,0) 30%,
      rgba(0,0,0,0) 65%,
      rgba(0,0,0,0.45) 100%);
    z-index: 1;
    pointer-events: none;
  }
  .hero-content {
    position: absolute;
    inset: auto 0 14% 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    color: #fff;
    text-align: center;
    padding: 0 24px;
  }
  .hero-eyebrow {
    font-size: 11px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    font-weight: 500;
    opacity: 0.85;
  }
  .discover-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 220px;
    height: 54px;
    padding: 0 36px;
    color: #fff;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.85);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    transition:
      background-color 0.35s var(--ease-out),
      color 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out);
  }
  .discover-btn:hover {
    background: #fff;
    color: var(--color-ink);
    border-color: #fff;
  }
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 28px;
    transform: translateX(-50%);
    z-index: 2;
    color: #fff;
    opacity: 0.7;
    font-size: 10px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    animation: bob 2.4s ease-in-out infinite;
  }
  .scroll-cue::after {
    content: '';
    display: block;
    width: 1px;
    height: 26px;
    background: currentColor;
    margin: 10px auto 0;
  }
  @keyframes bob {
    0%, 100% { transform: translate(-50%, 0); opacity: 0.7; }
    50%      { transform: translate(-50%, 6px); opacity: 1; }
  }

  /* SLIDESHOW */
  .showcase {
    position: relative;
    width: 100%;
    height: 70vh;
    min-height: 480px;
    overflow: hidden;
    background: #f5f3ee;
  }
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateX(100%);
    transition:
      transform 0.95s var(--ease-in-out),
      opacity 0.95s var(--ease-in-out);
    will-change: transform, opacity;
  }
  .slide.is-active  { opacity: 1; transform: translateX(0);     z-index: 2; }
  .slide.is-leaving { opacity: 1; transform: translateX(-100%); z-index: 1; }
  .slide-img {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    background-size: cover;
    background-position: center;
    transform: scale(1.04);
    transition: transform 7s linear;
  }
  .slide.is-active .slide-img { transform: scale(1); }
  .slide::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.55) 100%),
      linear-gradient(110deg, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0) 60%);
    pointer-events: none;
  }
  .slide-content {
    position: absolute;
    left: clamp(28px, 6vw, 88px);
    bottom: clamp(48px, 8vh, 96px);
    z-index: 2;
    color: #fff;
    max-width: 640px;
  }
  .slide-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: rgba(255,255,255,0.7);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.6s var(--ease-out) 0.2s, transform 0.6s var(--ease-out) 0.2s;
  }
  .slide-title {
    margin: 12px 0 24px;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(34px, 5vw, 64px);
    line-height: 1.04;
    letter-spacing: -0.005em;
    color: #fff;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.7s var(--ease-out) 0.3s, transform 0.7s var(--ease-out) 0.3s;
  }
  .slide-btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(255,255,255,0.85);
    color: #fff;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.6s var(--ease-out) 0.45s,
      transform 0.6s var(--ease-out) 0.45s,
      border-color 0.3s var(--ease-out);
  }
  .slide-btn .arrow {
    display: inline-block;
    width: 22px; height: 1px;
    background: currentColor;
    position: relative;
    transition: width 0.3s var(--ease-out);
  }
  .slide-btn .arrow::after {
    content: '';
    position: absolute;
    right: 0; top: 50%;
    width: 7px; height: 7px;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
    transform: translateY(-50%) rotate(45deg);
  }
  .slide-btn:hover .arrow { width: 34px; }
  .slide.is-active .slide-eyebrow,
  .slide.is-active .slide-title,
  .slide.is-active .slide-btn { opacity: 1; transform: translateY(0); }

  .showcase-controls {
    position: absolute;
    right: clamp(28px, 6vw, 88px);
    bottom: clamp(48px, 8vh, 96px);
    z-index: 3;
    display: flex; align-items: center; gap: 22px;
    color: #fff;
  }
  .showcase-arrow {
    width: 44px; height: 44px;
    border: 1px solid rgba(255,255,255,0.5);
    border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    transition: background 0.3s var(--ease-out), border-color 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }
  .showcase-arrow:hover {
    background: #fff;
    color: var(--color-ink);
    border-color: #fff;
  }
  .showcase-arrow svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.6; }
  .showcase-count {
    font-size: 12px;
    letter-spacing: 0.22em;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    min-width: 60px;
    text-align: center;
  }
  .showcase-progress {
    position: absolute;
    left: 0; bottom: 0;
    height: 2px;
    width: 100%;
    background: rgba(255,255,255,0.18);
    z-index: 3;
    overflow: hidden;
  }
  .showcase-progress span {
    display: block; height: 100%;
    width: 0;
    background: #fff;
    transition: width 0.2s linear;
  }

  /* SECTIONS — shared */
  .section {
    position: relative;
    padding: clamp(96px, 16vh, 180px) clamp(28px, 6vw, 88px);
  }
  .section--dark { background: #0d0d0d; color: #f5f3ee; }
  .section--warm { background: var(--color-paper-warm); }
  .section-eyebrow {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    margin: 0 0 28px;
  }
  .section--dark .section-eyebrow { color: rgba(245, 243, 238, 0.55); }
  .section-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(40px, 5.6vw, 78px);
    line-height: 1.03;
    letter-spacing: -0.005em;
    margin: 0;
    max-width: 18ch;
  }
  .section-lede {
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-ink-soft);
    max-width: 56ch;
    margin: 0;
  }
  .section--dark .section-lede { color: rgba(245, 243, 238, 0.72); }
  .section-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: end;
    margin-bottom: clamp(64px, 9vh, 120px);
  }
  @media (max-width: 860px) {
    .section-header { grid-template-columns: 1fr; gap: 24px; align-items: start; }
  }

  /* DIAGNOSIS */
  .process { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(24px, 3vw, 56px); position: relative; }
  .process::before { content: ''; position: absolute; left: 5px; right: 5px; top: 20px; height: 1px; background: var(--color-line); }
  .process-step { position: relative; padding-top: 56px; }
