---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
---

<BaseLayout
  title="About Us — Saddleback Valley Endodontics"
  description="Learn about Saddleback Valley Endodontics — our history, mission, and commitment to specialist endodontic care in Mission Viejo and Laguna Hills, CA."
>
  <Header variant="solid" active="practice" />

  <main>

    <section class="ab-intro">
      <p class="ab-eyebrow">About Us</p>
      <h1 class="ab-title">Specialist care,<br/>built on trust.</h1>
      <p class="ab-lede">
        Saddleback Valley Endodontics has served South Orange County for over two decades,
        delivering fellowship-trained endodontic care with the precision, technology, and
        compassion every patient deserves.
      </p>
    </section>

    <section class="ab-story">
      <div class="ab-story-grid">
        <div class="ab-story-text" data-reveal>
          <p class="ab-section-eyebrow">Our Story</p>
          <h2 class="ab-section-headline">A practice built around<br/>your natural tooth.</h2>
          <p class="ab-body">
            Founded with a simple philosophy — save every tooth that can reasonably be saved —
            Saddleback Valley Endodontics has grown into one of South Orange County's most
            trusted specialist practices. We treat patients from Laguna Hills, Mission Viejo,
            Aliso Viejo, Lake Forest, Rancho Santa Margarita, and beyond.
          </p>
          <p class="ab-body">
            Our team combines decades of combined clinical experience with ongoing investment
            in the latest endodontic technology: surgical operating microscopes, cone-beam
            CT imaging, ultrasonic instrumentation, and digital radiography. The result is
            care that is more accurate, more comfortable, and more predictable.
          </p>
        </div>
        <div class="ab-story-image" data-reveal="right">
          <img
            src="/images/Saddleback-Valley-Endodontics.webp"
            alt="Saddleback Valley Endodontics team"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section class="ab-values">
      <div class="ab-values-header" data-reveal>
        <p class="ab-section-eyebrow">What We Stand For</p>
        <h2 class="ab-section-headline">Our core commitments.</h2>
      </div>
      <div class="ab-values-grid">
        <div class="ab-value-card" data-reveal data-reveal-delay="1">
          <p class="ab-value-num">01</p>
          <h3 class="ab-value-title">Precision First</h3>
          <p class="ab-value-body">
            Every procedure is performed under surgical-grade magnification, ensuring the
            highest level of accuracy and the best possible outcome for each tooth.
          </p>
        </div>
        <div class="ab-value-card" data-reveal data-reveal-delay="2">
          <p class="ab-value-num">02</p>
          <h3 class="ab-value-title">Patient Comfort</h3>
          <p class="ab-value-body">
            We offer advanced local anesthesia, nitrous oxide, and oral sedation — because
            no one should dread the dentist. Our team takes the time to make you feel at ease.
          </p>
        </div>
        <div class="ab-value-card" data-reveal data-reveal-delay="3">
          <p class="ab-value-num">03</p>
          <h3 class="ab-value-title">Transparent Communication</h3>
          <p class="ab-value-body">
            We explain your diagnosis, your options, and our recommendations in plain language
            — so you can make confident, informed decisions about your care.
          </p>
        </div>
        <div class="ab-value-card" data-reveal data-reveal-delay="4">
          <p class="ab-value-num">04</p>
          <h3 class="ab-value-title">Referring Doctor Partnership</h3>
          <p class="ab-value-body">
            We work closely with general dentists and specialists throughout South OC,
            providing detailed consultation reports and prompt same-day scheduling for
            urgent referrals.
          </p>
        </div>
      </div>
    </section>

    <section class="ab-stats">
      <div class="ab-stats-inner">
        <div class="ab-stat" data-reveal data-reveal-delay="1">
          <p class="ab-stat-number">20+</p>
          <p class="ab-stat-label">Years Serving South OC</p>
        </div>
        <div class="ab-stat" data-reveal data-reveal-delay="2">
          <p class="ab-stat-number">10,000+</p>
          <p class="ab-stat-label">Root Canals Performed</p>
        </div>
        <div class="ab-stat" data-reveal data-reveal-delay="3">
          <p class="ab-stat-number">98%</p>
          <p class="ab-stat-label">Patient Satisfaction Rate</p>
        </div>
        <div class="ab-stat" data-reveal data-reveal-delay="4">
          <p class="ab-stat-number">Same-Day</p>
          <p class="ab-stat-label">Urgent Appointments</p>
        </div>
      </div>
    </section>

    <section class="ab-cta">
      <div class="ab-cta-inner" data-reveal>
        <p class="ab-cta-eyebrow">Ready to schedule?</p>
        <h2 class="ab-cta-headline">We're here when you need us.</h2>
        <p class="ab-cta-body">
          Call <a href="tel:+19495818890">(949) 581-8890</a> or request an appointment online.
          Same-day urgent care available.
        </p>
        <a href="/request-an-appointment/" class="ab-cta-btn">Request an Appointment</a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  main { padding-top: var(--header-h); }

  .ab-intro {
    padding: clamp(80px, 13vh, 140px) clamp(28px, 6vw, 88px) clamp(60px, 9vh, 100px);
    max-width: 960px;
    margin: 0 auto;
    border-bottom: 1px solid var(--color-line);
  }
  .ab-eyebrow {
    font-size: 11px; letter-spacing: 0.36em; text-transform: uppercase;
    font-weight: 500; color: var(--color-ink-soft); margin: 0 0 32px;
  }
  .ab-title {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(48px, 7.5vw, 96px); line-height: 1;
    letter-spacing: -0.015em; margin: 0 0 28px;
  }
  .ab-lede {
    font-size: clamp(16px, 1.5vw, 19px); line-height: 1.65;
    color: var(--color-ink-soft); max-width: 58ch; margin: 0;
  }

  .ab-story { padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px); }
  .ab-story-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: clamp(48px, 7vw, 96px); align-items: start;
    max-width: 1200px; margin: 0 auto;
  }
  .ab-section-eyebrow {
    font-size: 11px; letter-spacing: 0.36em; text-transform: uppercase;
    font-weight: 500; color: var(--color-ink-soft); margin: 0 0 20px;
  }
  .ab-section-headline {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(28px, 4vw, 48px); line-height: 1.1;
    letter-spacing: -0.008em; margin: 0 0 32px;
  }
  .ab-body {
    font-size: clamp(15px, 1.3vw, 17px); line-height: 1.75;
    color: var(--color-ink-soft); margin: 0 0 20px;
  }
  .ab-story-image img {
    width: 100%; min-height: 560px; object-fit: cover; display: block;
  }

  .ab-values {
    background: var(--color-paper-warm);
    border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line);
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
  }
  .ab-values-header { margin-bottom: clamp(48px, 7vh, 72px); text-align: center; }
  .ab-values-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 1px; background: var(--color-line); border: 1px solid var(--color-line);
    max-width: 1200px; margin: 0 auto;
  }
  .ab-value-card {
    background: var(--color-paper-warm);
    padding: clamp(32px, 4vw, 48px) clamp(24px, 3vw, 36px);
  }
  .ab-value-num {
    font-size: 11px; letter-spacing: 0.3em; color: var(--color-ink-soft);
    font-weight: 500; margin: 0 0 20px;
  }
  .ab-value-title {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(18px, 1.8vw, 22px); line-height: 1.2;
    letter-spacing: -0.005em; margin: 0 0 16px; color: var(--color-ink);
  }
  .ab-value-body {
    font-size: clamp(13px, 1.1vw, 15px); line-height: 1.65;
    color: var(--color-ink-soft); margin: 0;
  }

  .ab-stats {
    padding: clamp(60px, 10vh, 100px) clamp(28px, 6vw, 88px);
    border-bottom: 1px solid var(--color-line);
  }
  .ab-stats-inner {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: clamp(32px, 5vw, 56px); max-width: 960px; margin: 0 auto;
  }
  .ab-stat { text-align: center; }
  .ab-stat-number {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(32px, 5vw, 56px); line-height: 1; letter-spacing: -0.02em;
    color: var(--color-ink); margin: 0 0 10px;
  }
  .ab-stat-label {
    font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase;
    font-weight: 500; color: var(--color-ink-soft); margin: 0;
  }

  .ab-cta { padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px); }
  .ab-cta-inner { max-width: 680px; margin: 0 auto; text-align: center; }
  .ab-cta-eyebrow {
    font-size: 11px; letter-spacing: 0.36em; text-transform: uppercase;
    font-weight: 500; color: var(--color-ink-soft); margin: 0 0 28px;
  }
  .ab-cta-headline {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(28px, 4vw, 52px); line-height: 1.1;
    letter-spacing: -0.01em; margin: 0 0 20px;
  }
  .ab-cta-body {
    font-size: clamp(15px, 1.3vw, 17px); line-height: 1.68;
    color: var(--color-ink-soft); margin: 0 0 36px;
  }
  .ab-cta-body a { border-bottom: 1px solid currentColor; transition: opacity 0.2s; }
  .ab-cta-body a:hover { opacity: 0.6; }
  .ab-cta-btn {
    display: inline-block; font-size: 12px; letter-spacing: 0.28em;
    text-transform: uppercase; font-weight: 500; padding: 16px 36px;
    border: 1px solid var(--color-ink); color: var(--color-ink);
    transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out);
  }
  .ab-cta-btn:hover { background: var(--color-ink); color: var(--color-paper); }

  @media (max-width: 960px) {
    .ab-story-grid { grid-template-columns: 1fr; }
    .ab-values-grid { grid-template-columns: repeat(2, 1fr); }
    .ab-stats-inner { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 580px) {
    .ab-values-grid { grid-template-columns: 1fr; }
    .ab-stats-inner { grid-template-columns: repeat(2, 1fr); }
  }
</style>
