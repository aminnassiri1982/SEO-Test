---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const technologies = [
  {
    num: '01',
    title: 'Surgical Operating Microscope',
    body: 'Every procedure is performed under 20–30× magnification, allowing us to see anatomy invisible to the naked eye. This means more thorough cleaning, earlier detection of cracks and missed canals, and a higher success rate — all with less removal of healthy tissue.',
  },
  {
    num: '02',
    title: 'Cone-Beam CT Imaging (CBCT)',
    body: 'Our in-office CBCT scanner produces a three-dimensional map of your tooth, root anatomy, and surrounding bone in seconds. We use this to diagnose complex cases, plan surgical procedures, and identify issues that flat X-rays cannot show.',
  },
  {
    num: '03',
    title: 'Digital Radiography',
    body: 'Digital X-rays deliver 70% less radiation than traditional film X-rays and produce instant, high-resolution images that we can review with you chairside. Images are stored electronically and shared with your general dentist immediately.',
  },
  {
    num: '04',
    title: 'Ultrasonic Instrumentation',
    body: 'Ultrasonic tips allow us to remove broken instruments, old filling materials, and calcium deposits with precision and minimal disruption to surrounding tooth structure — expanding the range of cases we can treat non-surgically.',
  },
  {
    num: '05',
    title: 'Nickel-Titanium Rotary Files',
    body: 'Our rotary file systems navigate curved canals with flexibility that stainless-steel instruments cannot match, reducing procedure time and improving the consistency of our cleaning and shaping.',
  },
  {
    num: '06',
    title: 'Electronic Apex Locators',
    body: 'These precision instruments measure root canal length electronically with an accuracy of ±0.5 mm, reducing the need for multiple X-rays and ensuring we clean the canal to exactly the right depth.',
  },
];
---

<BaseLayout
  title="Advanced Technology — Saddleback Valley Endodontics"
  description="Surgical microscopes, CBCT imaging, digital X-rays, and more — see the advanced endodontic technology we use to improve precision, comfort, and outcomes."
>
  <Header variant="solid" active="practice" />

  <main>

    <section class="at-intro">
      <p class="at-eyebrow">Advanced Technology</p>
      <h1 class="at-title">Precision you can<br/>only see under a microscope.</h1>
      <p class="at-lede">
        We invest in the most advanced endodontic technology available — not for marketing,
        but because better tools produce better outcomes for our patients.
      </p>
    </section>

    <section class="at-tech-grid">
      <div class="at-tech-header" data-reveal>
        <p class="at-section-eyebrow">Our Technology</p>
        <h2 class="at-section-headline">Tools that change what's possible.</h2>
      </div>
      <div class="at-grid">
        {technologies.map((t, i) => (
          <div class="at-tech-card" data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <p class="at-tech-num">{t.num}</p>
            <h3 class="at-tech-title">{t.title}</h3>
            <p class="at-tech-body">{t.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="at-photo-section">
      <div class="at-photo-grid">
        <div class="at-photo-text" data-reveal>
          <p class="at-section-eyebrow">Microscope-Guided Care</p>
          <h2 class="at-section-headline">What you can't see<br/>can hurt your tooth.</h2>
          <p class="at-photo-body">
            The majority of endodontic failures trace back to anatomy that was missed — a
            second canal, a crack, a resorptive defect. Our surgical microscope eliminates
            guesswork. At 20× magnification, we see details that are simply invisible at
            normal vision, and we treat them before they become problems.
          </p>
          <p class="at-photo-body">
            All of our endodontists are trained in microscope-guided technique as a core
            clinical skill — not as an optional upgrade.
          </p>
        </div>
        <div class="at-photo-image" data-reveal="right">
          <img
            src="/images/Saddleback-Valley-Endodontics.webp"
            alt="Advanced endodontic technology at Saddleback Valley Endodontics"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section class="at-cta">
      <div class="at-cta-inner" data-reveal>
        <p class="at-cta-eyebrow">Questions about your treatment?</p>
        <h2 class="at-cta-headline">We're here to explain everything.</h2>
        <p class="at-cta-body">
          Call <a href="tel:+19498373033">(949) 837-3033</a> or request an appointment online.
          We welcome all questions — before, during, and after your care.
        </p>
        <a href="/request-an-appointment/" class="at-cta-btn">Request an Appointment</a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  main { padding-top: var(--header-h); }

  .at-intro {
    padding: clamp(80px, 13vh, 140px) clamp(28px, 6vw, 88px) clamp(60px, 9vh, 100px);
    max-width: 960px; margin: 0 auto;
    border-bottom: 1px solid var(--color-line);
  }
  .at-eyebrow {
    font-size: 11px; letter-spacing: 0.36em; text-transform: uppercase;
    font-weight: 500; color: var(--color-ink-soft); margin: 0 0 32px;
  }
  .at-title {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(48px, 7.5vw, 96px); line-height: 1;
    letter-spacing: -0.015em; margin: 0 0 28px;
  }
  .at-lede {
    font-size: clamp(16px, 1.5vw, 19px); line-height: 1.65;
    color: var(--color-ink-soft); max-width: 58ch; margin: 0;
  }

  .at-tech-grid { padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px); }
  .at-tech-header { margin-bottom: clamp(48px, 7vh, 72px); }
  .at-section-eyebrow {
    font-size: 11px; letter-spacing: 0.36em; text-transform: uppercase;
    font-weight: 500; color: var(--color-ink-soft); margin: 0 0 20px;
  }
  .at-section-headline {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(28px, 4vw, 48px); line-height: 1.1;
    letter-spacing: -0.008em; margin: 0;
  }
  .at-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1px; background: var(--color-line); border: 1px solid var(--color-line);
    max-width: 1200px;
  }
  .at-tech-card {
    background: var(--color-paper);
    padding: clamp(32px, 4vw, 48px) clamp(24px, 3vw, 36px);
    display: flex; flex-direction: column; gap: 12px;
  }
  .at-tech-num {
    font-size: 11px; letter-spacing: 0.3em; font-weight: 500;
    color: var(--color-ink-soft); margin: 0;
  }
  .at-tech-title {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(18px, 1.8vw, 22px); line-height: 1.2;
    letter-spacing: -0.005em; margin: 0; color: var(--color-ink);
  }
  .at-tech-body {
    font-size: clamp(13px, 1.1vw, 15px); line-height: 1.65;
    color: var(--color-ink-soft); margin: 0;
  }

  .at-photo-section {
    background: var(--color-paper-warm);
    border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line);
    padding: clamp(80px, 12vh, 140px) 0;
  }
  .at-photo-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    align-items: start; max-width: 1200px; margin: 0 auto;
  }
  .at-photo-text { padding: clamp(48px, 7vw, 88px) clamp(32px, 5vw, 72px); }
  .at-photo-body {
    font-size: clamp(15px, 1.3vw, 17px); line-height: 1.75;
    color: var(--color-ink-soft); margin: 0 0 20px;
  }
  .at-photo-image img {
    width: 100%; min-height: 560px; object-fit: cover; display: block;
  }

  .at-cta { padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px); }
  .at-cta-inner { max-width: 680px; margin: 0 auto; text-align: center; }
  .at-cta-eyebrow {
    font-size: 11px; letter-spacing: 0.36em; text-transform: uppercase;
    font-weight: 500; color: var(--color-ink-soft); margin: 0 0 28px;
  }
  .at-cta-headline {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(28px, 4vw, 52px); line-height: 1.1;
    letter-spacing: -0.01em; margin: 0 0 20px;
  }
  .at-cta-body {
    font-size: clamp(15px, 1.3vw, 17px); line-height: 1.68;
    color: var(--color-ink-soft); margin: 0 0 36px;
  }
  .at-cta-body a { border-bottom: 1px solid currentColor; transition: opacity 0.2s; }
  .at-cta-body a:hover { opacity: 0.6; }
  .at-cta-btn {
    display: inline-block; font-size: 12px; letter-spacing: 0.28em;
    text-transform: uppercase; font-weight: 500; padding: 16px 36px;
    border: 1px solid var(--color-ink); color: var(--color-ink);
    transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out);
  }
  .at-cta-btn:hover { background: var(--color-ink); color: var(--color-paper); }

  @media (max-width: 960px) {
    .at-grid { grid-template-columns: repeat(2, 1fr); }
    .at-photo-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 580px) {
    .at-grid { grid-template-columns: 1fr; }
  }
</style>
