---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const reasons = [
  {
    num: '01',
    title: 'Fellowship-Trained Specialists',
    body: 'Our endodontists completed accredited specialty residency programs and hold fellowship recognition from the American Association of Endodontists — the highest credential in the field.',
  },
  {
    num: '02',
    title: 'Surgical Microscope on Every Case',
    body: 'We perform every procedure under 20–30× magnification. Most dental offices — including general dentists offering root canals — do not use a surgical microscope at all.',
  },
  {
    num: '03',
    title: 'Same-Day Urgent Appointments',
    body: 'Dental pain doesn\'t wait for Monday morning. We reserve time every day for urgent cases and respond to every inquiry the same business day.',
  },
  {
    num: '04',
    title: 'Anxiety & Sedation Options',
    body: 'From advanced local anesthesia to nitrous oxide and oral sedation, we have options for every level of dental anxiety. Our team moves at your pace.',
  },
  {
    num: '05',
    title: 'In-Office CBCT Imaging',
    body: 'Our cone-beam CT scanner produces 3D images of your tooth in seconds — no referral to a separate imaging center, no delays, and a more complete diagnosis.',
  },
  {
    num: '06',
    title: 'Trusted by South OC Dentists',
    body: 'General dentists throughout Laguna Hills, Mission Viejo, Aliso Viejo, and surrounding cities refer their most complex cases to us because they trust our outcomes and our communication.',
  },
];
---

<BaseLayout
  title="Why Choose Us — Saddleback Valley Endodontics"
  description="Fellowship-trained specialists, surgical microscopes, same-day urgent care, and sedation options — here's why South OC patients and dentists trust Saddleback Valley Endodontics."
>
  <Header variant="solid" active="practice" />

  <main>

    <section class="wc-intro">
      <p class="wc-eyebrow">Why Choose Us</p>
      <h1 class="wc-title">The specialist difference<br/>is real.</h1>
      <p class="wc-lede">
        Not all root canals are the same. A fellowship-trained endodontist, a surgical
        microscope, and in-office 3D imaging change what's possible — and what you experience.
      </p>
    </section>

    <section class="wc-reasons">
      <div class="wc-reasons-header" data-reveal>
        <p class="wc-section-eyebrow">Why Patients Choose Us</p>
        <h2 class="wc-section-headline">Six things that set us apart.</h2>
      </div>
      <div class="wc-reasons-grid">
        {reasons.map((r, i) => (
          <div class="wc-reason-card" data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <p class="wc-reason-num">{r.num}</p>
            <h3 class="wc-reason-title">{r.title}</h3>
            <p class="wc-reason-body">{r.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="wc-photo-section">
      <div class="wc-photo-grid">
        <div class="wc-photo-image" data-reveal="left">
          <img
            src="/images/Saddleback-Valley-Endodontics.webp"
            alt="Saddleback Valley Endodontics team"
            loading="lazy"
          />
        </div>
        <div class="wc-photo-text" data-reveal="right">
          <p class="wc-section-eyebrow">Our Philosophy</p>
          <h2 class="wc-section-headline">Save the tooth first.</h2>
          <p class="wc-photo-body">
            When a tooth can reasonably be saved, we believe it should be. Natural teeth
            outperform implants in long-term function, bone preservation, and cost — when the
            clinical conditions are right. We give you an honest evaluation, not a default
            recommendation based on what's easier or more profitable.
          </p>
          <p class="wc-photo-body">
            If extraction and implant placement is genuinely the better path for your situation,
            we'll tell you that too — and help you understand why.
          </p>
        </div>
      </div>
    </section>

    <section class="wc-stats">
      <div class="wc-stats-inner">
        <div class="wc-stat" data-reveal data-reveal-delay="1">
          <p class="wc-stat-number">20+</p>
          <p class="wc-stat-label">Years in South OC</p>
        </div>
        <div class="wc-stat" data-reveal data-reveal-delay="2">
          <p class="wc-stat-number">10,000+</p>
          <p class="wc-stat-label">Root Canals Performed</p>
        </div>
        <div class="wc-stat" data-reveal data-reveal-delay="3">
          <p class="wc-stat-number">5-Star</p>
          <p class="wc-stat-label">Average Google Rating</p>
        </div>
        <div class="wc-stat" data-reveal data-reveal-delay="4">
          <p class="wc-stat-number">Same-Day</p>
          <p class="wc-stat-label">Urgent Appointments</p>
        </div>
      </div>
    </section>

    <section class="wc-cta">
      <div class="wc-cta-inner" data-reveal>
        <p class="wc-cta-eyebrow">Experience the difference</p>
        <h2 class="wc-cta-headline">Specialist care when you need it most.</h2>
        <p class="wc-cta-body">
          Call <a href="tel:+19495818890">(949) 581-8890</a> or request an appointment online.
          We respond to every inquiry the same business day.
        </p>
        <a href="/request-an-appointment/" class="wc-cta-btn">Request an Appointment</a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  main { padding-top: var(--header-h); }

  .wc-intro {
    padding: clamp(80px, 13vh, 140px) clamp(28px, 6vw, 88px) clamp(60px, 9vh, 100px);
    max-width: 960px; margin: 0 auto;
    border-bottom: 1px solid var(--color-line);
  }
  .wc-eyebrow {
    font-size: 11px; letter-spacing: 0.36em; text-transform: uppercase;
    font-weight: 500; color: var(--color-ink-soft); margin: 0 0 32px;
  }
  .wc-title {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(48px, 7.5vw, 96px); line-height: 1;
    letter-spacing: -0.015em; margin: 0 0 28px;
  }
  .wc-lede {
    font-size: clamp(16px, 1.5vw, 19px); line-height: 1.65;
    color: var(--color-ink-soft); max-width: 58ch; margin: 0;
  }

  .wc-reasons { padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px); }
  .wc-reasons-header { margin-bottom: clamp(48px, 7vh, 72px); }
  .wc-section-eyebrow {
    font-size: 11px; letter-spacing: 0.36em; text-transform: uppercase;
    font-weight: 500; color: var(--color-ink-soft); margin: 0 0 20px;
  }
  .wc-section-headline {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(28px, 4vw, 48px); line-height: 1.1;
    letter-spacing: -0.008em; margin: 0;
  }
  .wc-reasons-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1px; background: var(--color-line); border: 1px solid var(--color-line);
    max-width: 1200px;
  }
  .wc-reason-card {
    background: var(--color-paper);
    padding: clamp(32px, 4vw, 48px) clamp(24px, 3vw, 36px);
  }
  .wc-reason-num {
    font-size: 11px; letter-spacing: 0.3em; font-weight: 500;
    color: var(--color-ink-soft); margin: 0 0 20px;
  }
  .wc-reason-title {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(18px, 1.8vw, 22px); line-height: 1.2;
    letter-spacing: -0.005em; margin: 0 0 14px; color: var(--color-ink);
  }
  .wc-reason-body {
    font-size: clamp(13px, 1.1vw, 15px); line-height: 1.65;
    color: var(--color-ink-soft); margin: 0;
  }

  .wc-photo-section {
    background: var(--color-paper-warm);
    border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line);
    padding: clamp(80px, 12vh, 140px) 0;
  }
  .wc-photo-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    align-items: start; max-width: 1200px; margin: 0 auto;
  }
  .wc-photo-image img {
    width: 100%; min-height: 560px; object-fit: cover; display: block;
  }
  .wc-photo-text { padding: clamp(48px, 7vw, 88px) clamp(32px, 5vw, 72px); }
  .wc-photo-body {
    font-size: clamp(15px, 1.3vw, 17px); line-height: 1.75;
    color: var(--color-ink-soft); margin: 0 0 20px;
  }

  .wc-stats {
    padding: clamp(60px, 10vh, 100px) clamp(28px, 6vw, 88px);
    border-bottom: 1px solid var(--color-line);
  }
  .wc-stats-inner {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: clamp(32px, 5vw, 56px); max-width: 960px; margin: 0 auto;
  }
  .wc-stat { text-align: center; }
  .wc-stat-number {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(32px, 5vw, 56px); line-height: 1; letter-spacing: -0.02em;
    color: var(--color-ink); margin: 0 0 10px;
  }
  .wc-stat-label {
    font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase;
    font-weight: 500; color: var(--color-ink-soft); margin: 0;
  }

  .wc-cta { padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px); }
  .wc-cta-inner { max-width: 680px; margin: 0 auto; text-align: center; }
  .wc-cta-eyebrow {
    font-size: 11px; letter-spacing: 0.36em; text-transform: uppercase;
    font-weight: 500; color: var(--color-ink-soft); margin: 0 0 28px;
  }
  .wc-cta-headline {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(28px, 4vw, 52px); line-height: 1.1;
    letter-spacing: -0.01em; margin: 0 0 20px;
  }
  .wc-cta-body {
    font-size: clamp(15px, 1.3vw, 17px); line-height: 1.68;
    color: var(--color-ink-soft); margin: 0 0 36px;
  }
  .wc-cta-body a { border-bottom: 1px solid currentColor; transition: opacity 0.2s; }
  .wc-cta-body a:hover { opacity: 0.6; }
  .wc-cta-btn {
    display: inline-block; font-size: 12px; letter-spacing: 0.28em;
    text-transform: uppercase; font-weight: 500; padding: 16px 36px;
    border: 1px solid var(--color-ink); color: var(--color-ink);
    transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out);
  }
  .wc-cta-btn:hover { background: var(--color-ink); color: var(--color-paper); }

  @media (max-width: 960px) {
    .wc-reasons-grid { grid-template-columns: repeat(2, 1fr); }
    .wc-photo-grid { grid-template-columns: 1fr; }
    .wc-stats-inner { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 580px) {
    .wc-reasons-grid { grid-template-columns: 1fr; }
  }
</style>
