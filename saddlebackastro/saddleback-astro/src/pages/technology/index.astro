---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const technologies = [
  {
    number: '01',
    name: 'Gentlewave',
    tagline: 'Advanced fluid dynamics. Cleaner canals. Stronger teeth.',
    image: 'https://images.unsplash.com/photo-1581595220892-b0739db3ba8c?auto=format&fit=crop&w=1200&q=80',
    body: 'Sonendo Gentlewave is state-of-the-art technology that uses advanced fluid dynamics and soundwaves to completely clean and disinfect even the most complex canal anatomy. This incredible system accomplishes this while simultaneously allowing us to conserve more of your tooth structure, resulting in a cleaner, yet stronger tooth. With the Gentlewave, we have been able to save teeth that otherwise would have needed to be extracted.',
    specs: ['Advanced fluid dynamics & soundwave cleaning', 'Reaches complex canal anatomy', 'Preserves more natural tooth structure', 'Saves teeth previously considered unrestorable'],
  },
  {
    number: '02',
    name: 'Cone Beam CT',
    tagline: 'Three-dimensional clarity before the first instrument.',
    image: 'https://images.unsplash.com/photo-1559757148-5c350d0d3c56?auto=format&fit=crop&w=1200&q=80',
    body: 'Cone Beam Computed Tomography (CBCT) allows us to see through anatomical structures in 3 dimensions and has proven to be an invaluable tool in the diagnosis and treatment of a wide range of endodontic scenarios. Canals, anatomical structures, and infectious lesions that are not visible with standard 2-dimensional x-rays are often seen clearly with CBCT. CBCT can be valuable in helping to identify teeth where treatment is needed that would otherwise go undetected. It is also extremely valuable in identifying cases where treatment would be predestined to failure — saving countless patients from wasting time, money, and hope on a lost cause.',
    specs: ['3-dimensional anatomical imaging', 'Detects canals invisible on standard x-rays', 'Identifies infectious lesions with precision', 'Guides surgical case planning'],
  },
  {
    number: '03',
    name: 'Surgical Operating Microscopes',
    tagline: 'You cannot treat what you cannot see.',
    image: 'https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&w=1200&q=80',
    body: 'Operating Microscopes are used throughout every treatment to ensure that treatment is safe, precise, and thorough. "The scope" is an absolutely essential piece of equipment in endodontic treatment — one cannot treat what they cannot see. At high magnification with coaxial illumination, calcifications, hairline cracks, untreated accessory canals, and instrument fragments all become visible and workable.',
    specs: ['Used in every non-surgical and surgical case', 'High magnification with coaxial illumination', 'Video documentation available', 'Reveals what is invisible to the naked eye'],
  },
  {
    number: '04',
    name: 'Ultrasonic Instrumentation',
    tagline: 'Precision beyond what a hand instrument can reach.',
    image: 'https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=1200&q=80',
    body: 'Ultrasonic instruments are small instruments that allow for very careful and controlled removal of tooth structure. Ultrasonic instruments are routinely used in combination with the operating microscope and CBCT scans to safely locate tiny hidden canals, which are otherwise untreatable. In surgical cases, ultrasonic retropreparation has replaced the bur as the standard of care, producing a cleaner, more conservatively shaped preparation entirely within the root end.',
    specs: ['Hidden canal location', 'Broken instrument removal', 'Irrigant activation for deeper disinfection', 'Surgical retropreparation'],
  },
  {
    number: '05',
    name: 'Infection Control',
    tagline: 'Water quality that exceeds CDC standards.',
    image: 'https://images.unsplash.com/photo-1530026405186-ed1f139313f8?auto=format&fit=crop&w=1200&q=80',
    body: 'High standards of asepsis and sterilization are adhered to in our office. One example is our Sterilox generator — an FDA-approved system used to destroy and prevent the formation of biofilms in dental treatment water lines. The Sterilox ensures that water used during treatment is completely safe and free of micro-organisms that typically inhabit water lines, allowing our water quality to dramatically exceed the standards set forth by the Centers for Disease Control.',
    specs: ['FDA-approved Sterilox water treatment', 'Eliminates biofilm in treatment water lines', 'Exceeds CDC water quality standards', 'Full asepsis and sterilization protocols'],
  },
  {
    number: '06',
    name: 'Digital Radiography',
    tagline: 'Immediate, low-dose, high-resolution images.',
    image: 'https://images.unsplash.com/photo-1584820927498-cfe5211fd8bf?auto=format&fit=crop&w=1200&q=80',
    body: 'Digital radiography is used instead of conventional x-rays, resulting in substantially less radiation exposure and more efficient treatment. Images are available instantly and do not require the environmentally harmful chemicals used to develop traditional film. CBCT scans also use digital radiography and require only a tiny fraction of the exposure of a medical CT scan.',
    specs: ['Up to 90% radiation reduction vs. film', 'Immediate chairside image review', 'No chemical processing required', 'Seamless digital sharing with referring doctors'],
  },
  {
    number: '07',
    name: 'Secure Server & Patient Records',
    tagline: 'Best-in-class software. Fully protected records.',
    image: 'https://images.unsplash.com/photo-1633265486064-086b219458ec?auto=format&fit=crop&w=1200&q=80',
    body: 'We use TDO Software, which we believe is the best endodontic software available. Created by a visionary endodontist, the features of TDO are extensive and the secure server is regularly backed up to ensure all patient information is protected. TDO technology allows documentation to be more thorough and allows us to communicate more effectively with both patients and referring doctors.',
    specs: ['TDO endodontic practice software', 'Encrypted, regularly backed-up server', 'Detailed consultation reports for referring offices', 'Streamlined patient communication'],
  },
];
---

<BaseLayout
  title="Technology — Saddleback Valley Endodontics"
  description="From Gentlewave and cone-beam CT to surgical operating microscopes and digital radiography — the advanced technology that makes our endodontic care more comfortable, thorough, and predictable."
>

  <Header variant="solid" active="tech" />

  <main>

    <section class="page-intro">
      <div class="page-intro-grid">
        <div class="page-intro-text">
          <p class="page-eyebrow">Technology</p>
          <h1 class="page-title">The tools that change what's possible.</h1>
          <p class="page-lede">
            Several remarkable endodontic advancements in recent years have made saving your tooth
            more comfortable, thorough, and predictable than ever. We take pride in practicing on
            the leading edge of technology and offering our patients the very best treatment
            available anywhere.
          </p>
        </div>
        <div class="page-intro-video">
          <div class="tech-video-embed">
            <iframe
              src="https://www.youtube.com/embed/pjNVdhCcJhw?start=12"
              title="Saddleback Valley Endodontics Technology"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    <section class="tech-list">
      {technologies.map((t, i) => (
        <article class={`tech-row ${i % 2 === 1 ? 'tech-row--reverse' : ''}`}>
          <div class="tech-image-wrap">
            <img class="tech-image" src={t.image} alt={t.name} loading="lazy" />
          </div>
          <div class="tech-content">
            <p class="tech-number">{t.number}</p>
            <h2 class="tech-name">{t.name}</h2>
            <p class="tech-tagline">{t.tagline}</p>
            <p class="tech-body">{t.body}</p>
            <ul class="tech-specs">
              {t.specs.map(s => <li>{s}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </section>

  </main>

  <Footer />

</BaseLayout>

<style is:global>
  main { padding-top: var(--header-h); }

  .page-intro {
    padding: clamp(80px, 13vh, 140px) clamp(28px, 6vw, 88px) clamp(60px, 9vh, 100px);
    border-bottom: 1px solid var(--color-line);
  }
  .page-intro-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(48px, 5vw, 80px);
    align-items: center;
  }
  .tech-video-embed {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
  }
  .tech-video-embed iframe {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    border: none;
  }
  @media (max-width: 860px) {
    .page-intro-grid { grid-template-columns: 1fr; }
  }
  .page-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 32px;
  }
  .page-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(52px, 8vw, 104px);
    line-height: 1;
    letter-spacing: -0.015em;
    margin: 0 0 28px;
  }
  .page-lede {
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.65;
    color: var(--color-ink-soft);
    max-width: 58ch;
    margin: 0;
  }

  .tech-list { }

  .tech-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 640px;
    border-bottom: 1px solid var(--color-line);
  }
  .tech-row--reverse { direction: rtl; }
  .tech-row--reverse > * { direction: ltr; }

  .tech-image-wrap {
    overflow: hidden;
    background: #f0ede5;
  }
  .tech-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s var(--ease-out);
  }
  .tech-row:hover .tech-image { transform: scale(1.04); }

  .tech-content {
    padding: clamp(56px, 8vw, 96px) clamp(40px, 6vw, 80px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .tech-number {
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 300;
    color: var(--color-ink-soft);
    opacity: 0.28;
    margin: 0 0 24px;
    line-height: 1;
  }

  .tech-name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(28px, 3.5vw, 42px);
    line-height: 1.08;
    letter-spacing: -0.005em;
    margin: 0 0 12px;
  }

  .tech-tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(16px, 1.6vw, 20px);
    color: var(--color-ink-soft);
    margin: 0 0 28px;
    line-height: 1.4;
  }

  .tech-body {
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.72;
    color: var(--color-ink-soft);
    margin: 0 0 32px;
  }

  .tech-specs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .tech-specs li {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    padding: 10px 0 10px 18px;
    border-bottom: 1px solid var(--color-line);
    position: relative;
  }
  .tech-specs li:first-child { border-top: 1px solid var(--color-line); }
  .tech-specs li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 6px;
    height: 1px;
    background: currentColor;
  }

  @media (max-width: 860px) {
    .tech-row { grid-template-columns: 1fr; min-height: auto; direction: ltr !important; }
    .tech-image-wrap { aspect-ratio: 16 / 9; }
    .tech-row--reverse .tech-image-wrap { order: -1; }
  }
</style>
