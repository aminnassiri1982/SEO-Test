---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
---

<BaseLayout
  title="Dr. Charles Tatosian, DDS, MS — Saddleback Valley Endodontics"
  description="Dr. Charles Tatosian is a board-certified endodontist and partner at Saddleback Valley Endodontics, in private practice in Mission Viejo since 1992."
>
  <Header variant="solid" />

  <main>

    <section class="bio-hero">
      <div class="bio-hero-portrait">
        <img
          src="/images/Charles-Tatosian-DDS-MS.webp"
          alt="Dr. Charles Tatosian"
          loading="eager"
        />
      </div>
      <div class="bio-hero-intro">
        <p class="bio-eyebrow"><a href="/team/">Our Doctors</a> / Dr. Tatosian</p>
        <p class="bio-credentials">DDS, MS · Diplomate, American Board of Endodontics</p>
        <h1 class="bio-name">Dr. Charles<br/>Tatosian</h1>
        <p class="bio-role">Partner</p>
        <ul class="bio-quick-facts">
          <li><span>Specialty</span><span>Endodontics</span></li>
          <li><span>Board</span><span>American Board of Endodontics</span></li>
          <li><span>Faculty</span><span>Adjunct Faculty, USC Herman Ostrow School of Dentistry</span></li>
          <li><span>In Practice Since</span><span>1992 — Mission Viejo, CA</span></li>
        </ul>
      </div>
    </section>

    <section class="bio-body">
      <div class="bio-content">

        <div class="bio-section">
          <h2 class="bio-section-title">Background</h2>
          <p>Dr. Tatosian was born in St. Louis, Missouri. He earned a Bachelor of Science in Chemistry from the University of Missouri–St. Louis before pursuing dental school at the University of Missouri–Kansas City School of Dentistry, where he earned his DDS degree.</p>
          <p>Following dental school, Dr. Tatosian completed a General Practice Residency at the VA Hospital in Kansas City, then spent five years in a combined role as general dentist and faculty member at Washington University in St. Louis — an experience that solidified his interest in teaching and specialty training.</p>
        </div>

        <div class="bio-section">
          <h2 class="bio-section-title">Specialty Training</h2>
          <p>Dr. Tatosian pursued his endodontic specialty at the University of Texas Health Science Center in Houston, earning his MS degree alongside his specialty certificate. He has been in private endodontic practice in Mission Viejo since 1992, making him one of the longest-tenured specialist endodontists in the South Orange County region.</p>
          <p>He holds an adjunct faculty appointment at the USC Herman Ostrow School of Dentistry and remains actively involved in continuing education and the profession through membership in multiple professional organizations.</p>
        </div>

        <div class="bio-section">
          <h2 class="bio-section-title">Clinical Philosophy</h2>
          <p>With more than three decades of practice in the same community, Dr. Tatosian has built his reputation on consistency, precision, and a deep commitment to the referring doctors who trust him with their patients. He understands that endodontic care is a coordinated effort — and that how a specialist communicates with a referring office matters as much as technical skill.</p>
          <p>He is a Diplomate of the American Board of Endodontics, reflecting his commitment to maintaining the highest standard of specialty practice throughout his career.</p>
        </div>

        <div class="bio-section">
          <h2 class="bio-section-title">Professional Memberships</h2>
          <p>Dr. Tatosian is an active member of the American Association of Endodontists (AAE), American Dental Association (ADA), California Dental Association (CDA), Orange County Dental Society (OCDS), Southern California Academy of Endodontists, Southwest Society of Endodontists, and the California Society of Anesthesiology in Dentistry (CSAE).</p>
        </div>

      </div>

      <aside class="bio-sidebar">
        <div class="bio-sidebar-block">
          <h3 class="bio-sidebar-label">Education</h3>
          <ul class="bio-sidebar-list">
            <li>BS Chemistry — University of Missouri–St. Louis</li>
            <li>DDS — University of Missouri–Kansas City School of Dentistry</li>
            <li>GPR — VA Hospital, Kansas City</li>
            <li>MS / Endodontic Specialty — University of Texas Health Science Center, Houston</li>
          </ul>
        </div>
        <div class="bio-sidebar-block">
          <h3 class="bio-sidebar-label">Certifications</h3>
          <ul class="bio-sidebar-list">
            <li>Diplomate, American Board of Endodontics</li>
          </ul>
        </div>
        <div class="bio-sidebar-block">
          <h3 class="bio-sidebar-label">Clinical Focus</h3>
          <ul class="bio-sidebar-list">
            <li>Root canal treatment &amp; retreatment</li>
            <li>Endodontic microsurgery</li>
            <li>Complex case planning &amp; diagnosis</li>
          </ul>
        </div>
        <div class="bio-sidebar-block">
          <h3 class="bio-sidebar-label">Faculty Appointment</h3>
          <ul class="bio-sidebar-list">
            <li>Adjunct Faculty — USC Herman Ostrow School of Dentistry</li>
          </ul>
        </div>
        <div class="bio-sidebar-block">
          <h3 class="bio-sidebar-label">Memberships</h3>
          <ul class="bio-sidebar-list">
            <li>American Association of Endodontists</li>
            <li>American Dental Association</li>
            <li>California Dental Association</li>
            <li>Orange County Dental Society</li>
            <li>Southern CA Academy of Endodontists</li>
            <li>Southwest Society of Endodontists</li>
            <li>CSAE</li>
          </ul>
        </div>
        <a href="/team/" class="bio-back-link">← Back to Our Doctors</a>
      </aside>
    </section>

    <section class="bio-cta">
      <div class="bio-cta-inner">
        <p class="bio-cta-eyebrow">Ready to get started?</p>
        <h2 class="bio-cta-headline">Schedule a consultation with Dr. Tatosian.</h2>
        <div class="bio-cta-actions">
          <a href="/request-an-appointment/" class="bio-cta-btn bio-cta-btn--primary">Request an Appointment</a>
          <a href="tel:+19495818890" class="bio-cta-btn bio-cta-btn--secondary">(949) 581-8890</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  main { padding-top: var(--header-h); }

  .bio-hero {
    display: grid;
    grid-template-columns: 420px 1fr;
    min-height: 80vh;
    border-bottom: 1px solid var(--color-line);
  }
  .bio-hero-portrait {
    overflow: hidden;
    background: #f0ede5;
  }
  .bio-hero-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }
  .bio-hero-intro {
    padding: clamp(60px, 10vh, 120px) clamp(40px, 6vw, 96px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .bio-eyebrow {
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 48px;
  }
  .bio-eyebrow a { color: inherit; border-bottom: 1px solid currentColor; transition: opacity 0.2s; }
  .bio-eyebrow a:hover { opacity: 0.6; }
  .bio-credentials {
    font-size: 11px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 20px;
  }
  .bio-name {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(44px, 6vw, 80px);
    line-height: 1;
    letter-spacing: -0.015em;
    margin: 0 0 16px;
  }
  .bio-role {
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 48px;
  }
  .bio-quick-facts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .bio-quick-facts li {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-size: 13px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink-soft);
  }
  .bio-quick-facts li span:first-child {
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 10px;
    color: var(--color-ink-soft);
    flex-shrink: 0;
    padding-top: 2px;
  }

  .bio-body {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 0;
    border-bottom: 1px solid var(--color-line);
  }
  .bio-content {
    padding: clamp(64px, 10vh, 100px) clamp(40px, 6vw, 96px);
    border-right: 1px solid var(--color-line);
  }
  .bio-section { margin-bottom: clamp(48px, 7vh, 72px); }
  .bio-section:last-child { margin-bottom: 0; }
  .bio-section-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(20px, 2vw, 26px);
    letter-spacing: -0.005em;
    margin: 0 0 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-line);
  }
  .bio-section p {
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.75;
    color: var(--color-ink-soft);
    margin: 0 0 20px;
    max-width: 68ch;
  }
  .bio-section p:last-child { margin-bottom: 0; }

  .bio-sidebar {
    padding: clamp(48px, 7vh, 80px) clamp(32px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .bio-sidebar-label {
    font-size: 10px;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 16px;
  }
  .bio-sidebar-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bio-sidebar-list li {
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-ink-soft);
    padding: 9px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .bio-sidebar-list li:first-child { border-top: 1px solid var(--color-line); }
  .bio-back-link {
    display: inline-block;
    margin-top: auto;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    transition: color 0.2s;
  }
  .bio-back-link:hover { color: var(--color-ink); }

  .bio-cta {
    background: var(--color-paper-warm);
    padding: clamp(72px, 12vh, 120px) clamp(28px, 6vw, 88px);
  }
  .bio-cta-inner { max-width: 680px; }
  .bio-cta-eyebrow {
    font-size: 11px; letter-spacing: 0.36em; text-transform: uppercase;
    font-weight: 500; color: var(--color-ink-soft); margin: 0 0 20px;
  }
  .bio-cta-headline {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(28px, 4vw, 48px); line-height: 1.1;
    letter-spacing: -0.008em; margin: 0 0 40px;
  }
  .bio-cta-actions { display: flex; gap: 20px; flex-wrap: wrap; }
  .bio-cta-btn {
    display: inline-block;
    font-size: 12px; letter-spacing: 0.28em; text-transform: uppercase;
    font-weight: 500; padding: 16px 36px;
    transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out);
  }
  .bio-cta-btn--primary {
    background: var(--color-ink); color: var(--color-paper);
    border: 1px solid var(--color-ink);
  }
  .bio-cta-btn--primary:hover { background: transparent; color: var(--color-ink); }
  .bio-cta-btn--secondary {
    background: transparent; color: var(--color-ink);
    border: 1px solid var(--color-ink);
  }
  .bio-cta-btn--secondary:hover { background: var(--color-ink); color: var(--color-paper); }

  @media (max-width: 1024px) {
    .bio-hero { grid-template-columns: 340px 1fr; }
  }
  @media (max-width: 860px) {
    .bio-hero { grid-template-columns: 1fr; min-height: auto; }
    .bio-hero-portrait { aspect-ratio: 4 / 3; max-height: 480px; }
    .bio-body { grid-template-columns: 1fr; }
    .bio-content { border-right: none; border-bottom: 1px solid var(--color-line); }
    .bio-sidebar { padding-top: clamp(40px, 6vh, 60px); }
  }
  @media (max-width: 560px) {
    .bio-quick-facts li { flex-direction: column; gap: 4px; }
    .bio-cta-actions { flex-direction: column; }
  }
</style>
