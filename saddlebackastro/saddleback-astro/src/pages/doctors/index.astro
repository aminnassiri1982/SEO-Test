---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const doctors = [
  {
    name: 'Dr. A. Reyes',
    title: 'Founding Partner',
    credentials: 'DDS, MS · Board Certified Endodontist',
    portrait: 'https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=800&q=80',
    bio: [
      'Dr. Reyes founded the practice with a clear conviction: that specialist endodontics should begin with a diagnosis conversation, not a procedure recommendation. Twenty-two years of clinical practice and a fellowship in microsurgical endodontics inform every consultation.',
      'He trained at the UCLA School of Dentistry, completed a two-year residency in endodontics, and has maintained board certification through the American Board of Endodontics since 2008. His clinical focus is complex retreatment and cases referred after failed prior treatment.',
    ],
    focus: ['Complex retreatment', 'Microsurgical endodontics', 'Cracked tooth diagnosis', 'Interdisciplinary case planning'],
    education: ['DDS — UCLA School of Dentistry', 'MS Endodontics — Loma Linda University', 'Board Certified — American Board of Endodontics'],
  },
  {
    name: 'Dr. J. Okafor',
    title: 'Partner',
    credentials: 'DDS, MS · Fellowship-Trained',
    portrait: 'https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=800&q=80',
    bio: [
      "Dr. Okafor leads the practice's imaging and microsurgical program. Her fellowship training in advanced diagnostics means she approaches every case from the CBCT image outward — understanding the three-dimensional anatomy before any instrument is placed.",
      'She joined the practice in 2018 after completing fellowship training and has since built one of the most active cone-beam CT programs among endodontic specialty offices in Southern California.',
    ],
    focus: ['CBCT-guided treatment planning', 'Endodontic microsurgery', 'Dental trauma', 'Calcified canal management'],
    education: ['DDS — University of Southern California', 'MS Endodontics — University of Washington', 'Fellowship — Advanced Endodontics, Boston University'],
  },
  {
    name: 'Dr. M. Chen',
    title: 'Associate',
    credentials: 'DDS, MS',
    portrait: 'https://images.unsplash.com/photo-1594824476967-48c8b964273f?auto=format&fit=crop&w=800&q=80',
    bio: [
      'Dr. Chen joined Saddleback Valley Endodontics after her endodontic residency, bringing particular depth in managing pediatric trauma cases and teeth in patients undergoing cancer treatment — a population whose dental needs require close coordination with oncology teams.',
      'She is fluent in Mandarin and Cantonese, and sees a broad caseload that includes many patients referred from across Orange County and Los Angeles.',
    ],
    focus: ['Pediatric endodontics', 'Oncology patient care', 'Dental trauma', 'Multilingual consultation (Mandarin, Cantonese)'],
    education: ['DDS — University of California, San Francisco', 'MS Endodontics — New York University', "Residency — Children's Hospital Los Angeles"],
  },
];
---

<BaseLayout
  title="Our Doctors — Saddleback Valley Endodontics"
  description="Meet the board-certified and fellowship-trained endodontists at Saddleback Valley Endodontics serving Mission Viejo, Laguna Hills, and surrounding Orange County, CA."
>
  <Header variant="solid" />

  <main>

    <section class="page-intro">
      <p class="page-eyebrow">Our Doctors</p>
      <h1 class="page-title">The specialists.</h1>
      <p class="page-lede">
        Specialist-level care means every case is reviewed, diagnosed, and treated by a
        fellowship-trained endodontist. Three doctors, one standard: no delegation of
        clinical judgment.
      </p>
    </section>

    <section class="docs-list">
      {doctors.map((doc, i) => (
        <article class="docs-card" id={`doctor-${i + 1}`}>
          <div class="docs-portrait-wrap">
            <img
              class="docs-portrait"
              src={doc.portrait}
              alt={doc.name}
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </div>
          <div class="docs-info">
            <p class="docs-credentials">{doc.credentials}</p>
            <h2 class="docs-name">{doc.name}</h2>
            <p class="docs-role">{doc.title}</p>
            <div class="docs-bio">
              {doc.bio.map(p => <p>{p}</p>)}
            </div>
            <div class="docs-cols">
              <div>
                <h3 class="docs-col-label">Clinical Focus</h3>
                <ul class="docs-detail-list">
                  {doc.focus.map(f => <li>{f}</li>)}
                </ul>
              </div>
              <div>
                <h3 class="docs-col-label">Education &amp; Training</h3>
                <ul class="docs-detail-list">
                  {doc.education.map(e => <li>{e}</li>)}
                </ul>
              </div>
            </div>
          </div>
        </article>
      ))}
    </section>

    <section class="docs-referral-band">
      <div class="docs-referral-header" data-reveal>
        <p class="docs-referral-eyebrow">For Referring Doctors</p>
        <h2 class="docs-referral-headline">We work alongside your team, not around it.</h2>
        <p class="docs-referral-body">
          We send a detailed consultation report within 24 hours of every patient visit. Urgent
          referrals are seen the same day when possible. Choose the referral method that works
          best for your office.
        </p>
      </div>

      <div class="docs-referral-cards">
        <div class="docs-referral-card" data-reveal data-reveal-delay="1">
          <p class="docs-ref-card-eyebrow">Existing Referring Doctors</p>
          <h3 class="docs-ref-card-title">Log in to your<br/>referral portal.</h3>
          <p class="docs-ref-card-body">
            Access your secure portal to submit referrals, view case updates, and retrieve
            consultation reports for your patients.
          </p>
          <a
            href="https://securesite29.tdo4endo.com/RefDocsLogin.aspx"
            target="_blank"
            rel="noopener noreferrer"
            class="docs-ref-card-btn docs-ref-card-btn--primary"
          >
            Referring Doctor Login
          </a>
        </div>

        <div class="docs-referral-card" data-reveal data-reveal-delay="2">
          <p class="docs-ref-card-eyebrow">New or No-Login Referral</p>
          <h3 class="docs-ref-card-title">Refer a patient<br/>without logging in.</h3>
          <p class="docs-ref-card-body">
            Prefer a quick form? Submit your referral directly — no account required. We'll
            contact your office to confirm and schedule.
          </p>
          <a
            href="https://refer.sbvendo.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="docs-ref-card-btn docs-ref-card-btn--secondary"
          >
            Submit a Referral
          </a>
        </div>
      </div>

      <div class="docs-referral-contact" data-reveal>
        <p>Questions? Call us directly at <a href="tel:+19495818890">(949) 581-8890</a> or fax <a href="tel:+19495813902">(949) 581-3902</a>.</p>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  main { padding-top: var(--header-h); }

  .page-intro {
    padding: clamp(80px, 13vh, 140px) clamp(28px, 6vw, 88px) clamp(60px, 9vh, 100px);
    max-width: 960px;
    border-bottom: 1px solid var(--color-line);
  }
  .page-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 32px;
  }
  .page-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(52px, 8vw, 104px);
    line-height: 1;
    letter-spacing: -0.015em;
    margin: 0 0 28px;
  }
  .page-lede {
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.65;
    color: var(--color-ink-soft);
    max-width: 58ch;
    margin: 0;
  }

  .docs-list {
    padding: 0 clamp(28px, 6vw, 88px);
  }

  .docs-card {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: clamp(40px, 6vw, 96px);
    padding: clamp(72px, 11vh, 120px) 0;
    border-bottom: 1px solid var(--color-line);
    align-items: start;
  }

  .docs-portrait-wrap {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #f0ede5;
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }
  .docs-portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.6s var(--ease-out);
  }
  .docs-card:hover .docs-portrait { filter: grayscale(0%); }

  .docs-credentials {
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 16px;
  }

  .docs-name {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(36px, 4.5vw, 60px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 8px;
  }

  .docs-role {
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 36px;
  }

  .docs-bio p {
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.72;
    color: var(--color-ink-soft);
    margin: 0 0 20px;
    max-width: 62ch;
  }

  .docs-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-top: 40px;
    padding-top: 40px;
    border-top: 1px solid var(--color-line);
  }

  .docs-col-label {
    font-size: 10px;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 18px;
  }

  .docs-detail-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .docs-detail-list li {
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-ink-soft);
    padding: 7px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .docs-detail-list li:first-child { border-top: 1px solid var(--color-line); }

  .docs-referral-band {
    background: var(--color-paper-warm);
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
    border-top: 1px solid var(--color-line);
  }

  .docs-referral-header { max-width: 680px; margin-bottom: clamp(48px, 7vh, 72px); }

  .docs-referral-eyebrow {
    font-size: 11px; letter-spacing: 0.36em; text-transform: uppercase;
    font-weight: 500; color: var(--color-ink-soft); margin: 0 0 28px;
  }
  .docs-referral-headline {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(28px, 4vw, 48px); line-height: 1.1;
    letter-spacing: -0.008em; margin: 0 0 24px;
  }
  .docs-referral-body {
    font-size: clamp(15px, 1.3vw, 17px); line-height: 1.68;
    color: var(--color-ink-soft); margin: 0;
  }

  .docs-referral-cards {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 1px; background: var(--color-line); border: 1px solid var(--color-line);
    max-width: 880px;
  }
  .docs-referral-card {
    background: var(--color-paper);
    padding: clamp(40px, 5vw, 64px) clamp(32px, 4vw, 52px);
    display: flex; flex-direction: column; gap: 16px;
  }
  .docs-ref-card-eyebrow {
    font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase;
    font-weight: 500; color: var(--color-ink-soft); margin: 0;
  }
  .docs-ref-card-title {
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(24px, 2.8vw, 36px); line-height: 1.1;
    letter-spacing: -0.008em; margin: 0; color: var(--color-ink);
  }
  .docs-ref-card-body {
    font-size: clamp(14px, 1.2vw, 15px); line-height: 1.68;
    color: var(--color-ink-soft); margin: 0; flex: 1;
  }
  .docs-ref-card-btn {
    display: inline-block; align-self: flex-start; margin-top: 8px;
    font-size: 12px; letter-spacing: 0.28em; text-transform: uppercase;
    font-weight: 500; padding: 14px 32px;
    transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out);
  }
  .docs-ref-card-btn--primary {
    background: var(--color-ink); color: var(--color-paper);
    border: 1px solid var(--color-ink);
  }
  .docs-ref-card-btn--primary:hover { background: transparent; color: var(--color-ink); }
  .docs-ref-card-btn--secondary {
    background: transparent; color: var(--color-ink);
    border: 1px solid var(--color-ink);
  }
  .docs-ref-card-btn--secondary:hover { background: var(--color-ink); color: var(--color-paper); }

  .docs-referral-contact {
    margin-top: clamp(32px, 4vh, 48px);
    font-size: 14px; color: var(--color-ink-soft);
  }
  .docs-referral-contact a { border-bottom: 1px solid currentColor; transition: opacity 0.2s; }
  .docs-referral-contact a:hover { opacity: 0.6; }

  @media (max-width: 900px) {
    .docs-card { grid-template-columns: 1fr; }
    .docs-portrait-wrap { max-width: 320px; position: static; aspect-ratio: 1 / 1; }
    .docs-referral-cards { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .docs-cols { grid-template-columns: 1fr; gap: 32px; }
    .docs-portrait-wrap { max-width: 100%; }
  }
</style>
