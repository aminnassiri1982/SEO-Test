---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const doctors = [
  {
    name: 'Dr. A. Reyes',
    title: 'Founding Partner',
    credentials: 'DDS, MS · Board Certified Endodontist',
    portrait: 'https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=800&q=80',
    bio: [
      'Dr. Reyes founded the practice with a clear conviction: that specialist endodontics should begin with a diagnosis conversation, not a procedure recommendation. Twenty-two years of clinical practice and a fellowship in microsurgical endodontics inform every consultation.',
      'He trained at the UCLA School of Dentistry, completed a two-year residency in endodontics, and has maintained board certification through the American Board of Endodontics since 2008. His clinical focus is complex retreatment and cases referred after failed prior treatment.',
    ],
    focus: ['Complex retreatment', 'Microsurgical endodontics', 'Cracked tooth diagnosis', 'Interdisciplinary case planning'],
    education: ['DDS — UCLA School of Dentistry', 'MS Endodontics — Loma Linda University', 'Board Certified — American Board of Endodontics'],
  },
  {
    name: 'Dr. J. Okafor',
    title: 'Partner',
    credentials: 'DDS, MS · Fellowship-Trained',
    portrait: 'https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=800&q=80',
    bio: [
      "Dr. Okafor leads the practice's imaging and microsurgical program. Her fellowship training in advanced diagnostics means she approaches every case from the CBCT image outward — understanding the three-dimensional anatomy before any instrument is placed.",
      'She joined the practice in 2018 after completing fellowship training and has since built one of the most active cone-beam CT programs among endodontic specialty offices in Southern California.',
    ],
    focus: ['CBCT-guided treatment planning', 'Endodontic microsurgery', 'Dental trauma', 'Calcified canal management'],
    education: ['DDS — University of Southern California', 'MS Endodontics — University of Washington', 'Fellowship — Advanced Endodontics, Boston University'],
  },
  {
    name: 'Dr. M. Chen',
    title: 'Associate',
    credentials: 'DDS, MS',
    portrait: 'https://images.unsplash.com/photo-1594824476967-48c8b964273f?auto=format&fit=crop&w=800&q=80',
    bio: [
      'Dr. Chen joined Saddleback Valley Endodontics after her endodontic residency, bringing particular depth in managing pediatric trauma cases and teeth in patients undergoing cancer treatment — a population whose dental needs require close coordination with oncology teams.',
      'She is fluent in Mandarin and Cantonese, and sees a broad caseload that includes many patients referred from across Orange County and Los Angeles.',
    ],
    focus: ['Pediatric endodontics', 'Oncology patient care', 'Dental trauma', 'Multilingual consultation (Mandarin, Cantonese)'],
    education: ['DDS — University of California, San Francisco', 'MS Endodontics — New York University', "Residency — Children's Hospital Los Angeles"],
  },
];
---

<BaseLayout
  title="Our Doctors — Saddleback Valley Endodontics"
  description="Meet the three board-certified and fellowship-trained endodontists at Saddleback Valley Endodontics serving Mission Viejo and Laguna Hills, CA."
>
  <Header variant="solid" />

  <main>

    <section class="page-intro">
      <p class="page-eyebrow">Our Doctors</p>
      <h1 class="page-title">The specialists.</h1>
      <p class="page-lede">
        Three fellowship-trained endodontists with combined experience spanning trauma, microsurgery,
        advanced imaging, and complex retreatment. Every case is reviewed at the attending level —
        no delegation of specialist decisions.
      </p>
    </section>

    <section class="dr-list">
      {doctors.map((doc, i) => (
        <article class="dr-card" id={`doctor-${i + 1}`}>
          <div class="dr-portrait-wrap">
            <img class="dr-portrait" src={doc.portrait} alt={doc.name} loading={i === 0 ? 'eager' : 'lazy'} />
          </div>
          <div class="dr-info">
            <p class="dr-eyebrow">{doc.credentials}</p>
            <h2 class="dr-name">{doc.name}</h2>
            <p class="dr-role">{doc.title}</p>
            <div class="dr-bio">
              {doc.bio.map(p => <p>{p}</p>)}
            </div>
            <div class="dr-cols">
              <div>
                <h3 class="dr-col-label">Clinical Focus</h3>
                <ul class="dr-detail-list">
                  {doc.focus.map(f => <li>{f}</li>)}
                </ul>
              </div>
              <div>
                <h3 class="dr-col-label">Education &amp; Training</h3>
                <ul class="dr-detail-list">
                  {doc.education.map(e => <li>{e}</li>)}
                </ul>
              </div>
            </div>
          </div>
        </article>
      ))}
    </section>

    <section class="dr-referral-band">
      <div class="dr-referral-inner">
        <p class="dr-referral-eyebrow">For Referring Doctors</p>
        <h2 class="dr-referral-headline">We work alongside your team, not around it.</h2>
        <p class="dr-referral-body">
          We send a detailed consultation report within 24 hours of every patient visit. Urgent referrals
          are seen the same day when possible. Call us directly at <a href="tel:+19498373033">(949) 837-3033</a> or use the referral form.
        </p>
        <a href="/contact/#referral" class="dr-cta-btn">Refer a Patient</a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  main { padding-top: var(--header-h); }

  .page-intro {
    padding: clamp(80px, 13vh, 140px) clamp(28px, 6vw, 88px) clamp(60px, 9vh, 100px);
    max-width: 960px;
    border-bottom: 1px solid var(--color-line);
  }
  .page-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 32px;
  }
  .page-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(52px, 8vw, 104px);
    line-height: 1;
    letter-spacing: -0.015em;
    margin: 0 0 28px;
  }
  .page-lede {
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.65;
    color: var(--color-ink-soft);
    max-width: 58ch;
    margin: 0;
  }

  .dr-list {
    padding: 0 clamp(28px, 6vw, 88px);
  }

  .dr-card {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: clamp(40px, 6vw, 96px);
    padding: clamp(72px, 11vh, 120px) 0;
    border-bottom: 1px solid var(--color-line);
    align-items: start;
  }

  .dr-portrait-wrap {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #f0ede5;
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }
  .dr-portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.6s var(--ease-out);
  }
  .dr-card:hover .dr-portrait { filter: grayscale(0%); }

  .dr-eyebrow {
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 16px;
  }

  .dr-name {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(36px, 4.5vw, 60px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 8px;
  }

  .dr-role {
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 36px;
  }

  .dr-bio p {
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.72;
    color: var(--color-ink-soft);
    margin: 0 0 20px;
    max-width: 62ch;
  }

  .dr-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-top: 40px;
    padding-top: 40px;
    border-top: 1px solid var(--color-line);
  }

  .dr-col-label {
    font-size: 10px;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 18px;
  }

  .dr-detail-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .dr-detail-list li {
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-ink-soft);
    padding: 7px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .dr-detail-list li:first-child { border-top: 1px solid var(--color-line); }

  .dr-referral-band {
    background: var(--color-paper-warm);
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
    border-top: 1px solid var(--color-line);
  }
  .dr-referral-inner { max-width: 680px; }

  .dr-referral-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 28px;
  }

  .dr-referral-headline {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.008em;
    margin: 0 0 24px;
  }

  .dr-referral-body {
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.68;
    color: var(--color-ink-soft);
    margin: 0 0 36px;
  }
  .dr-referral-body a { border-bottom: 1px solid currentColor; transition: opacity 0.2s; }
  .dr-referral-body a:hover { opacity: 0.6; }

  .dr-cta-btn {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 16px 36px;
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
    transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out);
  }
  .dr-cta-btn:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  @media (max-width: 900px) {
    .dr-card { grid-template-columns: 1fr; }
    .dr-portrait-wrap { max-width: 320px; position: static; aspect-ratio: 1 / 1; }
  }
  @media (max-width: 560px) {
    .dr-cols { grid-template-columns: 1fr; gap: 32px; }
    .dr-portrait-wrap { max-width: 100%; }
  }
</style>
