---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const testimonials = [
  {
    initials: 'J.M.',
    location: 'Mission Viejo',
    procedure: 'Root Canal Treatment',
    quote:
      'I came in convinced I was about to have the worst experience of my life. I was wrong. Dr. Reyes walked me through every step before he started, and I felt genuinely nothing during the procedure. The entire appointment, from check-in to discharge, took under two hours. I left without the tooth pain that had kept me up for three nights.',
  },
  {
    initials: 'R.T.',
    location: 'Laguna Hills',
    procedure: 'Root Canal Retreatment',
    quote:
      'A root canal I had done elsewhere years ago had been quietly failing — I only found out when my general dentist noticed bone loss on a routine X-ray. Dr. Reyes identified a missed canal that the original treatment had left untreated. The retreatment was completed in one visit. Six months later the bone has filled back in and the tooth is completely asymptomatic.',
  },
  {
    initials: 'S.K.',
    location: 'Aliso Viejo',
    procedure: 'Endodontic Microsurgery',
    quote:
      'I was told by two other offices that the tooth needed to come out. Saddleback Valley Endodontics took a CBCT scan, showed me exactly what was going on at the root tip, and explained why surgery could still save it. The apicoectomy was honestly easier than I expected — some soreness for a couple of days, then nothing. That tooth is still in my mouth a year later.',
  },
  {
    initials: 'P.N.',
    location: 'Lake Forest',
    procedure: 'Root Canal Treatment',
    quote:
      'Dr. Chen spoke with me in Mandarin throughout the whole appointment, which made an already stressful experience far more manageable. She explained the diagnosis clearly, showed me the X-rays, and answered every question before proceeding. The professionalism here is a genuine step above any other dental office I have visited.',
  },
  {
    initials: 'M.G.',
    location: 'Mission Viejo',
    procedure: 'Cracked Tooth Diagnosis',
    quote:
      "I had been chasing vague tooth pain for almost two years. Multiple dentists had checked it and couldn't find the cause. Dr. Okafor used the microscope and a CBCT scan together, and within the first appointment she had a definitive diagnosis: a vertical crack that wasn't visible on standard X-rays. Finally having an answer — and a treatment path — was a relief I can't overstate.",
  },
  {
    initials: 'C.L.',
    location: 'Rancho Santa Margarita',
    procedure: 'Dental Trauma',
    quote:
      'My teenager took an elbow to the mouth during a soccer game and we ended up here on a same-day urgent referral. Dr. Okafor was calm, thorough, and clearly experienced with trauma cases. She explained the long-term monitoring plan to both of us in terms we could understand. The follow-up care over the past several months has been just as attentive as that first visit.',
  },
];
---

<BaseLayout
  title="Patient Testimonials — Saddleback Valley Endodontics"
  description="Read what patients say about root canal treatment, retreatment, and specialist endodontic care at Saddleback Valley Endodontics in Mission Viejo, CA."
>
  <Header variant="solid" />

  <main>

    <section class="page-intro">
      <p class="page-eyebrow">Testimonials</p>
      <h1 class="page-title">What patients say.</h1>
      <p class="page-lede">
        Endodontic treatment carries a reputation that rarely matches the reality of a modern
        specialist office. These patients trusted the work — and the work held up.
      </p>
    </section>

    <section class="testi-grid-section">
      <div class="testi-grid">
        {testimonials.map(t => (
          <article class="testi-card">
            <div class="testi-procedure">{t.procedure}</div>
            <blockquote class="testi-quote">
              <p>"{t.quote}"</p>
            </blockquote>
            <footer class="testi-attribution">
              <span class="testi-initials">{t.initials}</span>
              <span class="testi-sep">·</span>
              <span class="testi-location">{t.location}</span>
            </footer>
          </article>
        ))}
      </div>
    </section>

    <section class="testi-cta-band">
      <div class="testi-cta-inner">
        <p class="testi-cta-eyebrow">Ready to be seen?</p>
        <h2 class="testi-cta-headline">Same-day urgent appointments available.</h2>
        <p class="testi-cta-body">
          Call us at <a href="tel:+19498373033">(949) 837-3033</a> or request a visit online.
          We respond to every inquiry the same business day.
        </p>
        <a href="/request-an-appointment/" class="testi-cta-btn">Request an Appointment</a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  main { padding-top: var(--header-h); }

  .page-intro {
    padding: clamp(80px, 13vh, 140px) clamp(28px, 6vw, 88px) clamp(60px, 9vh, 100px);
    max-width: 960px;
    border-bottom: 1px solid var(--color-line);
  }
  .page-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 32px;
  }
  .page-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(52px, 8vw, 104px);
    line-height: 1;
    letter-spacing: -0.015em;
    margin: 0 0 28px;
  }
  .page-lede {
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.65;
    color: var(--color-ink-soft);
    max-width: 58ch;
    margin: 0;
  }

  .testi-grid-section {
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
  }

  .testi-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }

  .testi-card {
    background: var(--color-paper);
    padding: clamp(36px, 5vw, 56px) clamp(28px, 4vw, 44px);
    display: flex;
    flex-direction: column;
    gap: 28px;
    transition: background 0.3s var(--ease-out);
  }
  .testi-card:hover {
    background: var(--color-paper-warm);
  }

  .testi-procedure {
    font-size: 10px;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
  }

  .testi-quote {
    margin: 0;
    padding: 0;
    border: none;
    flex: 1;
  }
  .testi-quote p {
    font-family: var(--font-display);
    font-size: clamp(16px, 1.6vw, 20px);
    font-weight: 300;
    font-style: italic;
    line-height: 1.65;
    color: var(--color-ink);
    margin: 0;
  }

  .testi-attribution {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 24px;
    border-top: 1px solid var(--color-line);
  }

  .testi-initials {
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-ink);
  }

  .testi-sep {
    color: var(--color-ink-soft);
    opacity: 0.5;
  }

  .testi-location {
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--color-ink-soft);
  }

  .testi-cta-band {
    background: var(--color-paper-warm);
    border-top: 1px solid var(--color-line);
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
  }

  .testi-cta-inner { max-width: 680px; }

  .testi-cta-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 28px;
  }

  .testi-cta-headline {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(28px, 4vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 20px;
  }

  .testi-cta-body {
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.68;
    color: var(--color-ink-soft);
    margin: 0 0 36px;
  }
  .testi-cta-body a {
    border-bottom: 1px solid currentColor;
    transition: opacity 0.2s;
  }
  .testi-cta-body a:hover { opacity: 0.6; }

  .testi-cta-btn {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 16px 36px;
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
    transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out);
  }
  .testi-cta-btn:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  @media (max-width: 1000px) {
    .testi-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 620px) {
    .testi-grid { grid-template-columns: 1fr; }
  }
</style>
