---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Insurance & Financing — Saddleback Valley Endodontics"
  description="Dental insurance and financing options at Saddleback Valley Endodontics, Laguna Hills and Mission Viejo, CA. (949) 581-8890."
>
  <Header variant="solid" />

  <main>

    <section class="page-intro">
      <p class="page-eyebrow">For Patients</p>
      <h1 class="page-title">Insurance &amp;<br/>Financing.</h1>
      <p class="page-lede">
        We work with most major dental insurance plans and offer flexible financing
        so cost doesn't delay needed care.
      </p>
    </section>

    <section class="ins-insurance">
      <div class="ins-insurance-inner">
        <div class="ins-section-header">
          <p class="ins-eyebrow" data-reveal>Insurance</p>
          <h2 class="ins-headline" data-reveal>We work with your insurance.</h2>
        </div>
        <div class="ins-insurance-body" data-reveal>
          <p class="ins-body-text">
            We accept most PPO dental insurance plans and verify your benefits before your appointment —
            so you know what to expect before treatment begins. Our team handles claim submission directly,
            and you are only responsible for your estimated patient portion at the time of service.
          </p>
          <div class="ins-note">
            <p class="ins-note-label">A note on HMO plans</p>
            <p class="ins-note-body">
              We are not in-network with HMO plans. If you have a PPO plan, we can typically bill as an
              out-of-network provider — call us and we'll check your benefits before you commit to an appointment.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="ins-coverage">
      <div class="ins-coverage-inner">
        <div class="ins-section-header">
          <p class="ins-eyebrow" data-reveal>Coverage</p>
          <h2 class="ins-headline" data-reveal>What's typically covered.</h2>
        </div>
        <div class="ins-card-grid">
          <div class="ins-card" data-reveal data-reveal-delay="1">
            <h3 class="ins-card-title">Diagnostic Services</h3>
            <p class="ins-card-body">Initial exam, digital X-rays, and CBCT imaging are often covered at 80–100% of the allowed amount.</p>
          </div>
          <div class="ins-card" data-reveal data-reveal-delay="2">
            <h3 class="ins-card-title">Root Canal Treatment</h3>
            <p class="ins-card-body">Most plans cover 50–80% of endodontic treatment after deductible. Coverage varies by plan and tooth position.</p>
          </div>
          <div class="ins-card" data-reveal data-reveal-delay="3">
            <h3 class="ins-card-title">Post-Operative Visits</h3>
            <p class="ins-card-body">Follow-up appointments and post-op checks are typically included in your treatment coverage.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="ins-financing">
      <div class="ins-financing-inner">
        <div class="ins-section-header">
          <p class="ins-eyebrow" data-reveal>Financing</p>
          <h2 class="ins-headline" data-reveal>Financing options.</h2>
        </div>
        <div class="ins-financing-body" data-reveal>
          <p class="ins-body-text">
            We partner with CareCredit and Sunbit to offer low- and no-interest payment plans.
            Apply in minutes — most patients are approved the same day.
          </p>
        </div>
        <div class="ins-financing-cards">
          <div class="ins-financing-card" data-reveal data-reveal-delay="1">
            <h3 class="ins-financing-card-title">CareCredit</h3>
            <p class="ins-financing-card-body">0% interest promotional periods available. Apply at carecredit.com or ask at check-in.</p>
          </div>
          <div class="ins-financing-card" data-reveal data-reveal-delay="2">
            <h3 class="ins-financing-card-title">Sunbit</h3>
            <p class="ins-financing-card-body">Fast approval, flexible monthly payments. No hard credit check required for initial application.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="ins-cta-band">
      <div class="ins-cta-inner" data-reveal>
        <h2 class="ins-cta-headline">Have a billing question?</h2>
        <p class="ins-cta-body">
          Our team verifies benefits before your appointment and answers every question before
          treatment begins. Call <a href="tel:+19495818890">(949) 581-8890</a>.
        </p>
        <a href="/request-an-appointment/" class="ins-cta-btn">Request an Appointment</a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  main { padding-top: var(--header-h); }

  .page-intro {
    padding: clamp(80px, 13vh, 140px) clamp(28px, 6vw, 88px) clamp(60px, 9vh, 100px);
    max-width: 960px;
    margin: 0 auto;
    border-bottom: 1px solid var(--color-line);
  }
  .page-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 32px;
  }
  .page-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(48px, 7.5vw, 96px);
    line-height: 1;
    letter-spacing: -0.015em;
    margin: 0 0 28px;
  }
  .page-lede {
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.65;
    color: var(--color-ink-soft);
    max-width: 58ch;
    margin: 0;
  }

  /* Shared section utilities */
  .ins-eyebrow { font-size: 11px; letter-spacing: 0.36em; text-transform: uppercase; font-weight: 500; color: var(--color-ink-soft); margin: 0 0 20px; }
  .ins-headline { font-family: var(--font-display); font-weight: 300; font-size: clamp(28px, 4vw, 52px); line-height: 1.1; letter-spacing: -0.01em; margin: 0; }
  .ins-section-header { margin-bottom: clamp(40px, 6vh, 64px); }
  .ins-body-text { font-size: clamp(15px, 1.3vw, 17px); line-height: 1.7; color: var(--color-ink-soft); max-width: 65ch; margin: 0; }

  /* Insurance section */
  .ins-insurance { background: var(--color-paper-warm); border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px); }
  .ins-insurance-inner { max-width: 800px; margin: 0 auto; }
  .ins-insurance-body { display: flex; flex-direction: column; gap: 32px; }
  .ins-note { border-left: 2px solid var(--color-line); padding: clamp(20px, 2.5vw, 28px) clamp(24px, 3vw, 36px); background: var(--color-paper); }
  .ins-note-label { font-size: 10px; letter-spacing: 0.34em; text-transform: uppercase; font-weight: 500; color: var(--color-ink-soft); margin: 0 0 10px; }
  .ins-note-body { font-size: clamp(13px, 1.1vw, 15px); line-height: 1.65; color: var(--color-ink-soft); margin: 0; }

  /* Coverage cards */
  .ins-coverage { padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px); }
  .ins-coverage-inner { max-width: 1120px; margin: 0 auto; }
  .ins-card-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--color-line); border: 1px solid var(--color-line); }
  .ins-card { background: var(--color-paper-warm); padding: clamp(32px, 4.5vw, 52px) clamp(24px, 3.5vw, 40px); display: flex; flex-direction: column; gap: 14px; }
  .ins-card-title { font-family: var(--font-display); font-weight: 400; font-size: clamp(18px, 2vw, 24px); line-height: 1.2; letter-spacing: -0.005em; margin: 0; color: var(--color-ink); }
  .ins-card-body { font-size: clamp(13px, 1.1vw, 15px); line-height: 1.65; color: var(--color-ink-soft); margin: 0; }

  /* Financing section */
  .ins-financing { background: var(--color-paper-warm); border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px); }
  .ins-financing-inner { max-width: 1000px; margin: 0 auto; }
  .ins-financing-body { margin-bottom: clamp(40px, 6vh, 56px); }
  .ins-financing-cards { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 3vw, 40px); }
  .ins-financing-card { background: var(--color-paper); border: 1px solid var(--color-line); padding: clamp(28px, 4vw, 44px); display: flex; flex-direction: column; gap: 14px; }
  .ins-financing-card-title { font-family: var(--font-display); font-weight: 400; font-size: clamp(20px, 2.2vw, 28px); line-height: 1.15; letter-spacing: -0.005em; margin: 0; color: var(--color-ink); }
  .ins-financing-card-body { font-size: clamp(13px, 1.1vw, 15px); line-height: 1.65; color: var(--color-ink-soft); margin: 0; }

  /* CTA band */
  .ins-cta-band { background: var(--color-ink); color: var(--color-paper); padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px); }
  .ins-cta-inner { max-width: 680px; margin: 0 auto; text-align: center; }
  .ins-cta-headline { font-family: var(--font-display); font-weight: 300; font-size: clamp(28px, 4vw, 52px); line-height: 1.1; letter-spacing: -0.01em; margin: 0 0 20px; color: var(--color-paper); }
  .ins-cta-body { font-size: clamp(15px, 1.3vw, 17px); line-height: 1.68; color: rgba(255,255,255,0.7); margin: 0 0 36px; }
  .ins-cta-body a { color: var(--color-paper); border-bottom: 1px solid rgba(255,255,255,0.4); transition: opacity 0.2s; }
  .ins-cta-body a:hover { opacity: 0.7; }
  .ins-cta-btn { display: inline-block; font-size: 12px; letter-spacing: 0.28em; text-transform: uppercase; font-weight: 500; padding: 16px 36px; border: 1px solid var(--color-paper); color: var(--color-paper); text-decoration: none; transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out); }
  .ins-cta-btn:hover { background: var(--color-paper); color: var(--color-ink); }

  @media (max-width: 900px) { .ins-card-grid { grid-template-columns: 1fr 1fr; } .ins-financing-cards { grid-template-columns: 1fr; } }
  @media (max-width: 580px) { .ins-card-grid { grid-template-columns: 1fr; } }
</style>
