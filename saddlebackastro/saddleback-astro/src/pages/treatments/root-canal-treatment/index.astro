---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const stats = [
  { value: '98%',  label: 'Patient Satisfaction' },
  { value: '20+',  label: 'Years of Experience' },
  { value: '15K+', label: 'Procedures Performed' },
  { value: '1-Day', label: 'Most Cases Completed' },
];

const benefits = [
  { icon: '⬡', title: 'Relieves Pain', body: 'A root canal removes the infected nerve — the source of the pain — giving you immediate relief once anesthesia wears off.' },
  { icon: '⬡', title: 'Saves Your Tooth', body: 'Treatment preserves your natural tooth, root, and surrounding bone rather than requiring extraction.' },
  { icon: '⬡', title: 'Same-Day Relief', body: 'Most cases are completed in a single visit. Urgent appointments are available for patients in acute pain.' },
  { icon: '⬡', title: 'Microscope Precision', body: 'Every procedure is performed under operating microscope magnification — the highest standard in endodontics.' },
];

const steps = [
  { number: '01', title: 'Consultation & Imaging', body: 'We begin with a thorough examination, including digital X-rays and cone-beam CT when indicated, to diagnose the problem and plan treatment precisely.' },
  { number: '02', title: 'Anesthesia', body: 'Local anesthesia is administered to fully numb the tooth and surrounding tissues before any instrumentation begins. Sedation is available for anxious patients.' },
  { number: '03', title: 'Access & Canal Identification', body: 'A small opening is made through the crown under microscope magnification. All canal orifices — including calcified or accessory ones — are identified.' },
  { number: '04', title: 'Cleaning & Shaping', body: 'Nickel-titanium rotary files and irrigation solution remove infected tissue and shape the canal system. Working length is confirmed with an electronic apex locator.' },
  { number: '05', title: 'Obturation & Sealing', body: 'Canals are filled with warm gutta-percha and sealed hermetically. A temporary or permanent coronal restoration is placed at the end of the visit.' },
];

const symptoms = [
  { title: 'Spontaneous toothache', body: 'Unprovoked, persistent, or throbbing pain in a tooth — especially pain that wakes you at night.' },
  { title: 'Lingering heat sensitivity', body: 'Sensitivity to hot liquids that persists after the stimulus is removed, lasting more than a few seconds.' },
  { title: 'Swelling or abscess', body: 'Facial swelling, a pimple on the gum, or a bad taste — signs of active infection that require prompt treatment.' },
  { title: 'Deep decay or fracture', body: 'A cavity or crack that has reached the pulp chamber, exposing the nerve to bacteria.' },
];

const faqs = [
  { q: 'Does a root canal hurt?', a: 'No — a root canal relieves pain rather than causing it. The procedure is performed under local anesthesia. Most patients describe feeling pressure but no pain. Post-treatment soreness for 1–3 days is managed with over-the-counter analgesics in most cases.' },
  { q: 'How long does it take?', a: 'A single-rooted tooth (front tooth or premolar) can often be completed in 60–90 minutes. Multi-rooted teeth or complex anatomy may require 90–120 minutes or a second appointment. We give you a realistic time estimate at consultation.' },
  { q: 'What is the success rate?', a: 'Published long-term studies show success rates above 90% for root canal treatment performed under modern conditions — microscopic magnification, precise instrumentation, and a definitive coronal restoration.' },
  { q: 'Do I still need a crown?', a: 'In most cases, yes. The access cavity and absence of vital pulp tissue make the tooth more susceptible to fracture. A crown placed by your general dentist seals the tooth and distributes bite forces to protect it.' },
  { q: 'Can I drive myself home?', a: 'Yes, if you receive only local anesthesia. If you choose oral sedation, you will need a driver for the day of your appointment.' },
];

const related = [
  { label: 'Root Canal Retreatment', href: '/treatments/root-canal-retreatment/', desc: 'Revision of a prior root canal when symptoms return.' },
  { label: 'Apical Surgery', href: '/treatments/apical-surgery-apicoectomy/', desc: 'Microsurgical access to the root tip when retreatment is not possible.' },
  { label: 'Anxiety & Sedation', href: '/treatments/anxiety-sedation/', desc: 'Nitrous oxide and oral sedation for anxious patients.' },
  { label: 'Implant vs. Root Canal', href: '/treatments/dental-implant/', desc: 'An honest comparison to help you make the right decision.' },
];
---

<BaseLayout
  title="Root Canal Treatment in Laguna Hills, CA — Saddleback Valley Endodontics"
  description="Root canal treatment in Laguna Hills and Mission Viejo, CA. Board-eligible endodontist, operating microscope, same-day urgent appointments. (949) 837-3033."
>
  <Header variant="solid" />

  <main class="rct-page">

    <!-- HERO -->
    <section class="rct-hero">
      <div class="rct-hero-image">
        <img
          src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=1600&q=80"
          alt="Endodontist treating a patient at Saddleback Valley Endodontics"
        />
        <div class="rct-hero-overlay"></div>
      </div>
      <div class="rct-hero-content">
        <p class="rct-hero-eyebrow">Laguna Hills, CA</p>
        <h1 class="rct-hero-title">Root Canal Treatment<br/>in Laguna Hills, CA</h1>
        <p class="rct-hero-sub">Precise, comfortable endodontic therapy that saves your natural tooth.</p>
        <a href="/request-an-appointment/" class="rct-hero-btn">Request an Appointment</a>
      </div>
      <div class="rct-stats-bar">
        {stats.map((s, i) => (
          <div class="rct-stat" data-reveal data-reveal-delay={String(i + 1)}>
            <span class="rct-stat-value">{s.value}</span>
            <span class="rct-stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- WHAT IS IT -->
    <section class="rct-what">
      <div class="rct-what-inner">
        <div class="rct-what-text" data-reveal="right">
          <p class="rct-section-eyebrow">Root Canal Treatment</p>
          <h2 class="rct-section-title">What is root canal treatment?</h2>
          <p class="rct-body-text">Root canal treatment removes infected or inflamed pulp tissue from inside a tooth, cleans and shapes the canal system, and seals it to prevent reinfection. The procedure relieves pain — it doesn't cause it — and preserves the natural tooth that would otherwise require extraction.</p>
          <p class="rct-body-text">The dental pulp is the soft tissue containing nerves and blood vessels at the center of each tooth. Once a tooth is fully formed, the pulp is not essential to function. A treated tooth can last a lifetime with the right restoration.</p>
          <a href="/request-an-appointment/" class="rct-outline-btn">Request an Appointment</a>
        </div>
        <div class="rct-what-image" data-reveal="left">
          <img
            src="https://images.unsplash.com/photo-1607990281513-2c110a25bd8c?auto=format&fit=crop&w=900&q=80"
            alt="Endodontist performing root canal under operating microscope"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- BENEFITS -->
    <section class="rct-benefits">
      <p class="rct-section-eyebrow rct-centered" data-reveal>Why treat with an endodontist?</p>
      <h2 class="rct-section-title rct-centered" data-reveal>Benefits of root canal treatment.</h2>
      <div class="rct-benefits-grid">
        {benefits.map((b, i) => (
          <div class="rct-benefit-card" data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <div class="rct-benefit-icon" aria-hidden="true"></div>
            <h3 class="rct-benefit-title">{b.title}</h3>
            <p class="rct-benefit-body">{b.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- STEPS -->
    <section class="rct-steps-section">
      <div class="rct-steps-inner">
        <div class="rct-steps-header">
          <p class="rct-section-eyebrow" data-reveal>The Procedure</p>
          <h2 class="rct-section-title" data-reveal>Our step-by-step<br/>treatment process.</h2>
          <p class="rct-body-text">Every appointment follows the same careful sequence — no shortcuts, no rushing. Most cases are complete in a single visit.</p>
        </div>
        <div class="rct-steps-list">
          {steps.map(s => (
            <div class="rct-step" data-reveal>
              <div class="rct-step-num">{s.number}</div>
              <div>
                <h3 class="rct-step-title">{s.title}</h3>
                <p class="rct-step-body">{s.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- TECHNOLOGY -->
    <section class="rct-tech">
      <div class="rct-tech-inner">
        <div class="rct-tech-image" data-reveal="left">
          <img
            src="https://images.unsplash.com/photo-1559757148-5c350d0d3c56?auto=format&fit=crop&w=900&q=80"
            alt="Cone-beam CT imaging for endodontic diagnosis"
            loading="lazy"
          />
        </div>
        <div class="rct-tech-text" data-reveal="right">
          <p class="rct-section-eyebrow">Technology</p>
          <h2 class="rct-section-title">Technology that<br/>changes everything.</h2>
          <ul class="rct-tech-list">
            <li>
              <strong>Operating Microscope (4×–25×)</strong>
              <span>Magnification that reveals what the naked eye cannot — calcifications, cracks, missed canals, and more.</span>
            </li>
            <li>
              <strong>Cone-Beam CT Imaging</strong>
              <span>3D volumetric imaging for complex cases where a 2D X-ray leaves questions unanswered.</span>
            </li>
            <li>
              <strong>NiTi Rotary Instrumentation</strong>
              <span>Single-use nickel-titanium files follow curved canals precisely and are discarded after every case.</span>
            </li>
            <li>
              <strong>Digital Radiography</strong>
              <span>Instant, low-dose images reviewed chairside throughout the procedure.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- WHEN NEEDED -->
    <section class="rct-when">
      <p class="rct-section-eyebrow rct-centered" data-reveal>Symptoms</p>
      <h2 class="rct-section-title rct-centered" data-reveal>When root canal treatment is needed.</h2>
      <div class="rct-when-grid">
        {symptoms.map((s, i) => (
          <div class="rct-when-card" data-reveal data-reveal-delay={String(i + 1)}>
            <h3 class="rct-when-title">{s.title}</h3>
            <p class="rct-when-body">{s.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- WHY CHOOSE US -->
    <section class="rct-why">
      <div class="rct-why-inner">
        <div class="rct-why-image" data-reveal="left">
          <img
            src="/images/Saddleback-Valley-Endodontics.webp"
            alt="Saddleback Valley Endodontics team"
            loading="lazy"
          />
        </div>
        <div class="rct-why-text" data-reveal="right">
          <p class="rct-section-eyebrow">South OC · Tooth No. 1</p>
          <h2 class="rct-section-title">Why choose us for root canal treatment in Laguna Hills?</h2>
          <ul class="rct-why-list">
            <li><strong>Specialist training.</strong> Our endodontists completed two to three years of additional specialty training after dental school — focused exclusively on root canals and related procedures.</li>
            <li><strong>Every case under the microscope.</strong> We use operating microscope magnification for every non-surgical and surgical procedure, not just the complex ones.</li>
            <li><strong>Same-day urgent care.</strong> We reserve time each day for patients in acute pain. Call and we will make every effort to see you the same day.</li>
            <li><strong>Convenient South OC location.</strong> Minutes from Laguna Hills, Lake Forest, Aliso Viejo, and Mission Viejo.</li>
          </ul>
          <a href="/request-an-appointment/" class="rct-cta-filled-btn">Request an Appointment</a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="rct-faq">
      <div class="rct-faq-inner">
        <div class="rct-faq-header">
          <p class="rct-section-eyebrow" data-reveal>Frequently Asked Questions</p>
          <h2 class="rct-section-title" data-reveal>Root canal FAQ.</h2>
        </div>
        <div class="rct-faq-list">
          {faqs.map(f => (
            <details class="rct-faq-item" name="rct-faq" data-reveal>
              <summary class="rct-faq-q">
                <span>{f.q}</span>
                <span class="rct-faq-icon" aria-hidden="true"></span>
              </summary>
              <div class="rct-faq-a"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- APPOINTMENT FORM -->
    <section class="rct-form-section">
      <div class="rct-form-inner">
        <div class="rct-form-text">
          <p class="rct-section-eyebrow">Schedule Today</p>
          <h2 class="rct-section-title">Request your appointment in Laguna Hills, CA.</h2>
          <ul class="rct-form-details">
            <li><span class="rct-form-label">Phone</span><a href="tel:+19498373033">(949) 837-3033</a></li>
            <li><span class="rct-form-label">Address</span><span>25800 Jeronimo Rd, Suite 300<br/>Mission Viejo, CA 92691</span></li>
            <li><span class="rct-form-label">Hours</span><span>Mon–Thu 8 am–5 pm · Fri 8 am–2 pm</span></li>
          </ul>
        </div>
        <form class="rct-form" name="rct-appointment" netlify data-netlify="true" action="/contact/thank-you/">
          <input type="hidden" name="form-name" value="rct-appointment" />
          <div class="rct-form-row rct-form-row--two">
            <div class="rct-form-field">
              <label for="rct_first">First name</label>
              <input type="text" id="rct_first" name="firstName" autocomplete="given-name" required />
            </div>
            <div class="rct-form-field">
              <label for="rct_last">Last name</label>
              <input type="text" id="rct_last" name="lastName" autocomplete="family-name" required />
            </div>
          </div>
          <div class="rct-form-row rct-form-row--two">
            <div class="rct-form-field">
              <label for="rct_email">Email</label>
              <input type="email" id="rct_email" name="email" autocomplete="email" required />
            </div>
            <div class="rct-form-field">
              <label for="rct_phone">Phone</label>
              <input type="tel" id="rct_phone" name="phone" autocomplete="tel" />
            </div>
          </div>
          <div class="rct-form-row">
            <div class="rct-form-field">
              <label for="rct_reason">Reason for visit</label>
              <select id="rct_reason" name="reason" required>
                <option value="" disabled selected>Select one…</option>
                <option value="root-canal">Root canal treatment</option>
                <option value="second-opinion">Second opinion</option>
                <option value="emergency">Dental emergency</option>
                <option value="other">Other</option>
              </select>
            </div>
          </div>
          <button type="submit" class="rct-form-submit">Submit Request</button>
        </form>
      </div>
    </section>

    <!-- RELATED TREATMENTS -->
    <section class="rct-related">
      <p class="rct-section-eyebrow rct-centered" data-reveal>Also in Laguna Hills</p>
      <h2 class="rct-section-title rct-centered" data-reveal>Related endodontic treatments.</h2>
      <div class="rct-related-grid">
        {related.map((r, i) => (
          <a href={r.href} class="rct-related-card" data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <h3 class="rct-related-name">{r.label}</h3>
            <p class="rct-related-desc">{r.desc}</p>
            <span class="rct-related-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <!-- BOTTOM CTA -->
    <section class="rct-bottom-cta">
      <div class="rct-bottom-cta-inner" data-reveal>
        <h2 class="rct-bottom-cta-title">Ready to save your tooth?</h2>
        <p class="rct-bottom-cta-body">Call <a href="tel:+19498373033">(949) 837-3033</a> or request online. Same-day appointments available for urgent pain.</p>
        <div class="rct-bottom-cta-btns">
          <a href="/request-an-appointment/" class="rct-cta-filled-btn">Request an Appointment</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  .rct-page { padding-top: var(--header-h); }

  /* ── Shared typography utilities ── */
  .rct-section-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 16px;
  }
  .rct-section-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(28px, 4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 24px;
  }
  .rct-body-text {
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.72;
    color: var(--color-ink-soft);
    margin: 0 0 18px;
  }
  .rct-centered { text-align: center; }

  /* ── Buttons ── */
  .rct-hero-btn,
  .rct-cta-filled-btn {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 16px 36px;
    background: var(--color-ink);
    color: var(--color-paper);
    border: 1px solid var(--color-ink);
    transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out);
  }
  .rct-hero-btn:hover,
  .rct-cta-filled-btn:hover {
    background: transparent;
    color: var(--color-ink);
  }
  .rct-outline-btn {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 14px 32px;
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
    transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out);
  }
  .rct-outline-btn:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  /* ── HERO ── */
  .rct-hero {
    position: relative;
    min-height: 520px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .rct-hero-image {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .rct-hero-image img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .rct-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(10,10,10,0.25) 0%, rgba(10,10,10,0.65) 100%);
  }
  .rct-hero-content {
    position: relative;
    padding: clamp(56px, 10vh, 120px) clamp(28px, 6vw, 88px) 48px;
    color: #fff;
    max-width: 800px;
  }
  .rct-hero-content .rct-section-eyebrow { color: rgba(255,255,255,0.65); }
  .rct-hero-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(36px, 5.5vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0 0 18px;
    color: #fff;
  }
  .rct-hero-sub {
    font-size: clamp(15px, 1.4vw, 18px);
    color: rgba(255,255,255,0.82);
    margin: 0 0 32px;
    max-width: 52ch;
    line-height: 1.6;
  }
  .rct-hero-btn { border-color: #fff; background: #fff; color: var(--color-ink); }
  .rct-hero-btn:hover { background: transparent; color: #fff; }

  .rct-stats-bar {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--color-paper);
    border-top: 1px solid var(--color-line);
  }
  .rct-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(20px, 3.5vh, 32px) 16px;
    border-right: 1px solid var(--color-line);
    text-align: center;
  }
  .rct-stat:last-child { border-right: 0; }
  .rct-stat-value {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.5vw, 44px);
    font-weight: 300;
    line-height: 1;
    margin-bottom: 6px;
  }
  .rct-stat-label {
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
  }

  /* ── WHAT IS IT ── */
  .rct-what {
    border-bottom: 1px solid var(--color-line);
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
  }
  .rct-what-inner {
    display: grid;
    grid-template-columns: 1fr 480px;
    gap: clamp(48px, 7vw, 96px);
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }
  .rct-what-image { overflow: hidden; }
  .rct-what-image img { width: 100%; display: block; }

  /* ── BENEFITS ── */
  .rct-benefits {
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
    background: var(--color-paper-warm);
    border-bottom: 1px solid var(--color-line);
  }
  .rct-benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(24px, 4vw, 48px);
    margin-top: clamp(40px, 6vh, 64px);
    max-width: 1200px;
    margin: 0 auto;
    margin-left: auto;
    margin-right: auto;
  }
  .rct-benefit-card {
    border-top: 2px solid var(--color-line);
    padding-top: clamp(20px, 3vh, 32px);
  }
  .rct-benefit-icon {
    width: 28px; height: 28px;
    border: 1px solid var(--color-ink);
    border-radius: 50%;
    margin-bottom: 20px;
  }
  .rct-benefit-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(18px, 1.8vw, 22px);
    margin: 0 0 12px;
    line-height: 1.2;
  }
  .rct-benefit-body {
    font-size: clamp(13px, 1.1vw, 15px);
    line-height: 1.65;
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* ── STEPS ── */
  .rct-steps-section {
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
    border-bottom: 1px solid var(--color-line);
  }
  .rct-steps-inner {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: clamp(48px, 7vw, 96px);
    align-items: start;
    max-width: 1200px;
    margin: 0 auto;
  }
  .rct-steps-header { position: sticky; top: calc(var(--header-h) + 32px);   align-self: start;
}
  align-self: start;
  .rct-steps-list { display: flex; flex-direction: column; }
  .rct-step {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 0 clamp(16px, 3vw, 32px);
    padding: clamp(28px, 4vh, 44px) 0;
    border-bottom: 1px solid var(--color-line);
  }
  .rct-step:first-child { border-top: 1px solid var(--color-line); }
  .rct-step-num {
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 300;
    color: var(--color-ink-soft);
    opacity: 0.3;
    line-height: 1.1;
    padding-top: 2px;
  }
  .rct-step-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.15;
    margin: 0 0 10px;
  }
  .rct-step-body {
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.7;
