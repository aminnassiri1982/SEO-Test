---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const stats = [
  { value: '90%+',      label: '10-Year Success Rate' },
  { value: 'Same-Day',  label: 'Consultations' },
  { value: 'Save First', label: 'Our Philosophy' },
  { value: 'CBCT',      label: 'Precision Imaging' },
];

const benefits = [
  { title: 'Save First Philosophy',    body: 'When extraction is inevitable, an implant is the best replacement — but we exhaust every option to preserve natural teeth first.' },
  { title: 'Bone Preservation',        body: 'Implants integrate with jawbone and prevent bone loss that occurs after extraction — unlike bridges or dentures.' },
  { title: 'Natural Function',         body: 'A well-placed implant with a quality crown looks, feels, and functions like a natural tooth for most daily activities.' },
  { title: 'Long-Term Investment',     body: 'With proper care, implants can last decades. The upfront cost is higher than a root canal, but the long-term value is strong.' },
];

const steps = [
  { number: '01', title: 'Consultation & Evaluation',  body: 'CBCT imaging to assess bone volume, root anatomy, and overall case complexity before any treatment is planned or recommended.' },
  { number: '02', title: 'Extraction (if needed)',     body: 'Careful extraction designed to preserve the surrounding bone socket, setting the stage for optimal implant placement.' },
  { number: '03', title: 'Implant Placement',          body: 'A titanium post is placed into the jawbone under local anesthesia. Sedation is available for anxious patients.' },
  { number: '04', title: 'Osseointegration',           body: '3–6 months for the implant to fuse with the surrounding bone — creating a stable, long-term foundation for the final crown.' },
  { number: '05', title: 'Crown Placement',            body: 'A custom porcelain or zirconia crown is attached by your general dentist — completing treatment and restoring full function.' },
];

const indications = [
  { title: 'Vertical root fracture',           body: 'An untreatable fracture running the length of the root — saving the tooth is not clinically possible.' },
  { title: 'Severe bone loss',                 body: 'Advanced periodontal disease with insufficient bone support to maintain the tooth long-term.' },
  { title: 'Structural failure',               body: 'Insufficient remaining tooth structure to support a crown after decay or trauma.' },
  { title: 'Failed root canal (non-retreatable)', body: 'When retreatment cannot address the failure cause and the tooth cannot be surgically saved.' },
];

const whyPoints = [
  'Honest prognosis — we tell you if a tooth can be saved, not just what generates revenue',
  'CBCT imaging for precise bone assessment before any recommendation',
  'Coordination with your general dentist or oral surgeon for seamless care',
  'Fellowship-trained endodontists with decades of complex case experience',
];

const faqs = [
  {
    q: 'Are implants better than root canals?',
    a: 'Neither is categorically better. Long-term success rates are comparable. A root canal saves your natural tooth, which has proprioceptive feedback, natural gum architecture, and a smaller treatment footprint. Implants are the right choice when a tooth cannot be saved. Our strong bias is toward saving natural teeth — but when saving a tooth is not clinically reasonable, we say so plainly.',
  },
  {
    q: 'What makes a tooth "unsaveable"?',
    a: 'Vertical root fractures, severe resorption extending into the root, insufficient remaining tooth structure to support a crown, or advanced periodontal bone loss can make a tooth unsalvageable. We use cone-beam CT and the operating microscope to fully evaluate a tooth before recommending extraction. Sometimes a tooth that looks hopeless on a 2D radiograph is more treatable than it appeared.',
  },
  {
    q: 'My dentist said I should pull it and get an implant. Should I get a second opinion?',
    a: 'Yes — and we say that without reservation. Endodontists are trained specifically to evaluate whether a tooth can be saved. A consultation here gives you a definitive answer about treatability before any irreversible decisions are made. If the tooth is not saveable, we will tell you that clearly and help you coordinate next steps.',
  },
  {
    q: 'Can I have an implant placed immediately after extraction?',
    a: "Immediate implant placement is possible in some cases, but not all. It depends on the condition of the bone at the extraction site, the presence or absence of infection, and the patient's overall health. Your general dentist or an oral surgeon will evaluate this after a complete examination.",
  },
];

const related = [
  { label: 'Root Canal Treatment',         href: '/treatments/root-canal-treatment/',         desc: 'Precise endodontic therapy that saves your natural tooth.' },
  { label: 'Root Canal Retreatment',       href: '/treatments/root-canal-retreatment/',       desc: 'Revision of a prior root canal when symptoms return.' },
  { label: 'Apical Surgery / Apicoectomy', href: '/treatments/apical-surgery-apicoectomy/',   desc: 'Microsurgical access to the root tip when retreatment is not possible.' },
  { label: 'Anxiety & Sedation',           href: '/treatments/anxiety-sedation/',             desc: 'Nitrous oxide and oral sedation for anxious patients.' },
];
---

<BaseLayout
  title="Dental Implants in Laguna Hills, CA — Saddleback Valley Endodontics"
  description="Dental implant evaluation and honest save-vs-replace guidance in Laguna Hills and Mission Viejo, CA. CBCT imaging, fellowship-trained endodontists. (949) 581-8890."
>
  <Header variant="solid" />

  <main class="dip-page">

    <!-- HERO -->
    <section class="dip-hero">
      <div class="dip-hero-image">
        <img
          src="/images/Saddleback-Valley-Endodontics-team.webp"
          alt="Saddleback Valley Endodontics team"
        />
        <div class="dip-hero-overlay"></div>
      </div>
      <div class="dip-hero-content">
        <p class="dip-section-eyebrow">Laguna Hills, CA</p>
        <h1 class="dip-hero-title">Dental Implants<br/>in Laguna Hills, CA</h1>
        <p class="dip-hero-sub">Understanding your options — when to save a tooth, and when an implant is the right choice.</p>
        <a href="/request-an-appointment/" class="dip-hero-btn">Request an Appointment</a>
      </div>
      <div class="dip-stats-bar">
        {stats.map((s, i) => (
          <div class="dip-stat" data-reveal data-reveal-delay={String(i + 1)}>
            <span class="dip-stat-value">{s.value}</span>
            <span class="dip-stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- WHAT IS IT -->
    <section class="dip-what">
      <div class="dip-what-inner">
        <div class="dip-what-text" data-reveal="right">
          <p class="dip-section-eyebrow">Dental Implants</p>
          <h2 class="dip-section-title">What is a dental implant?</h2>
          <p class="dip-body-text">A dental implant is a titanium post surgically placed into the jawbone to serve as an artificial tooth root. Once the implant fuses with the bone through a process called osseointegration, a crown is attached — restoring the look, feel, and function of a natural tooth. Implants are the gold standard for replacing a missing tooth.</p>
          <p class="dip-body-text">At Saddleback Valley Endodontics, our philosophy is to save natural teeth first. We exhaust every endodontic option — root canal treatment, retreatment, and apical surgery — before concluding that extraction and implant placement is the best path. When saving the tooth is not clinically reasonable, we say so clearly and help coordinate the next steps with your general dentist or oral surgeon.</p>
          <a href="/request-an-appointment/" class="dip-outline-btn">Request an Appointment</a>
        </div>
        <div class="dip-what-image" data-reveal="left">
          <img
            src="https://images.unsplash.com/photo-1588776814546-1ffbb172bda2?auto=format&fit=crop&w=900&q=80"
            alt="Dental implant model showing titanium post and crown"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- BENEFITS -->
    <section class="dip-benefits">
      <p class="dip-section-eyebrow dip-centered" data-reveal>Why consider an implant?</p>
      <h2 class="dip-section-title dip-centered" data-reveal>Benefits of dental implants.</h2>
      <div class="dip-benefits-grid">
        {benefits.map((b, i) => (
          <div class="dip-benefit-card" data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <div class="dip-benefit-icon" aria-hidden="true"></div>
            <h3 class="dip-benefit-title">{b.title}</h3>
            <p class="dip-benefit-body">{b.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- STEPS -->
    <section class="dip-steps-section">
      <div class="dip-steps-inner">
        <div class="dip-steps-header">
          <p class="dip-section-eyebrow" data-reveal>The Procedure</p>
          <h2 class="dip-section-title" data-reveal>The Implant Process</h2>
          <p class="dip-body-text">From evaluation to final crown, the implant process typically spans several months — each stage carefully sequenced to maximize long-term success.</p>
        </div>
        <div class="dip-steps-list">
          {steps.map(s => (
            <div class="dip-step" data-reveal>
              <div class="dip-step-num">{s.number}</div>
              <div>
                <h3 class="dip-step-title">{s.title}</h3>
                <p class="dip-step-body">{s.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- TECHNOLOGY -->
    <section class="dip-tech">
      <div class="dip-tech-inner">
        <div class="dip-tech-image" data-reveal="left">
          <img
            src="https://images.unsplash.com/photo-1559757148-5c350d0d3c56?auto=format&fit=crop&w=900&q=80"
            alt="CBCT cone-beam CT imaging used for dental implant planning"
            loading="lazy"
          />
        </div>
        <div class="dip-tech-text" data-reveal="right">
          <p class="dip-section-eyebrow">Technology</p>
          <h2 class="dip-section-title">Technology we use for implant planning.</h2>
          <ul class="dip-tech-list">
            <li>
              <strong>Cone-Beam CT (CBCT) Imaging</strong>
              <span>3D volumetric imaging measures bone height, width, and density at the implant site — information a 2D X-ray cannot provide. We use CBCT to evaluate bone before any recommendation is made.</span>
            </li>
            <li>
              <strong>Operating Microscope</strong>
              <span>High-magnification visualization during evaluation reveals root fractures, resorption, and other findings that change the save-vs-replace decision — and are invisible on radiographs.</span>
            </li>
            <li>
              <strong>Digital Radiography</strong>
              <span>Instant, low-dose periapical and panoramic X-rays reviewed chairside at every visit for ongoing monitoring.</span>
            </li>
            <li>
              <strong>Endodontic Specialty Evaluation</strong>
              <span>A full specialist assessment of the tooth — including vitality testing, percussion, and periodontal probing — before any irreversible treatment decision.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- WHEN NEEDED -->
    <section class="dip-when">
      <p class="dip-section-eyebrow dip-centered" data-reveal>Indications</p>
      <h2 class="dip-section-title dip-centered" data-reveal>When an implant may be right.</h2>
      <div class="dip-when-grid">
        {indications.map((s, i) => (
          <div class="dip-when-card" data-reveal data-reveal-delay={String(i + 1)}>
            <h3 class="dip-when-title">{s.title}</h3>
            <p class="dip-when-body">{s.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- WHY CHOOSE US -->
    <section class="dip-why">
      <div class="dip-why-inner">
        <div class="dip-why-image" data-reveal="left">
          <img
            src="/images/Saddleback-Valley-Endodontics.webp"
            alt="Saddleback Valley Endodontics team"
            loading="lazy"
          />
        </div>
        <div class="dip-why-text" data-reveal="right">
          <p class="dip-section-eyebrow">South OC Endodontic Specialists</p>
          <h2 class="dip-section-title">Why choose Saddleback Valley Endodontics for your implant evaluation?</h2>
          <ul class="dip-why-list">
            {whyPoints.map(pt => (
              <li>{pt}</li>
            ))}
          </ul>
          <a href="/request-an-appointment/" class="dip-cta-filled-btn">Request an Appointment</a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="dip-faq">
      <div class="dip-faq-inner">
        <div class="dip-faq-header">
          <p class="dip-section-eyebrow" data-reveal>Frequently Asked Questions</p>
          <h2 class="dip-section-title" data-reveal>Dental implant FAQ.</h2>
        </div>
        <div class="dip-faq-list">
          {faqs.map(f => (
            <details class="dip-faq-item" name="dip-faq" data-reveal>
              <summary class="dip-faq-q">
                <span>{f.q}</span>
                <span class="dip-faq-icon" aria-hidden="true"></span>
              </summary>
              <div class="dip-faq-a"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- RELATED TREATMENTS -->
    <section class="dip-related">
      <p class="dip-section-eyebrow dip-centered" data-reveal>Also in Laguna Hills</p>
      <h2 class="dip-section-title dip-centered" data-reveal>Related endodontic treatments.</h2>
      <div class="dip-related-grid">
        {related.map((r, i) => (
          <a href={r.href} class="dip-related-card" data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <h3 class="dip-related-name">{r.label}</h3>
            <p class="dip-related-desc">{r.desc}</p>
            <span class="dip-related-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <!-- BOTTOM CTA -->
    <section class="dip-bottom-cta">
      <div class="dip-bottom-cta-inner" data-reveal>
        <h2 class="dip-bottom-cta-title">Not sure whether to save or replace?</h2>
        <p class="dip-bottom-cta-body">A consultation with our endodontist gives you a definitive answer before any irreversible decisions. Call <a href="tel:+19495818890">(949) 581-8890</a> or request online.</p>
        <div class="dip-bottom-cta-btns">
          <a href="/request-an-appointment/" class="dip-cta-filled-btn">Request an Appointment</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  .dip-page { padding-top: var(--header-h); }

  /* ── Shared typography utilities ── */
  .dip-section-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 16px;
  }
  .dip-section-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(28px, 4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 24px;
  }
  .dip-body-text {
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.72;
    color: var(--color-ink-soft);
    margin: 0 0 18px;
  }
  .dip-centered { text-align: center; }

  /* ── Buttons ── */
  .dip-hero-btn,
  .dip-cta-filled-btn {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 16px 36px;
    background: var(--color-ink);
    color: var(--color-paper);
    border: 1px solid var(--color-ink);
    transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out);
  }
  .dip-hero-btn:hover,
  .dip-cta-filled-btn:hover {
    background: transparent;
    color: var(--color-ink);
  }
  .dip-outline-btn {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 14px 32px;
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
    transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out);
  }
  .dip-outline-btn:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  /* ── HERO ── */
  .dip-hero {
    position: relative;
    min-height: 520px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .dip-hero-image {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .dip-hero-image img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .dip-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(10,10,10,0.25) 0%, rgba(10,10,10,0.65) 100%);
  }
  .dip-hero-content {
    position: relative;
    padding: clamp(56px, 10vh, 120px) clamp(28px, 6vw, 88px) 48px;
    color: #fff;
    max-width: 800px;
  }
  .dip-hero-content .dip-section-eyebrow { color: rgba(255,255,255,0.65); }
  .dip-hero-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(36px, 5.5vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0 0 18px;
    color: #fff;
  }
  .dip-hero-sub {
    font-size: clamp(15px, 1.4vw, 18px);
    color: rgba(255,255,255,0.82);
    margin: 0 0 32px;
    max-width: 52ch;
    line-height: 1.6;
  }
  .dip-hero-btn { border-color: #fff; background: #fff; color: var(--color-ink); }
  .dip-hero-btn:hover { background: transparent; color: #fff; }

  .dip-stats-bar {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--color-paper);
    border-top: 1px solid var(--color-line);
  }
  .dip-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(20px, 3.5vh, 32px) 16px;
    border-right: 1px solid var(--color-line);
    text-align: center;
  }
  .dip-stat:last-child { border-right: 0; }
  .dip-stat-value {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.5vw, 44px);
    font-weight: 300;
    line-height: 1;
    margin-bottom: 6px;
  }
  .dip-stat-label {
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
  }

  /* ── WHAT IS IT ── */
  .dip-what {
    border-bottom: 1px solid var(--color-line);
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
  }
  .dip-what-inner {
    display: grid;
    grid-template-columns: 1fr 480px;
    gap: clamp(48px, 7vw, 96px);
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }
  .dip-what-image { overflow: hidden; }
  .dip-what-image img { width: 100%; display: block; }

  /* ── BENEFITS ── */
  .dip-benefits {
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
    background: var(--color-paper-warm);
    border-bottom: 1px solid var(--color-line);
  }
  .dip-benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(24px, 4vw, 48px);
    max-width: 1200px;
    margin: 0 auto;
  }
  .dip-benefit-card {
    border-top: 2px solid var(--color-line);
    padding-top: clamp(20px, 3vh, 32px);
  }
  .dip-benefit-icon {
    width: 28px; height: 28px;
    border: 1px solid var(--color-ink);
    border-radius: 50%;
    margin-bottom: 20px;
  }
  .dip-benefit-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(18px, 1.8vw, 22px);
    margin: 0 0 12px;
    line-height: 1.2;
  }
  .dip-benefit-body {
    font-size: clamp(13px, 1.1vw, 15px);
    line-height: 1.65;
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* ── STEPS ── */
  .dip-steps-section {
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
    border-bottom: 1px solid var(--color-line);
  }
  .dip-steps-inner {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: clamp(48px, 7vw, 96px);
    align-items: start;
    max-width: 1200px;
    margin: 0 auto;
  }
  .dip-steps-header {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    align-self: start;
  }
  .dip-steps-list { display: flex; flex-direction: column; }
  .dip-step {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 0 clamp(16px, 3vw, 32px);
    padding: clamp(28px, 4vh, 44px) 0;
    border-bottom: 1px solid var(--color-line);
  }
  .dip-step:first-child { border-top: 1px solid var(--color-line); }
  .dip-step-num {
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 300;
    color: var(--color-ink-soft);
    opacity: 0.3;
    line-height: 1.1;
    padding-top: 2px;
  }
  .dip-step-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.15;
    margin: 0 0 10px;
  }
  .dip-step-body {
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.7;
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* ── TECHNOLOGY ── */
  .dip-tech {
    border-bottom: 1px solid var(--color-line);
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
    background: var(--color-paper-warm);
  }
  .dip-tech-inner {
    display: grid;
    grid-template-columns: 480px 1fr;
    gap: clamp(48px, 7vw, 96px);
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }
  .dip-tech-image { min-height: 520px; }
  .dip-tech-image img { width: 100%; height: 100%; min-height: 520px; object-fit: cover; display: block; }
  .dip-tech-list {
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
  }
  .dip-tech-list li {
    padding: 14px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: clamp(14px, 1.2vw, 16px);
    color: var(--color-ink-soft);
    line-height: 1.55;
  }
  .dip-tech-list li:first-child { border-top: 1px solid var(--color-line); }
  .dip-tech-list li strong { display: block; color: var(--color-ink); font-weight: 500; margin-bottom: 3px; font-size: clamp(13px, 1.1vw, 15px); letter-spacing: 0.04em; }
  .dip-tech-list li span { font-size: clamp(13px, 1.1vw, 15px); }

  /* ── WHEN NEEDED ── */
  .dip-when {
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
    border-bottom: 1px solid var(--color-line);
  }
  .dip-when-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(24px, 4vw, 40px);
    max-width: 1200px;
    margin: 0 auto;
  }
  .dip-when-card {
    background: var(--color-paper-warm);
    border: 1px solid var(--color-line);
    padding: clamp(24px, 3.5vw, 36px);
  }
  .dip-when-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.2;
    margin: 0 0 12px;
  }
  .dip-when-body {
    font-size: clamp(13px, 1.1vw, 15px);
    line-height: 1.65;
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* ── WHY CHOOSE US ── */
  .dip-why {
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
    border-bottom: 1px solid var(--color-line);
  }
  .dip-why-inner {
    display: grid;
