---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const stats = [
  { value: 'N₂O',       label: 'Nitrous Oxide Available' },
  { value: 'Oral',      label: 'Sedation Option' },
  { value: 'Same-Day',  label: 'Urgent Appointments' },
  { value: '100%',      label: 'Judgment-Free Care' },
];

const benefits = [
  { title: 'Nitrous Oxide',              body: 'Mild, fast-acting inhalation sedation that relaxes without putting you to sleep. Wears off in minutes — you can drive yourself home.' },
  { title: 'Oral Sedation',              body: 'A prescribed pill taken before your appointment produces deeper relaxation. You remain conscious but deeply calm. A driver is required.' },
  { title: 'Advanced Local Anesthesia',  body: 'We use buffered anesthetics and precise injection technique to ensure complete numbness before any procedure begins.' },
  { title: 'Judgment-Free Environment',  body: 'Our team treats anxious patients every day. There is no judgment here — only patience, clear communication, and complete control.' },
];

const steps = [
  { number: '01', title: 'Tell us about your anxiety',    body: 'We discuss your concerns, triggers, and history before choosing a sedation approach that fits your needs and medical history.' },
  { number: '02', title: 'Sedation planning',             body: 'We select the right option and provide pre-appointment instructions — fasting requirements, transportation arrangements if needed.' },
  { number: '03', title: 'Arrival & medication',          body: 'Oral sedation is taken before arrival or at the office; nitrous oxide begins at the start of your appointment once you are seated.' },
  { number: '04', title: 'Treatment',                     body: 'You remain comfortable throughout — we check in frequently and stop if you need a break. Nothing happens without your awareness.' },
  { number: '05', title: 'Recovery',                      body: 'Nitrous oxide clears in minutes; oral sedation requires a companion driver and a quiet rest of the day before resuming normal activity.' },
];

const indications = [
  { title: 'History of traumatic dental experiences',    body: 'Past pain, unexpected procedures, or dismissive providers can create lasting anxiety that makes routine care feel impossible.' },
  { title: 'Strong gag reflex',                         body: 'A sensitive gag reflex that makes dental work difficult or impossible without the relaxation that sedation provides.' },
  { title: 'Extreme sensitivity to needles',            body: 'Fear of injections specifically — buffered anesthetics and topical agents can help, as can nitrous oxide before the injection.' },
  { title: 'Difficulty getting numb',                   body: 'Some patients require higher doses or more injections to achieve full anesthesia — sedation makes this process far more manageable.' },
];

const whyPoints = [
  'We treat anxious patients every day — this is not an exception to our practice, it is a core part of it',
  'Multiple sedation levels: nitrous, oral, and expert local anesthesia',
  'We explain every step before we do it — no surprises',
  'Same-day urgent care available even for patients who need sedation',
];

const faqs = [
  {
    q: 'Is nitrous oxide safe?',
    a: 'Yes — nitrous oxide has been used in dentistry for over 150 years and has an excellent safety record. It is titrated to your comfort level and reverses within minutes when the mask is removed. There are no lasting effects.',
  },
  {
    q: 'Can I eat before oral sedation?',
    a: 'For oral sedation, we typically ask patients to avoid food and drink for several hours beforehand. We provide specific instructions at the time of prescribing based on the medication chosen.',
  },
  {
    q: 'Will I be unconscious?',
    a: 'No. Both nitrous oxide and oral sedation produce conscious sedation — you remain awake and able to respond, but feel deeply relaxed and often have little memory of the procedure.',
  },
  {
    q: 'Do I need a driver for nitrous oxide?',
    a: 'No — nitrous oxide wears off within minutes of removing the mask, and you can drive yourself home. Oral sedation does require a driver for the day of your appointment.',
  },
];

const related = [
  { label: 'Root Canal Treatment',         href: '/treatments/root-canal-treatment/',         desc: 'Precise, comfortable endodontic therapy that saves your natural tooth.' },
  { label: 'Root Canal Retreatment',       href: '/treatments/root-canal-retreatment/',       desc: 'Revision of a prior root canal when symptoms return.' },
  { label: 'Apical Surgery / Apicoectomy', href: '/treatments/apical-surgery-apicoectomy/',   desc: 'Microsurgical access to the root tip when retreatment is not possible.' },
  { label: 'Dental Implants',              href: '/treatments/dental-implant/',               desc: 'An honest evaluation — when to save a tooth and when to replace it.' },
];
---

<BaseLayout
  title="Anxiety & Sedation in Laguna Hills, CA — Saddleback Valley Endodontics"
  description="Nitrous oxide and oral sedation for anxious patients in Laguna Hills and Mission Viejo, CA. Judgment-free, comfortable endodontic care. (949) 581-8890."
>
  <Header variant="solid" />

  <main class="sed-page">

    <!-- HERO -->
    <section class="sed-hero">
      <div class="sed-hero-image">
        <img
          src="/images/Saddleback-Valley-Endodontics-team.webp"
          alt="Saddleback Valley Endodontics team"
        />
        <div class="sed-hero-overlay"></div>
      </div>
      <div class="sed-hero-content">
        <p class="sed-section-eyebrow">Laguna Hills, CA</p>
        <h1 class="sed-hero-title">Comfortable Care<br/>for Anxious Patients</h1>
        <p class="sed-hero-sub">Nitrous oxide, oral sedation, and expert local anesthesia — so dental anxiety doesn't delay needed care.</p>
        <a href="/request-an-appointment/" class="sed-hero-btn">Request an Appointment</a>
      </div>
      <div class="sed-stats-bar">
        {stats.map((s, i) => (
          <div class="sed-stat" data-reveal data-reveal-delay={String(i + 1)}>
            <span class="sed-stat-value">{s.value}</span>
            <span class="sed-stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- WHAT IS IT -->
    <section class="sed-what">
      <div class="sed-what-inner">
        <div class="sed-what-text" data-reveal="right">
          <p class="sed-section-eyebrow">Anxiety & Sedation</p>
          <h2 class="sed-section-title">You don't have to be afraid.</h2>
          <p class="sed-body-text">Dental anxiety is extremely common — and nothing to be ashamed of. Whether your anxiety stems from past experiences, fear of needles, or simply the sounds and sensations of dental care, we offer multiple levels of sedation tailored to your needs. Our team is trained specifically to treat anxious patients with patience, clear communication, and complete respect for your pace.</p>
          <p class="sed-body-text">From mild relaxation with nitrous oxide to deeper comfort with oral sedation, we work with you before the appointment to choose the right approach. Nothing happens without your knowledge and agreement. You remain in control throughout.</p>
          <a href="/request-an-appointment/" class="sed-outline-btn">Request an Appointment</a>
        </div>
        <div class="sed-what-image" data-reveal="left">
          <img
            src="https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=900&q=80"
            alt="Relaxed patient receiving comfortable care at Saddleback Valley Endodontics"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- BENEFITS -->
    <section class="sed-benefits">
      <p class="sed-section-eyebrow sed-centered" data-reveal>Sedation options we offer</p>
      <h2 class="sed-section-title sed-centered" data-reveal>Multiple levels of comfort.</h2>
      <div class="sed-benefits-grid">
        {benefits.map((b, i) => (
          <div class="sed-benefit-card" data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <div class="sed-benefit-icon" aria-hidden="true"></div>
            <h3 class="sed-benefit-title">{b.title}</h3>
            <p class="sed-benefit-body">{b.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- STEPS -->
    <section class="sed-steps-section">
      <div class="sed-steps-inner">
        <div class="sed-steps-header">
          <p class="sed-section-eyebrow" data-reveal>The Process</p>
          <h2 class="sed-section-title" data-reveal>What to expect at your visit.</h2>
          <p class="sed-body-text">Every step is explained before it happens. We don't rush, we don't pressure, and we adjust our pace to yours throughout.</p>
        </div>
        <div class="sed-steps-list">
          {steps.map(s => (
            <div class="sed-step" data-reveal>
              <div class="sed-step-num">{s.number}</div>
              <div>
                <h3 class="sed-step-title">{s.title}</h3>
                <p class="sed-step-body">{s.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- TECHNOLOGY -->
    <section class="sed-tech">
      <div class="sed-tech-inner">
        <div class="sed-tech-image" data-reveal="left">
          <img
            src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=900&q=80"
            alt="Operating microscope and advanced technology used at Saddleback Valley Endodontics"
            loading="lazy"
          />
        </div>
        <div class="sed-tech-text" data-reveal="right">
          <p class="sed-section-eyebrow">Technology</p>
          <h2 class="sed-section-title">Technology that makes treatment faster and more comfortable.</h2>
          <ul class="sed-tech-list">
            <li>
              <strong>Operating Microscope (4×–25×)</strong>
              <span>Precision magnification means less time in the chair — we work more efficiently and make fewer passes, reducing overall treatment time and discomfort.</span>
            </li>
            <li>
              <strong>Cone-Beam CT Imaging</strong>
              <span>3D pre-treatment planning eliminates surprises during the procedure, reducing the chance of unexpected steps that increase anxiety or extend appointment length.</span>
            </li>
            <li>
              <strong>Buffered Local Anesthetics</strong>
              <span>pH-neutral anesthetic formulations reduce the stinging sensation of injection and take effect faster — a meaningful difference for patients who fear needles.</span>
            </li>
            <li>
              <strong>Digital Radiography</strong>
              <span>Instant, low-dose images reviewed chairside eliminate the need for repeated trips to the X-ray room, keeping your appointment streamlined.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- WHEN NEEDED -->
    <section class="sed-when">
      <p class="sed-section-eyebrow sed-centered" data-reveal>Indications</p>
      <h2 class="sed-section-title sed-centered" data-reveal>Signs you may benefit from sedation.</h2>
      <div class="sed-when-grid">
        {indications.map((s, i) => (
          <div class="sed-when-card" data-reveal data-reveal-delay={String(i + 1)}>
            <h3 class="sed-when-title">{s.title}</h3>
            <p class="sed-when-body">{s.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- WHY CHOOSE US -->
    <section class="sed-why">
      <div class="sed-why-inner">
        <div class="sed-why-image" data-reveal="left">
          <img
            src="/images/Saddleback-Valley-Endodontics.webp"
            alt="Saddleback Valley Endodontics team"
            loading="lazy"
          />
        </div>
        <div class="sed-why-text" data-reveal="right">
          <p class="sed-section-eyebrow">South OC · Judgment-Free Care</p>
          <h2 class="sed-section-title">Why patients trust us for anxious care.</h2>
          <ul class="sed-why-list">
            {whyPoints.map(pt => (
              <li>{pt}</li>
            ))}
          </ul>
          <a href="/request-an-appointment/" class="sed-cta-filled-btn">Request an Appointment</a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="sed-faq">
      <div class="sed-faq-inner">
        <div class="sed-faq-header">
          <p class="sed-section-eyebrow" data-reveal>Frequently Asked Questions</p>
          <h2 class="sed-section-title" data-reveal>Sedation FAQ.</h2>
        </div>
        <div class="sed-faq-list">
          {faqs.map(f => (
            <details class="sed-faq-item" name="sed-faq" data-reveal>
              <summary class="sed-faq-q">
                <span>{f.q}</span>
                <span class="sed-faq-icon" aria-hidden="true"></span>
              </summary>
              <div class="sed-faq-a"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- RELATED TREATMENTS -->
    <section class="sed-related">
      <p class="sed-section-eyebrow sed-centered" data-reveal>Also in Laguna Hills</p>
      <h2 class="sed-section-title sed-centered" data-reveal>Related endodontic treatments.</h2>
      <div class="sed-related-grid">
        {related.map((r, i) => (
          <a href={r.href} class="sed-related-card" data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <h3 class="sed-related-name">{r.label}</h3>
            <p class="sed-related-desc">{r.desc}</p>
            <span class="sed-related-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <!-- BOTTOM CTA -->
    <section class="sed-bottom-cta">
      <div class="sed-bottom-cta-inner" data-reveal>
        <h2 class="sed-bottom-cta-title">Ready for a comfortable visit?</h2>
        <p class="sed-bottom-cta-body">Call <a href="tel:+19495818890">(949) 581-8890</a> and mention you'd like sedation. We'll walk you through your options before your appointment.</p>
        <div class="sed-bottom-cta-btns">
          <a href="/request-an-appointment/" class="sed-cta-filled-btn">Request an Appointment</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  .sed-page { padding-top: var(--header-h); }

  /* ── Shared typography utilities ── */
  .sed-section-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 16px;
  }
  .sed-section-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(28px, 4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 24px;
  }
  .sed-body-text {
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.72;
    color: var(--color-ink-soft);
    margin: 0 0 18px;
  }
  .sed-centered { text-align: center; }

  /* ── Buttons ── */
  .sed-hero-btn,
  .sed-cta-filled-btn {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 16px 36px;
    background: var(--color-ink);
    color: var(--color-paper);
    border: 1px solid var(--color-ink);
    transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out);
  }
  .sed-hero-btn:hover,
  .sed-cta-filled-btn:hover {
    background: transparent;
    color: var(--color-ink);
  }
  .sed-outline-btn {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 14px 32px;
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
    transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out);
  }
  .sed-outline-btn:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  /* ── HERO ── */
  .sed-hero {
    position: relative;
    min-height: 520px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .sed-hero-image {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .sed-hero-image img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .sed-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(10,10,10,0.25) 0%, rgba(10,10,10,0.65) 100%);
  }
  .sed-hero-content {
    position: relative;
    padding: clamp(56px, 10vh, 120px) clamp(28px, 6vw, 88px) 48px;
    color: #fff;
    max-width: 800px;
  }
  .sed-hero-content .sed-section-eyebrow { color: rgba(255,255,255,0.65); }
  .sed-hero-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(36px, 5.5vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0 0 18px;
    color: #fff;
  }
  .sed-hero-sub {
    font-size: clamp(15px, 1.4vw, 18px);
    color: rgba(255,255,255,0.82);
    margin: 0 0 32px;
    max-width: 52ch;
    line-height: 1.6;
  }
  .sed-hero-btn { border-color: #fff; background: #fff; color: var(--color-ink); }
  .sed-hero-btn:hover { background: transparent; color: #fff; }

  .sed-stats-bar {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--color-paper);
    border-top: 1px solid var(--color-line);
  }
  .sed-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(20px, 3.5vh, 32px) 16px;
    border-right: 1px solid var(--color-line);
    text-align: center;
  }
  .sed-stat:last-child { border-right: 0; }
  .sed-stat-value {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.5vw, 44px);
    font-weight: 300;
    line-height: 1;
    margin-bottom: 6px;
  }
  .sed-stat-label {
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
  }

  /* ── WHAT IS IT ── */
  .sed-what {
    border-bottom: 1px solid var(--color-line);
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
  }
  .sed-what-inner {
    display: grid;
    grid-template-columns: 1fr 480px;
    gap: clamp(48px, 7vw, 96px);
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }
  .sed-what-image { overflow: hidden; }
  .sed-what-image img { width: 100%; display: block; }

  /* ── BENEFITS ── */
  .sed-benefits {
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
    background: var(--color-paper-warm);
    border-bottom: 1px solid var(--color-line);
  }
  .sed-benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(24px, 4vw, 48px);
    max-width: 1200px;
    margin: 0 auto;
  }
  .sed-benefit-card {
    border-top: 2px solid var(--color-line);
    padding-top: clamp(20px, 3vh, 32px);
  }
  .sed-benefit-icon {
    width: 28px; height: 28px;
    border: 1px solid var(--color-ink);
    border-radius: 50%;
    margin-bottom: 20px;
  }
  .sed-benefit-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(18px, 1.8vw, 22px);
    margin: 0 0 12px;
    line-height: 1.2;
  }
  .sed-benefit-body {
    font-size: clamp(13px, 1.1vw, 15px);
    line-height: 1.65;
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* ── STEPS ── */
  .sed-steps-section {
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
    border-bottom: 1px solid var(--color-line);
  }
  .sed-steps-inner {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: clamp(48px, 7vw, 96px);
    align-items: start;
    max-width: 1200px;
    margin: 0 auto;
  }
  .sed-steps-header {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    align-self: start;
  }
  .sed-steps-list { display: flex; flex-direction: column; }
  .sed-step {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 0 clamp(16px, 3vw, 32px);
    padding: clamp(28px, 4vh, 44px) 0;
    border-bottom: 1px solid var(--color-line);
  }
  .sed-step:first-child { border-top: 1px solid var(--color-line); }
  .sed-step-num {
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 300;
    color: var(--color-ink-soft);
    opacity: 0.3;
    line-height: 1.1;
    padding-top: 2px;
  }
  .sed-step-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.15;
    margin: 0 0 10px;
  }
  .sed-step-body {
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.7;
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* ── TECHNOLOGY ── */
  .sed-tech {
    border-bottom: 1px solid var(--color-line);
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
    background: var(--color-paper-warm);
  }
  .sed-tech-inner {
    display: grid;
    grid-template-columns: 480px 1fr;
    gap: clamp(48px, 7vw, 96px);
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }
  .sed-tech-image { min-height: 520px; }
  .sed-tech-image img { width: 100%; height: 100%; min-height: 520px; object-fit: cover; display: block; }
  .sed-tech-list {
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
  }
  .sed-tech-list li {
    padding: 14px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: clamp(14px, 1.2vw, 16px);
    color: var(--color-ink-soft);
    line-height: 1.55;
  }
  .sed-tech-list li:first-child { border-top: 1px solid var(--color-line); }
  .sed-tech-list li strong { display: block; color: var(--color-ink); font-weight: 500; margin-bottom: 3px; font-size: clamp(13px, 1.1vw, 15px); letter-spacing: 0.04em; }
  .sed-tech-list li span { font-size: clamp(13px, 1.1vw, 15px); }

  /* ── WHEN NEEDED ── */
  .sed-when {
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
    border-bottom: 1px solid var(--color-line);
  }
  .sed-when-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(24px, 4vw, 40px);
    max-width: 1200px;
    margin: 0 auto;
  }
  .sed-when-card {
    background: var(--color-paper-warm);
    border: 1px solid var(--color-line);
    padding: clamp(24px, 3.5vw, 36px);
  }
  .sed-when-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.2;
    margin: 0 0 12px;
  }
  .sed-when-body {
    font-size: clamp(13px, 1.1vw, 15px);
    line-height: 1.65;
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* ── WHY CHOOSE US ── */
  .sed-why {
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
    border-bottom: 1px solid var(--color-line);
  }
  .sed-why-inner {
    display: grid;
    grid-template-columns: 480px 1fr;
    gap: clamp(48px, 7vw, 96px);
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }
  .sed-why-image { min-height: 560px; }
  .sed-why-image img { width: 100%; height: 100%; min-height: 560px; object-fit: cover; display: block; }
  .sed-why-list {
