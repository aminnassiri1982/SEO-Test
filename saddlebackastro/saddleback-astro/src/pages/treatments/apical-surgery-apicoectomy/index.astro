---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const stats = [
  { value: '92%+',   label: 'Microsurgical Success Rate' },
  { value: 'Micro',  label: 'Microsurgical Technique' },
  { value: 'Same-Day', label: 'Urgent Appointments' },
  { value: '~1 wk',  label: 'Typical Recovery' },
];

const benefits = [
  { icon: '', title: 'Direct Access', body: 'Surgery provides direct access to the root tip when the canal cannot be adequately retreated from above — bypassing posts, calcifications, or restorations that block non-surgical access.' },
  { icon: '', title: 'MTA Root-End Fill', body: 'Mineral trioxide aggregate (MTA) is placed under microscopic vision to create a biocompatible, hermetic seal at the resected root end — the gold standard material for apical surgery.' },
  { icon: '', title: 'Microsurgical Precision', body: 'Microsurgical instruments, ultrasonic preparation tips, and operating microscope magnification allow tissue-sparing incisions and precise root-end preparation that older techniques could not achieve.' },
  { icon: '', title: 'Definitive Treatment', body: 'When retreatment is not possible or has already failed, apical surgery provides a definitive solution that resolves infection and allows the periapical lesion to heal.' },
];

const steps = [
  { number: '01', title: 'Anesthesia & Preparation', body: 'Local anesthesia with a vasoconstrictor is administered for profound numbness and a near-bloodless surgical field. Sedation is available for anxious patients. Pre-operative imaging — including CBCT — is reviewed.' },
  { number: '02', title: 'Tissue Reflection', body: 'A tissue-sparing microsurgical incision is made and the mucoperiosteal flap is gently reflected to expose the bone overlying the root tip, preserving blood supply and minimizing post-operative swelling.' },
  { number: '03', title: 'Bone Window & Root Resection', body: 'A small window is made in the bone to access the root apex. The root tip is resected at a 90-degree angle — removing infected tissue, the apical 3 mm of root, and any associated lesion — under operating microscope magnification.' },
  { number: '04', title: 'Root-End Preparation & MTA Fill', body: 'An ultrasonic tip prepares a retrocavity in the resected root end. The cavity is dried and filled with MTA under high magnification, creating a sealed, biocompatible apical barrier that promotes healing.' },
  { number: '05', title: 'Closure & Follow-Up', body: 'The flap is repositioned and sutured with microsurgical technique. Sutures are typically removed within one week. A follow-up radiograph at 6–12 months confirms periapical healing.' },
];

const symptoms = [
  { title: 'Persistent infection after root canal', body: 'A tooth with an existing root canal that has a persistent periapical lesion — visible on X-ray or CBCT — that has not resolved despite adequate non-surgical treatment.' },
  { title: 'Non-negotiable calcification', body: 'Complete calcification of the root canal system that prevents non-surgical access to the apex, making retreatment impossible but surgery feasible from the outside.' },
  { title: 'Separated instrument at the apex', body: 'A fractured file lodged near the root tip that cannot be removed non-surgically but is contributing to persistent disease or preventing adequate canal sealing.' },
  { title: 'Post or restoration blocks retreatment', body: 'A large post, cast restoration, or complex prosthetic crown that cannot be safely removed for retreatment — making the surgical approach the least destructive option.' },
];

const faqs = [
  { q: 'Is apicoectomy the same as retreatment?', a: 'No. Retreatment approaches the root canal from the crown downward, removing old fill and reinstrumenting the canals. Apical surgery accesses the root tip directly through the gum and bone, resecting the apex and sealing it from below. Surgery is indicated when retreatment is not possible or has already been attempted.' },
  { q: 'What is the success rate for apical surgery?', a: 'Modern microsurgical apicoectomy using MTA has published success rates above 92% — significantly higher than older surgical techniques. Key factors include microsurgical incision design, ultrasonic root-end preparation, and MTA fill, all of which we use routinely.' },
  { q: 'What is recovery like after apical surgery?', a: 'Most patients experience swelling and mild-to-moderate discomfort for 2–5 days, managed with ibuprofen and ice. Sutures are removed at one week. Most patients return to normal activity within 24–48 hours. We provide detailed post-operative instructions and are available by phone throughout recovery.' },
  { q: 'Is the procedure painful?', a: 'The procedure is performed under local anesthesia — the area is profoundly numb before any surgery begins. Most patients feel pressure and movement but no pain. Sedation is available for anxious patients. Post-operative discomfort is typically managed with over-the-counter analgesics.' },
];

const related = [
  { label: 'Root Canal Retreatment', href: '/treatments/root-canal-retreatment/', desc: 'Non-surgical revision of a failed prior root canal.' },
  { label: 'Root Canal Treatment', href: '/treatments/root-canal-treatment/', desc: 'First-time endodontic treatment for infected pulp.' },
  { label: 'Our Technology', href: '/treatments/technology/', desc: 'CBCT, microscope, and instruments used in surgery.' },
  { label: 'Anxiety & Sedation', href: '/treatments/anxiety-sedation/', desc: 'Sedation options available for surgical procedures.' },
];
---

<BaseLayout
  title="Apical Surgery (Apicoectomy) in Laguna Hills, CA — Saddleback Valley Endodontics"
  description="Microsurgical apicoectomy in Laguna Hills and Mission Viejo, CA. MTA root-end fill, operating microscope, CBCT planning. Call (949) 581-8890."
>
  <Header variant="solid" />

  <main class="aps-page">

    <!-- HERO -->
    <section class="aps-hero">
      <div class="aps-hero-image">
        <img
          src="https://images.unsplash.com/photo-1588776814546-1ffbb172bda2?auto=format&fit=crop&w=1600&q=80"
          alt="Endodontist preparing for microsurgical apicoectomy at Saddleback Valley Endodontics"
        />
        <div class="aps-hero-overlay"></div>
      </div>
      <div class="aps-hero-content">
        <p class="aps-section-eyebrow">Laguna Hills, CA</p>
        <h1 class="aps-hero-title">Apical Surgery &amp; Apicoectomy<br/>in Laguna Hills, CA</h1>
        <p class="aps-hero-sub">Microsurgical access to the root tip — when retreatment cannot resolve the problem.</p>
        <a href="/request-an-appointment/" class="aps-hero-btn">Request an Appointment</a>
      </div>
      <div class="aps-stats-bar">
        {stats.map((s, i) => (
          <div class="aps-stat" data-reveal data-reveal-delay={String(i + 1)}>
            <span class="aps-stat-value">{s.value}</span>
            <span class="aps-stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- WHAT IS IT -->
    <section class="aps-what">
      <div class="aps-what-inner">
        <div class="aps-what-text" data-reveal="right">
          <p class="aps-section-eyebrow">Apical Surgery</p>
          <h2 class="aps-section-title">What is an apicoectomy?</h2>
          <p class="aps-body-text">An apicoectomy — also called apical surgery or root-end surgery — is a minor surgical procedure that accesses the root tip of a tooth through a small incision in the gum. The infected root tip is removed, and the end of the root canal is sealed with a biocompatible material to prevent reinfection and allow healing.</p>
          <p class="aps-body-text">Modern microsurgical technique — using the operating microscope, ultrasonic instruments, and MTA — has transformed apicoectomy from a rough procedure into a precise, predictable treatment with published success rates above 92%. For teeth that cannot be treated non-surgically, it is often the best way to save the natural tooth.</p>
          <a href="/request-an-appointment/" class="aps-outline-btn">Request an Appointment</a>
        </div>
        <div class="aps-what-image" data-reveal="left">
          <img
            src="https://images.unsplash.com/photo-1607990281513-2c110a25bd8c?auto=format&fit=crop&w=900&q=80"
            alt="Microsurgical instruments used in apicoectomy procedure"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- BENEFITS -->
    <section class="aps-benefits">
      <p class="aps-section-eyebrow aps-centered" data-reveal>Why choose microsurgical apicoectomy?</p>
      <h2 class="aps-section-title aps-centered" data-reveal>Benefits of apical surgery.</h2>
      <div class="aps-benefits-grid">
        {benefits.map((b, i) => (
          <div class="aps-benefit-card" data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <div class="aps-benefit-icon" aria-hidden="true"></div>
            <h3 class="aps-benefit-title">{b.title}</h3>
            <p class="aps-benefit-body">{b.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- STEPS -->
    <section class="aps-steps-section">
      <div class="aps-steps-inner">
        <div class="aps-steps-header">
          <p class="aps-section-eyebrow" data-reveal>The Procedure</p>
          <h2 class="aps-section-title" data-reveal>Our step-by-step<br/>surgical process.</h2>
          <p class="aps-body-text">Each surgical appointment follows the same careful sequence — precise, tissue-sparing, and performed entirely under microscope magnification.</p>
        </div>
        <div class="aps-steps-list">
          {steps.map(s => (
            <div class="aps-step" data-reveal>
              <div class="aps-step-num">{s.number}</div>
              <div>
                <h3 class="aps-step-title">{s.title}</h3>
                <p class="aps-step-body">{s.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- TECHNOLOGY -->
    <section class="aps-tech">
      <div class="aps-tech-inner">
        <div class="aps-tech-image" data-reveal="left">
          <img
            src="https://images.unsplash.com/photo-1559757148-5c350d0d3c56?auto=format&fit=crop&w=900&q=80"
            alt="CBCT and microscope technology used in apical surgery planning"
            loading="lazy"
          />
        </div>
        <div class="aps-tech-text" data-reveal="right">
          <p class="aps-section-eyebrow">Technology</p>
          <h2 class="aps-section-title">Microsurgical technology<br/>that changes outcomes.</h2>
          <ul class="aps-tech-list">
            <li>
              <strong>Operating Microscope (4×–25×)</strong>
              <span>Transforms apicoectomy from approximate surgery into precise microsurgery — every incision, resection, and fill is performed under direct, high-magnification vision.</span>
            </li>
            <li>
              <strong>Cone-Beam CT Pre-operative Planning</strong>
              <span>3D imaging maps root anatomy, lesion size, proximity to nerves and sinuses, and cortical plate thickness before a single incision is made.</span>
            </li>
            <li>
              <strong>Ultrasonic Retrotip Preparation</strong>
              <span>Ultrasonic instruments prepare a precise retrocavity in the resected root end — aligned with the canal axis regardless of bone access angle.</span>
            </li>
            <li>
              <strong>MTA Root-End Fill</strong>
              <span>Mineral trioxide aggregate provides a biocompatible, moisture-tolerant seal that promotes cementum and bone regeneration — the current evidence-based standard.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- WHEN NEEDED -->
    <section class="aps-when">
      <p class="aps-section-eyebrow aps-centered" data-reveal>Indications</p>
      <h2 class="aps-section-title aps-centered" data-reveal>When apical surgery is indicated.</h2>
      <div class="aps-when-grid">
        {symptoms.map((s, i) => (
          <div class="aps-when-card" data-reveal data-reveal-delay={String(i + 1)}>
            <h3 class="aps-when-title">{s.title}</h3>
            <p class="aps-when-body">{s.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- WHY CHOOSE US -->
    <section class="aps-why">
      <div class="aps-why-inner">
        <div class="aps-why-image" data-reveal="left">
          <img
            src="/images/Saddleback-Valley-Endodontics.webp"
            alt="Saddleback Valley Endodontics microsurgical specialist team"
            loading="lazy"
          />
        </div>
        <div class="aps-why-text" data-reveal="right">
          <p class="aps-section-eyebrow">South OC Microsurgical Specialist</p>
          <h2 class="aps-section-title">Why choose us for apical surgery in Laguna Hills?</h2>
          <ul class="aps-why-list">
            <li><strong>Microsurgical technique.</strong> We use tissue-sparing incision design, microsurgical instruments, and operating microscope magnification throughout — not just for the difficult parts. This reduces swelling, speeds healing, and improves outcomes.</li>
            <li><strong>MTA material standard.</strong> Every root-end fill uses MTA — the current evidence-based material standard — placed under high magnification for a complete, void-free seal.</li>
            <li><strong>CBCT surgical planning.</strong> We review 3D cone-beam CT imaging before every surgical case to map anatomy and avoid complications — not just for cases that look complex on a 2D film.</li>
            <li><strong>Expert surgical team.</strong> Apical surgery is a core endodontic specialty procedure. Our training and case volume mean fewer surprises and better outcomes for patients referred for surgery.</li>
          </ul>
          <a href="/request-an-appointment/" class="aps-cta-filled-btn">Request an Appointment</a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="aps-faq">
      <div class="aps-faq-inner">
        <div class="aps-faq-header">
          <p class="aps-section-eyebrow" data-reveal>Frequently Asked Questions</p>
          <h2 class="aps-section-title" data-reveal>Apical surgery FAQ.</h2>
        </div>
        <div class="aps-faq-list">
          {faqs.map(f => (
            <details class="aps-faq-item" name="aps-faq" data-reveal>
              <summary class="aps-faq-q">
                <span>{f.q}</span>
                <span class="aps-faq-icon" aria-hidden="true"></span>
              </summary>
              <div class="aps-faq-a"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- APPOINTMENT FORM -->
    <section class="aps-form-section">
      <div class="aps-form-inner">
        <div class="aps-form-text">
          <p class="aps-section-eyebrow">Schedule Today</p>
          <h2 class="aps-section-title">Request your apical surgery consultation in Laguna Hills, CA.</h2>
          <ul class="aps-form-details">
            <li><span class="aps-form-label">Phone</span><a href="tel:+19495818890">(949) 581-8890</a></li>
            <li><span class="aps-form-label">Address</span><span><a href="https://maps.app.goo.gl/x2rcKTvkHVg4LKfw8" target="_blank" rel="noopener noreferrer">25261 Paseo De Valencia, Suite 3<br/>Laguna Hills, CA 92637</a></span></li>
            <li><span class="aps-form-label">Hours</span><span>Mon–Thu 8 am–5 pm · Fri 8 am–2 pm</span></li>
          </ul>
        </div>
        <form class="aps-form" name="aps-appointment" netlify data-netlify="true" action="/contact/thank-you/">
          <input type="hidden" name="form-name" value="aps-appointment" />
          <div class="aps-form-row aps-form-row--two">
            <div class="aps-form-field">
              <label for="aps_first">First name</label>
              <input type="text" id="aps_first" name="firstName" autocomplete="given-name" required />
            </div>
            <div class="aps-form-field">
              <label for="aps_last">Last name</label>
              <input type="text" id="aps_last" name="lastName" autocomplete="family-name" required />
            </div>
          </div>
          <div class="aps-form-row aps-form-row--two">
            <div class="aps-form-field">
              <label for="aps_email">Email</label>
              <input type="email" id="aps_email" name="email" autocomplete="email" required />
            </div>
            <div class="aps-form-field">
              <label for="aps_phone">Phone</label>
              <input type="tel" id="aps_phone" name="phone" autocomplete="tel" />
            </div>
          </div>
          <div class="aps-form-row">
            <div class="aps-form-field">
              <label for="aps_reason">Reason for visit</label>
              <select id="aps_reason" name="reason" required>
                <option value="" disabled selected>Select one…</option>
                <option value="apical-surgery">Apical surgery / apicoectomy</option>
                <option value="second-opinion">Second opinion</option>
                <option value="emergency">Dental emergency</option>
                <option value="other">Other</option>
              </select>
            </div>
          </div>
          <button type="submit" class="aps-form-submit">Submit Request</button>
        </form>
      </div>
    </section>

    <!-- RELATED TREATMENTS -->
    <section class="aps-related">
      <p class="aps-section-eyebrow aps-centered" data-reveal>Also in Laguna Hills</p>
      <h2 class="aps-section-title aps-centered" data-reveal>Related endodontic treatments.</h2>
      <div class="aps-related-grid">
        {related.map((r, i) => (
          <a href={r.href} class="aps-related-card" data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <h3 class="aps-related-name">{r.label}</h3>
            <p class="aps-related-desc">{r.desc}</p>
            <span class="aps-related-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <!-- BOTTOM CTA -->
    <section class="aps-bottom-cta">
      <div class="aps-bottom-cta-inner" data-reveal>
        <h2 class="aps-bottom-cta-title">Persistent infection doesn't have to mean extraction.</h2>
        <p class="aps-bottom-cta-body">Call <a href="tel:+19495818890">(949) 581-8890</a> or request a consultation online. Microsurgical apicoectomy may save your tooth.</p>
        <div class="aps-bottom-cta-btns">
          <a href="/request-an-appointment/" class="aps-cta-filled-btn">Request an Appointment</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  .aps-page { padding-top: var(--header-h); }

  .aps-section-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 16px;
  }
  .aps-section-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(28px, 4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 24px;
  }
  .aps-body-text {
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.72;
    color: var(--color-ink-soft);
    margin: 0 0 18px;
  }
  .aps-centered { text-align: center; }

  .aps-hero-btn,
  .aps-cta-filled-btn {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 16px 36px;
    background: var(--color-ink);
    color: var(--color-paper);
    border: 1px solid var(--color-ink);
    transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out);
  }
  .aps-hero-btn:hover,
  .aps-cta-filled-btn:hover {
    background: transparent;
    color: var(--color-ink);
  }
  .aps-outline-btn {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 14px 32px;
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
    transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out);
  }
  .aps-outline-btn:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .aps-hero {
    position: relative;
    min-height: 520px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .aps-hero-image { position: absolute; inset: 0; overflow: hidden; }
  .aps-hero-image img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .aps-hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, rgba(10,10,10,0.25) 0%, rgba(10,10,10,0.65) 100%);
  }
  .aps-hero-content {
    position: relative;
    padding: clamp(56px, 10vh, 120px) clamp(28px, 6vw, 88px) 48px;
    color: #fff;
    max-width: 800px;
  }
  .aps-hero-content .aps-section-eyebrow { color: rgba(255,255,255,0.65); }
  .aps-hero-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(36px, 5.5vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0 0 18px;
    color: #fff;
  }
  .aps-hero-sub {
    font-size: clamp(15px, 1.4vw, 18px);
    color: rgba(255,255,255,0.82);
    margin: 0 0 32px;
    max-width: 52ch;
    line-height: 1.6;
  }
  .aps-hero-btn { border-color: #fff; background: #fff; color: var(--color-ink); }
  .aps-hero-btn:hover { background: transparent; color: #fff; }

  .aps-stats-bar {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--color-paper);
    border-top: 1px solid var(--color-line);
  }
  .aps-stat {
    display: flex; flex-direction: column; align-items: center;
    padding: clamp(20px, 3.5vh, 32px) 16px;
    border-right: 1px solid var(--color-line);
    text-align: center;
  }
  .aps-stat:last-child { border-right: 0; }
  .aps-stat-value {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.5vw, 44px);
    font-weight: 300;
    line-height: 1;
    margin-bottom: 6px;
  }
  .aps-stat-label {
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
  }

  .aps-what {
    border-bottom: 1px solid var(--color-line);
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
  }
  .aps-what-inner {
    display: grid;
    grid-template-columns: 1fr 480px;
    gap: clamp(48px, 7vw, 96px);
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }
  .aps-what-image { overflow: hidden; }
  .aps-what-image img { width: 100%; display: block; }

  .aps-benefits {
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
    background: var(--color-paper-warm);
    border-bottom: 1px solid var(--color-line);
  }
  .aps-benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(24px, 4vw, 48px);
    margin-top: clamp(40px, 6vh, 64px);
    max-width: 1200px;
    margin: 0 auto;
    margin-left: auto;
    margin-right: auto;
  }
  .aps-benefit-card { border-top: 2px solid var(--color-line); padding-top: clamp(20px, 3vh, 32px); }
  .aps-benefit-icon { width: 28px; height: 28px; border: 1px solid var(--color-ink); border-radius: 50%; margin-bottom: 20px; }
  .aps-benefit-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(18px, 1.8vw, 22px);
    margin: 0 0 12px;
    line-height: 1.2;
  }
  .aps-benefit-body { font-size: clamp(13px, 1.1vw, 15px); line-height: 1.65; color: var(--color-ink-soft); margin: 0; }

  .aps-steps-section {
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
    border-bottom: 1px solid var(--color-line);
  }
  .aps-steps-inner {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: clamp(48px, 7vw, 96px);
    align-items: start;
    max-width: 1200px;
    margin: 0 auto;
  }
  .aps-steps-header { position: sticky; top: calc(var(--header-h) + 32px);   align-self: start;
}
  align-self: start;
  .aps-steps-list { display: flex; flex-direction: column; }
  .aps-step {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 0 clamp(16px, 3vw, 32px);
    padding: clamp(28px, 4vh, 44px) 0;
    border-bottom: 1px solid var(--color-line);
  }
  .aps-step:first-child { border-top: 1px solid var(--color-line); }
  .aps-step-num {
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 300;
    color: var(--color-ink-soft);
    opacity: 0.3;
    line-height: 1.1;
    padding-top: 2px;
