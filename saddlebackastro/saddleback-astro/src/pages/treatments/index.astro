---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const treatments = [
  {
    title: 'Root Canal Treatment',
    description: 'Definitive care for infected or inflamed pulp tissue. Modern, microscope-guided, typically completed in one visit.',
    href: '/treatments/root-canal-treatment/',
  },
  {
    title: 'Root Canal Retreatment',
    description: 'When a previous root canal has not resolved — we identify the cause and correct it.',
    href: '/treatments/root-canal-retreatment/',
  },
  {
    title: 'Apical Surgery / Apicoectomy',
    description: 'Microsurgical root-end resection when non-surgical treatment cannot reach the source of infection.',
    href: '/treatments/apical-surgery-apicoectomy/',
  },
  {
    title: 'Anxiety & Sedation',
    description: 'Nitrous oxide, oral sedation, and advanced local anesthesia techniques for anxious patients.',
    href: '/treatments/anxiety-sedation/',
  },
  {
    title: 'Dental Implants',
    description: 'A balanced comparison. Our philosophy: save the natural tooth first, when it is clinically reasonable.',
    href: '/treatments/dental-implant/',
  },
];
---

<BaseLayout
  title="Treatments — Saddleback Valley Endodontics"
  description="Root canal treatment, retreatment, apical surgery, sedation, and more — specialist endodontic care in Mission Viejo and Laguna Hills, CA. (949) 581-8890."
>
  <Header variant="solid" active="services" />

  <main>

    <section class="tx-hero">
      <div class="tx-hero-image">
        <img src="/images/Saddleback-Valley-Endodontics-team.webp" alt="Saddleback Valley Endodontics team" />
        <div class="tx-hero-overlay"></div>
      </div>
      <div class="tx-hero-content">
        <p class="tx-hero-eyebrow">Laguna Hills, CA</p>
        <h1 class="tx-hero-title">Specialist endodontics,<br/>close to home.</h1>
        <p class="tx-hero-sub">
          Saddleback Valley Endodontics serves Laguna Hills, Mission Viejo, Aliso Viejo, Lake
          Forest, Rancho Santa Margarita, and surrounding South Orange County — with same-day
          urgent appointments and fellowship-trained care for every case.
        </p>
        <a href="/request-an-appointment/" class="tx-hero-btn">Request an Appointment</a>
      </div>
    </section>

    <section class="tx-treatments">
      <div class="tx-treatments-header">
        <p class="tx-treatments-eyebrow" data-reveal>What We Treat</p>
        <h2 class="tx-treatments-headline" data-reveal>Every endodontic service, under one roof.</h2>
      </div>
      <div class="tx-treatment-grid">
        {treatments.map((t, i) => (
          <a class="tx-treatment-card" href={t.href} data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <h3 class="tx-treatment-title">{t.title}</h3>
            <p class="tx-treatment-desc">{t.description}</p>
            <span class="tx-treatment-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <section class="tx-cta-band">
      <div class="tx-cta-inner" data-reveal>
        <p class="tx-cta-eyebrow">Ready to schedule?</p>
        <h2 class="tx-cta-headline">Same-day urgent appointments available.</h2>
        <p class="tx-cta-body">
          Call <a href="tel:+19495818890">(949) 581-8890</a> or request an appointment online.
          We respond to every inquiry the same business day.
        </p>
        <a href="/request-an-appointment/" class="tx-cta-btn">Request an Appointment</a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  main { padding-top: var(--header-h); }

  .tx-hero {
    position: relative;
    min-height: 520px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .tx-hero-image {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .tx-hero-image img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .tx-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(10,10,10,0.25) 0%, rgba(10,10,10,0.65) 100%);
  }
  .tx-hero-content {
    position: relative;
    padding: clamp(56px, 10vh, 120px) clamp(28px, 6vw, 88px) 48px;
    color: #fff;
    max-width: 800px;
  }
  .tx-hero-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: rgba(255,255,255,0.65);
    margin: 0 0 20px;
  }
  .tx-hero-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(36px, 5.5vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0 0 18px;
    color: #fff;
  }
  .tx-hero-sub {
    font-size: clamp(15px, 1.4vw, 18px);
    color: rgba(255,255,255,0.82);
    margin: 0 0 32px;
    max-width: 52ch;
    line-height: 1.6;
  }
  .tx-hero-btn {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 16px 36px;
    border: 1px solid #fff;
    background: #fff;
    color: var(--color-ink);
    transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out);
  }
  .tx-hero-btn:hover { background: transparent; color: #fff; }

  .tx-treatments { padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px); }
  .tx-treatments-header { margin-bottom: clamp(48px, 7vh, 72px); }
  .tx-treatments-eyebrow { font-size: 11px; letter-spacing: 0.36em; text-transform: uppercase; font-weight: 500; color: var(--color-ink-soft); margin: 0 0 20px; }
  .tx-treatments-headline { font-family: var(--font-display); font-weight: 300; font-size: clamp(28px, 4vw, 52px); line-height: 1.1; letter-spacing: -0.01em; margin: 0; }

  .tx-treatment-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--color-line); border: 1px solid var(--color-line); }
  .tx-treatment-card { background: var(--color-paper); padding: clamp(32px, 4.5vw, 52px) clamp(24px, 3.5vw, 40px); display: flex; flex-direction: column; gap: 14px; transition: background 0.3s var(--ease-out); text-decoration: none; }
  .tx-treatment-card:hover { background: var(--color-paper-warm); }
  .tx-treatment-title { font-family: var(--font-display); font-weight: 400; font-size: clamp(18px, 2vw, 24px); line-height: 1.2; letter-spacing: -0.005em; margin: 0; color: var(--color-ink); }
  .tx-treatment-desc { font-size: clamp(13px, 1.1vw, 15px); line-height: 1.65; color: var(--color-ink-soft); margin: 0; flex: 1; }
  .tx-treatment-arrow { font-size: 18px; color: var(--color-ink-soft); margin-top: 8px; transition: transform 0.25s var(--ease-out); }
  .tx-treatment-card:hover .tx-treatment-arrow { transform: translateX(4px); }

  .tx-office-section { background: var(--color-paper-warm); border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px); }
  .tx-office-inner { max-width: 800px;
    margin: 0 auto; }
  .tx-office-eyebrow { font-size: 11px; letter-spacing: 0.36em; text-transform: uppercase; font-weight: 500; color: var(--color-ink-soft); margin: 0 0 20px; }
  .tx-office-headline { font-family: var(--font-display); font-weight: 300; font-size: clamp(28px, 4vw, 48px); line-height: 1.1; letter-spacing: -0.008em; margin: 0 0 clamp(40px, 6vh, 64px); }
  .tx-office-details { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(32px, 5vw, 56px); }
  .tx-detail-label { font-size: 10px; letter-spacing: 0.34em; text-transform: uppercase; font-weight: 500; color: var(--color-ink-soft); margin: 0 0 12px; }
  .tx-detail-value { font-family: var(--font-display); font-size: clamp(16px, 1.8vw, 22px); font-weight: 300; line-height: 1.4; color: var(--color-ink); margin: 0 0 8px; display: block; }
  .tx-detail-link { transition: color 0.2s; }
  .tx-detail-link:hover { color: var(--color-ink-soft); }
  .tx-detail-note { font-size: 13px; line-height: 1.55; color: var(--color-ink-soft); margin: 8px 0 0; }
  .tx-hours-list { list-style: none; margin: 0; padding: 0; }
  .tx-hours-list li { display: flex; justify-content: space-between; gap: 8px; font-size: 13px; color: var(--color-ink-soft); padding: 9px 0; border-bottom: 1px solid var(--color-line); }
  .tx-hours-list li:first-child { border-top: 1px solid var(--color-line); }

  .tx-cta-band { padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px); }
  .tx-cta-inner { max-width: 680px; }
  .tx-cta-eyebrow { font-size: 11px; letter-spacing: 0.36em; text-transform: uppercase; font-weight: 500; color: var(--color-ink-soft); margin: 0 0 28px; }
  .tx-cta-headline { font-family: var(--font-display); font-weight: 300; font-size: clamp(28px, 4vw, 52px); line-height: 1.1; letter-spacing: -0.01em; margin: 0 0 20px; }
  .tx-cta-body { font-size: clamp(15px, 1.3vw, 17px); line-height: 1.68; color: var(--color-ink-soft); margin: 0 0 36px; }
  .tx-cta-body a { border-bottom: 1px solid currentColor; transition: opacity 0.2s; }
  .tx-cta-body a:hover { opacity: 0.6; }
  .tx-cta-btn { display: inline-block; font-size: 12px; letter-spacing: 0.28em; text-transform: uppercase; font-weight: 500; padding: 16px 36px; border: 1px solid var(--color-ink); color: var(--color-ink); transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out); }
  .tx-cta-btn:hover { background: var(--color-ink); color: var(--color-paper); }

  @media (max-width: 960px) { .tx-treatment-grid { grid-template-columns: repeat(2, 1fr); } .tx-office-details { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 580px) { .tx-treatment-grid { grid-template-columns: 1fr; } .tx-office-details { grid-template-columns: 1fr; } .tx-hours-list li { flex-direction: column; gap: 2px; } }
</style>
