---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
---

<BaseLayout
  title="Post-Operative Instructions — Saddleback Valley Endodontics"
  description="Post-operative care instructions after root canal treatment or endodontic surgery at Saddleback Valley Endodontics. (949) 581-8890."
>
  <Header variant="solid" />

  <main>

    <section class="page-intro">
      <p class="page-eyebrow">For Patients</p>
      <h1 class="page-title">After your<br/>procedure.</h1>
      <p class="page-lede">
        Most patients recover quickly. Follow these instructions to stay comfortable
        and protect your results.
      </p>
    </section>

    <section class="poi-root-canal">
      <div class="poi-rc-inner">
        <div class="poi-section-header">
          <p class="poi-eyebrow" data-reveal>Root Canal Treatment</p>
          <h2 class="poi-headline" data-reveal>After root canal treatment.</h2>
        </div>
        <ol class="poi-numbered-list" data-reveal>
          <li class="poi-numbered-item">
            <span class="poi-item-num">1</span>
            <p class="poi-item-body">Do not eat until numbness wears off — you may bite your cheek or tongue without realizing it.</p>
          </li>
          <li class="poi-numbered-item">
            <span class="poi-item-num">2</span>
            <p class="poi-item-body">Mild to moderate soreness for 1–3 days is normal. Take ibuprofen (400–600 mg) every 6–8 hours with food, or acetaminophen if ibuprofen is contraindicated.</p>
          </li>
          <li class="poi-numbered-item">
            <span class="poi-item-num">3</span>
            <p class="poi-item-body">Avoid chewing on the treated tooth until a permanent crown is placed by your general dentist.</p>
          </li>
          <li class="poi-numbered-item">
            <span class="poi-item-num">4</span>
            <p class="poi-item-body">The temporary filling may feel slightly high — this usually self-corrects within a day. If it persists, call us.</p>
          </li>
          <li class="poi-numbered-item">
            <span class="poi-item-num">5</span>
            <p class="poi-item-body">Take any prescribed antibiotics for the full course, even if you feel better before they're finished.</p>
          </li>
          <li class="poi-numbered-item">
            <span class="poi-item-num">6</span>
            <p class="poi-item-body">Schedule your crown with your general dentist within 4–6 weeks. Delay increases fracture risk.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="poi-surgery">
      <div class="poi-surgery-inner">
        <div class="poi-section-header">
          <p class="poi-eyebrow" data-reveal>Endodontic Surgery</p>
          <h2 class="poi-headline" data-reveal>After endodontic surgery (apicoectomy).</h2>
        </div>
        <ol class="poi-numbered-list" data-reveal>
          <li class="poi-numbered-item">
            <span class="poi-item-num">1</span>
            <p class="poi-item-body">Apply ice to the outside of your face for 10 minutes on / 10 minutes off for the first 24 hours. This minimizes swelling.</p>
          </li>
          <li class="poi-numbered-item">
            <span class="poi-item-num">2</span>
            <p class="poi-item-body">Do not rinse, spit forcefully, or use a straw for 24 hours.</p>
          </li>
          <li class="poi-numbered-item">
            <span class="poi-item-num">3</span>
            <p class="poi-item-body">Eat soft foods for 3–5 days. Avoid anything hard, crunchy, or very hot near the surgical site.</p>
          </li>
          <li class="poi-numbered-item">
            <span class="poi-item-num">4</span>
            <p class="poi-item-body">Take ibuprofen and/or prescribed pain medication as directed. Discomfort peaks at 24–48 hours and improves steadily.</p>
          </li>
          <li class="poi-numbered-item">
            <span class="poi-item-num">5</span>
            <p class="poi-item-body">Mild bruising and swelling are expected and may peak at 48–72 hours. This is normal.</p>
          </li>
          <li class="poi-numbered-item">
            <span class="poi-item-num">6</span>
            <p class="poi-item-body">Sutures are typically removed at your follow-up appointment, usually within 5–7 days.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="poi-warning">
      <div class="poi-warning-inner">
        <div class="poi-section-header">
          <p class="poi-eyebrow" data-reveal>Complications</p>
          <h2 class="poi-headline" data-reveal>When to call us.</h2>
        </div>
        <div class="poi-warning-grid">
          <div class="poi-warning-card" data-reveal data-reveal-delay="1">
            <h3 class="poi-warning-title">Increasing pain after 3 days</h3>
            <p class="poi-warning-body">Pain that is getting worse — not better — after the first 72 hours may indicate a complication.</p>
          </div>
          <div class="poi-warning-card" data-reveal data-reveal-delay="2">
            <h3 class="poi-warning-title">Visible swelling that is spreading</h3>
            <p class="poi-warning-body">Swelling that extends beyond the treated area, especially toward the throat or eye, requires immediate attention.</p>
          </div>
          <div class="poi-warning-card" data-reveal data-reveal-delay="3">
            <h3 class="poi-warning-title">Fever above 101&deg;F</h3>
            <p class="poi-warning-body">Persistent fever following endodontic treatment or surgery should be evaluated promptly.</p>
          </div>
          <div class="poi-warning-card" data-reveal data-reveal-delay="4">
            <h3 class="poi-warning-title">Displaced or lost temporary filling</h3>
            <p class="poi-warning-body">If your temporary filling comes out completely, call us so we can replace it before bacteria re-enter the canal.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="poi-contact">
      <div class="poi-contact-inner" data-reveal>
        <h2 class="poi-contact-headline">Questions about your recovery?</h2>
        <p class="poi-contact-phone"><a href="tel:+19495818890">(949) 581-8890</a></p>
        <p class="poi-contact-address"><a href="https://maps.app.goo.gl/x2rcKTvkHVg4LKfw8" target="_blank" rel="noopener noreferrer">25261 Paseo De Valencia, Suite 3<br/>Laguna Hills, CA 92637</a></p>
        <p class="poi-contact-note">We return all calls the same business day.</p>
      </div>
    </section>

    <section class="poi-cta-band">
      <div class="poi-cta-inner" data-reveal>
        <h2 class="poi-cta-headline">Concerned about your recovery?</h2>
        <p class="poi-cta-body">
          Call us — we'd rather hear from you early than late.
        </p>
        <a href="tel:+19495818890" class="poi-cta-btn">Call (949) 581-8890</a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  main { padding-top: var(--header-h); }

  .page-intro {
    padding: clamp(80px, 13vh, 140px) clamp(28px, 6vw, 88px) clamp(60px, 9vh, 100px);
    max-width: 960px;
    margin: 0 auto;
    border-bottom: 1px solid var(--color-line);
  }
  .page-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 32px;
  }
  .page-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(48px, 7.5vw, 96px);
    line-height: 1;
    letter-spacing: -0.015em;
    margin: 0 0 28px;
  }
  .page-lede {
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.65;
    color: var(--color-ink-soft);
    max-width: 58ch;
    margin: 0;
  }

  /* Shared section utilities */
  .poi-eyebrow { font-size: 11px; letter-spacing: 0.36em; text-transform: uppercase; font-weight: 500; color: var(--color-ink-soft); margin: 0 0 20px; }
  .poi-headline { font-family: var(--font-display); font-weight: 300; font-size: clamp(28px, 4vw, 52px); line-height: 1.1; letter-spacing: -0.01em; margin: 0; }
  .poi-section-header { margin-bottom: clamp(40px, 6vh, 64px); }

  /* Numbered list shared */
  .poi-numbered-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .poi-numbered-item { display: grid; grid-template-columns: 40px 1fr; gap: clamp(20px, 2.5vw, 36px); align-items: baseline; padding: clamp(24px, 3.5vh, 36px) 0; border-bottom: 1px solid var(--color-line); }
  .poi-numbered-item:first-child { border-top: 1px solid var(--color-line); }
  .poi-item-num { font-family: var(--font-display); font-weight: 300; font-size: clamp(22px, 2.5vw, 32px); line-height: 1; color: var(--color-ink-soft); opacity: 0.35; }
  .poi-item-body { font-size: clamp(14px, 1.2vw, 16px); line-height: 1.7; color: var(--color-ink-soft); margin: 0; }

  /* Root canal section */
  .poi-root-canal { padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px); }
  .poi-rc-inner { max-width: 800px; margin: 0 auto; }

  /* Surgery section */
  .poi-surgery { background: var(--color-paper-warm); border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px); }
  .poi-surgery-inner { max-width: 800px; margin: 0 auto; }

  /* Warning cards */
  .poi-warning { padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px); }
  .poi-warning-inner { max-width: 1120px; margin: 0 auto; }
  .poi-warning-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--color-line); border: 1px solid var(--color-line); }
  .poi-warning-card { background: var(--color-paper-warm); padding: clamp(32px, 4.5vw, 52px) clamp(24px, 3.5vw, 40px); display: flex; flex-direction: column; gap: 14px; }
  .poi-warning-title { font-family: var(--font-display); font-weight: 400; font-size: clamp(18px, 2vw, 24px); line-height: 1.2; letter-spacing: -0.005em; margin: 0; color: var(--color-ink); }
  .poi-warning-body { font-size: clamp(13px, 1.1vw, 15px); line-height: 1.65; color: var(--color-ink-soft); margin: 0; }

  /* Contact section */
  .poi-contact { background: var(--color-paper-warm); border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px); }
  .poi-contact-inner { max-width: 680px; margin: 0 auto; text-align: center; }
  .poi-contact-headline { font-family: var(--font-display); font-weight: 300; font-size: clamp(28px, 4vw, 52px); line-height: 1.1; letter-spacing: -0.01em; margin: 0 0 clamp(24px, 3.5vh, 36px); color: var(--color-ink); }
  .poi-contact-phone { margin: 0 0 16px; }
  .poi-contact-phone a { font-family: var(--font-display); font-size: clamp(22px, 3vw, 36px); font-weight: 300; color: var(--color-ink); text-decoration: none; border-bottom: 1px solid var(--color-line); transition: opacity 0.2s; }
  .poi-contact-phone a:hover { opacity: 0.6; }
  .poi-contact-address { font-size: clamp(14px, 1.2vw, 16px); line-height: 1.65; color: var(--color-ink-soft); margin: 0 0 20px; }
  .poi-contact-note { font-size: 13px; letter-spacing: 0.02em; color: var(--color-ink-soft); margin: 0; opacity: 0.75; }

  /* CTA band */
  .poi-cta-band { background: var(--color-ink); color: var(--color-paper); padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px); }
  .poi-cta-inner { max-width: 680px; margin: 0 auto; text-align: center; }
  .poi-cta-headline { font-family: var(--font-display); font-weight: 300; font-size: clamp(28px, 4vw, 52px); line-height: 1.1; letter-spacing: -0.01em; margin: 0 0 20px; color: var(--color-paper); }
  .poi-cta-body { font-size: clamp(15px, 1.3vw, 17px); line-height: 1.68; color: rgba(255,255,255,0.7); margin: 0 0 36px; }
  .poi-cta-btn { display: inline-block; font-size: 12px; letter-spacing: 0.28em; text-transform: uppercase; font-weight: 500; padding: 16px 36px; border: 1px solid var(--color-paper); color: var(--color-paper); text-decoration: none; transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out); }
  .poi-cta-btn:hover { background: var(--color-paper); color: var(--color-ink); }

  @media (max-width: 720px) { .poi-warning-grid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .poi-numbered-item { grid-template-columns: 32px 1fr; } }
</style>
