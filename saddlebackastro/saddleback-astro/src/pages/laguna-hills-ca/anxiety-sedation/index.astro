---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const options = [
  {
    number: '01',
    name: 'Nitrous Oxide',
    body: 'Nitrous oxide (laughing gas) is inhaled through a small nasal mask and takes effect within a few minutes. It produces a state of mild sedation and euphoria — patients remain fully conscious, can communicate, and respond to instructions, but feel relaxed and detached from anxiety. The effect wears off completely within 5–10 minutes of stopping administration, so patients can drive themselves home. Nitrous oxide is our first-line option for patients with mild to moderate dental anxiety.',
    details: ['Onset in 3–5 minutes', 'Fully alert and communicative throughout', 'Wears off in 5–10 minutes after stopping', 'Safe to drive afterward', 'Available at no additional cost for anxious patients'],
  },
  {
    number: '02',
    name: 'Oral Sedation',
    body: 'For patients with more significant anxiety, a prescribed oral sedative (typically a benzodiazepine such as triazolam) is taken 30–60 minutes before the appointment. Oral sedation produces deeper relaxation than nitrous oxide — patients are more profoundly calm and often have partial or complete amnesia for the procedure. Patients must arrange a driver for the day of their appointment; they should not drive or make important decisions for the remainder of the day.',
    details: ['Prescribed the day before', 'A driver is required — no exceptions', 'Deeper sedation than nitrous oxide', 'Partial or full amnesia for the procedure is common', 'Vital signs monitored throughout'],
  },
];

const faqs = [
  {
    q: 'Will I be unconscious during sedation?',
    a: 'Neither nitrous oxide nor oral sedation produces unconsciousness. Both are forms of conscious sedation — you remain awake, can breathe on your own, and respond to questions. The goal is comfort and anxiety reduction, not general anesthesia. If you require IV sedation or general anesthesia, we can discuss referral options.',
  },
  {
    q: 'Is sedation safe for root canal treatment?',
    a: 'Yes. Conscious sedation is safe for most healthy adults. At your consultation, we review your medical history and any medications you take. Patients with certain medical conditions may require medical clearance or alternative approaches. The combination of local anesthesia and conscious sedation is well-established in endodontic practice.',
  },
  {
    q: 'Do I still need local anesthesia with sedation?',
    a: 'Yes — local anesthesia is always used regardless of sedation method. Sedation reduces anxiety; local anesthesia prevents pain by numbing the tooth and surrounding tissues. Sedation does not replace the need for profound local anesthesia. The two work together.',
  },
  {
    q: 'How do I request sedation?',
    a: 'Tell us at your consultation or when you call to schedule. We will discuss which option is appropriate for you, review your medical history, and make any necessary arrangements — including a prescription for oral sedation if indicated. There is no judgment for needing sedation; dental anxiety is common and we accommodate it routinely.',
  },
];
---

<BaseLayout
  title="Anxiety & Sedation for Root Canals in Laguna Hills, CA — Saddleback Valley Endodontics"
  description="Nitrous oxide and oral sedation for anxious patients in Laguna Hills and Mission Viejo, CA. Comfortable, stress-free endodontic care. (949) 837-3033."
>
  <Header variant="solid" />

  <main>

    <section class="page-intro">
      <p class="page-eyebrow">Anxiety & Sedation · Laguna Hills, CA</p>
      <h1 class="page-title">Comfortable care,<br/>without the fear.</h1>
      <p class="page-lede">
        Dental anxiety is common and nothing to be embarrassed about. We offer nitrous oxide
        and oral sedation to help patients who need it get the treatment they need, without
        dread or distress.
      </p>
    </section>

    <section class="sed-intro-section">
      <div class="sed-intro-inner">
        <h2 class="sed-intro-headline">You do not have to white-knuckle it.</h2>
        <p class="sed-intro-body">
          Anxiety about dental procedures — and root canals in particular — keeps people from seeking care they need. The longer a tooth problem goes untreated, the more complex and difficult it becomes. We have seen patients arrive in acute pain because they delayed treatment for months or years out of fear. Sedation removes that barrier.
        </p>
        <p class="sed-intro-body">
          Our approach is to make every appointment as comfortable as possible regardless of sedation. That means taking time with anesthesia, explaining each step, and never rushing. Sedation is available for any patient who needs it — not just those with severe phobias.
        </p>
      </div>
    </section>

    <section class="sed-options-section">
      <p class="sed-options-eyebrow">Sedation Options</p>
      <h2 class="sed-options-headline">Two levels of relief.</h2>
      <div class="sed-options-grid">
        {options.map(o => (
          <div class="sed-option">
            <span class="sed-option-num">{o.number}</span>
            <h3 class="sed-option-name">{o.name}</h3>
            <p class="sed-option-body">{o.body}</p>
            <ul class="sed-option-details">
              {o.details.map(d => <li>{d}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="sed-faq-section">
      <div class="sed-faq-header">
        <p class="sed-faq-eyebrow">Common Questions</p>
        <h2 class="sed-faq-headline">Sedation FAQ.</h2>
      </div>
      <div class="sed-faq-list">
        {faqs.map(f => (
          <details class="sed-faq-item" name="sed-faq">
            <summary class="sed-faq-q">
              <span>{f.q}</span>
              <span class="sed-faq-icon" aria-hidden="true"></span>
            </summary>
            <div class="sed-faq-a">
              <p>{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <section class="sed-cta-band">
      <div class="sed-cta-inner">
        <p class="sed-cta-eyebrow">Serving Laguna Hills & Mission Viejo</p>
        <h2 class="sed-cta-headline">Let us know — we will take care of the rest.</h2>
        <p class="sed-cta-body">
          Call <a href="tel:+19498373033">(949) 837-3033</a> and tell us you would like sedation.
          We will arrange it before your appointment. Located at 25800 Jeronimo Road, Suite 300, Mission Viejo.
        </p>
        <a href="/request-an-appointment/" class="sed-cta-btn">Request an Appointment</a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  main { padding-top: var(--header-h); }

  .page-intro {
    padding: clamp(80px, 13vh, 140px) clamp(28px, 6vw, 88px) clamp(60px, 9vh, 100px);
    max-width: 960px;
    border-bottom: 1px solid var(--color-line);
  }
  .page-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 32px;
  }
  .page-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(52px, 8vw, 104px);
    line-height: 1;
    letter-spacing: -0.015em;
    margin: 0 0 28px;
  }
  .page-lede {
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.65;
    color: var(--color-ink-soft);
    max-width: 58ch;
    margin: 0;
  }

  .sed-intro-section {
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
    border-bottom: 1px solid var(--color-line);
  }
  .sed-intro-inner { max-width: 760px; }
  .sed-intro-headline {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(28px, 4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 28px;
  }
  .sed-intro-body {
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.72;
    color: var(--color-ink-soft);
    margin: 0 0 18px;
  }

  .sed-options-section {
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
    border-bottom: 1px solid var(--color-line);
  }
  .sed-options-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 20px;
  }
  .sed-options-headline {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(28px, 4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 clamp(48px, 7vh, 72px);
  }
  .sed-options-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 64px);
    max-width: 1100px;
  }
  .sed-option {
    border-top: 1px solid var(--color-line);
    padding-top: clamp(28px, 4vh, 44px);
  }
  .sed-option-num {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 300;
    color: var(--color-ink-soft);
    opacity: 0.28;
    display: block;
    margin-bottom: 16px;
    line-height: 1;
  }
  .sed-option-name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.1;
    margin: 0 0 16px;
    letter-spacing: -0.005em;
  }
  .sed-option-body {
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.72;
    color: var(--color-ink-soft);
    margin: 0 0 24px;
  }
  .sed-option-details {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sed-option-details li {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    padding: 9px 0 9px 16px;
    border-bottom: 1px solid var(--color-line);
    position: relative;
  }
  .sed-option-details li:first-child { border-top: 1px solid var(--color-line); }
  .sed-option-details li::before {
    content: '';
    position: absolute;
    left: 0; top: 50%;
    width: 6px; height: 1px;
    background: currentColor;
    opacity: 0.5;
  }

  .sed-faq-section {
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
    border-bottom: 1px solid var(--color-line);
  }
  .sed-faq-header { margin-bottom: clamp(40px, 6vh, 60px); }
  .sed-faq-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 20px;
  }
  .sed-faq-headline {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(28px, 4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .sed-faq-list { max-width: 840px; }
  .sed-faq-item { border-bottom: 1px solid var(--color-line); }
  .sed-faq-item:first-child { border-top: 1px solid var(--color-line); }
  .sed-faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(20px, 3vh, 30px) 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: clamp(18px, 2vw, 26px);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-ink);
    transition: color 0.2s var(--ease-out);
  }
  .sed-faq-q::-webkit-details-marker { display: none; }
  .sed-faq-q:hover { color: var(--color-ink-soft); }
  .sed-faq-icon {
    flex-shrink: 0;
    width: 20px; height: 20px;
    position: relative;
  }
  .sed-faq-icon::before,
  .sed-faq-icon::after {
    content: '';
    position: absolute;
    background: currentColor;
    transition: transform 0.3s var(--ease-out), opacity 0.25s var(--ease-out);
  }
  .sed-faq-icon::before { width: 1px; height: 100%; left: 50%; top: 0; transform: translateX(-50%); }
  .sed-faq-icon::after  { width: 100%; height: 1px; top: 50%; left: 0; transform: translateY(-50%); }
  .sed-faq-item[open] .sed-faq-icon::before { transform: translateX(-50%) rotate(90deg); opacity: 0; }
  .sed-faq-a {
    padding: 0 0 clamp(20px, 3.5vh, 32px);
    max-width: 66ch;
  }
  .sed-faq-a p {
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.72;
    color: var(--color-ink-soft);
    margin: 0;
  }

  .sed-cta-band { padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px); }
  .sed-cta-inner { max-width: 640px; }
  .sed-cta-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 28px;
  }
  .sed-cta-headline {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.008em;
    margin: 0 0 20px;
  }
  .sed-cta-body {
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.68;
    color: var(--color-ink-soft);
    margin: 0 0 36px;
  }
  .sed-cta-body a { border-bottom: 1px solid currentColor; transition: opacity 0.2s; }
  .sed-cta-body a:hover { opacity: 0.6; }
  .sed-cta-btn {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 16px 36px;
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
    transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out);
  }
  .sed-cta-btn:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  @media (max-width: 700px) {
    .sed-options-grid { grid-template-columns: 1fr; }
  }
</style>
