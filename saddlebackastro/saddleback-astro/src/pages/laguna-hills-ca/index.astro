---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const treatments = [
  {
    title: 'Root Canal Treatment',
    description: 'Definitive care for infected or inflamed pulp tissue. Modern, microscope-guided, typically completed in one visit.',
    href: '/laguna-hills-ca/root-canal-treatment/',
  },
  {
    title: 'Root Canal Retreatment',
    description: 'When a previous root canal has not resolved — we identify the cause and correct it.',
    href: '/laguna-hills-ca/root-canal-retreatment/',
  },
  {
    title: 'Apical Surgery / Apicoectomy',
    description: 'Microsurgical root-end resection when non-surgical treatment cannot reach the source of infection.',
    href: '/laguna-hills-ca/apical-surgery-apicoectomy/',
  },
  {
    title: 'Root Canal Safety',
    description: 'Evidence-based answers to common concerns about root canal treatment and long-term health.',
    href: '/laguna-hills-ca/root-canal-safety/',
  },
  {
    title: 'Anxiety & Sedation',
    description: 'Nitrous oxide, oral sedation, and advanced local anesthesia techniques for anxious patients.',
    href: '/laguna-hills-ca/anxiety-sedation/',
  },
  {
    title: 'Implants vs. Root Canals',
    description: 'A balanced comparison. Our philosophy: save the natural tooth first, when it is clinically reasonable.',
    href: '/laguna-hills-ca/dental-implant/',
  },
  {
    title: 'Technology',
    description: 'Operating microscope, CBCT, NiTi rotary instruments, and digital X-ray — the tools behind better outcomes.',
    href: '/laguna-hills-ca/technology/',
  },
];
---

<BaseLayout
  title="Endodontist in Laguna Hills, CA — Saddleback Valley Endodontics"
  description="Saddleback Valley Endodontics serves Laguna Hills, Mission Viejo, Aliso Viejo, Lake Forest, and surrounding Orange County. Board-certified endodontists, same-day urgent appointments."
>
  <Header variant="solid" />

  <main>

    <section class="page-intro">
      <p class="page-eyebrow">Laguna Hills, CA</p>
      <h1 class="page-title">Specialist endodontics,<br/>close to home.</h1>
      <p class="page-lede">
        Saddleback Valley Endodontics serves Laguna Hills, Mission Viejo, Aliso Viejo, Lake
        Forest, Rancho Santa Margarita, and surrounding South Orange County — with same-day
        urgent appointments and fellowship-trained care for every case.
      </p>
    </section>

    <section class="lh-treatments">
      <div class="lh-treatments-header">
        <p class="lh-treatments-eyebrow">What We Treat</p>
        <h2 class="lh-treatments-headline">Specialist services for Laguna Hills patients.</h2>
      </div>
      <div class="lh-treatment-grid">
        {treatments.map(t => (
          <a class="lh-treatment-card" href={t.href}>
            <h3 class="lh-treatment-title">{t.title}</h3>
            <p class="lh-treatment-desc">{t.description}</p>
            <span class="lh-treatment-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <section class="lh-office-section">
      <div class="lh-office-inner">
        <div class="lh-office-info">
          <p class="lh-office-eyebrow">Our Office</p>
          <h2 class="lh-office-headline">Convenient to Laguna Hills<br/>and all of South OC.</h2>
          <div class="lh-office-details">
            <div class="lh-office-detail-group">
              <p class="lh-detail-label">Address</p>
              <p class="lh-detail-value">25800 Jeronimo Road, Suite 300<br/>Mission Viejo, CA 92691</p>
              <p class="lh-detail-note">Free parking in the medical building garage. Just minutes from Laguna Hills via the 5 Freeway.</p>
            </div>
            <div class="lh-office-detail-group">
              <p class="lh-detail-label">Phone</p>
              <a href="tel:+19498373033" class="lh-detail-value lh-detail-link">(949) 837-3033</a>
            </div>
            <div class="lh-office-detail-group">
              <p class="lh-detail-label">Hours</p>
              <ul class="lh-hours-list">
                <li><span>Monday – Thursday</span><span>8:00 am – 5:00 pm</span></li>
                <li><span>Friday</span><span>8:00 am – 2:00 pm</span></li>
                <li><span>Saturday – Sunday</span><span>Closed</span></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="lh-cta-band">
      <div class="lh-cta-inner">
        <p class="lh-cta-eyebrow">Ready to schedule?</p>
        <h2 class="lh-cta-headline">Same-day urgent appointments available for Laguna Hills patients.</h2>
        <p class="lh-cta-body">
          Call <a href="tel:+19498373033">(949) 837-3033</a> or request an appointment online.
          We respond to every inquiry the same business day.
        </p>
        <a href="/request-an-appointment/" class="lh-cta-btn">Request an Appointment</a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  main { padding-top: var(--header-h); }

  .page-intro {
    padding: clamp(80px, 13vh, 140px) clamp(28px, 6vw, 88px) clamp(60px, 9vh, 100px);
    max-width: 960px;
    border-bottom: 1px solid var(--color-line);
  }
  .page-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 32px;
  }
  .page-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(48px, 7.5vw, 96px);
    line-height: 1;
    letter-spacing: -0.015em;
    margin: 0 0 28px;
  }
  .page-lede {
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.65;
    color: var(--color-ink-soft);
    max-width: 58ch;
    margin: 0;
  }

  .lh-treatments {
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
  }

  .lh-treatments-header {
    margin-bottom: clamp(48px, 7vh, 72px);
  }

  .lh-treatments-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 20px;
  }

  .lh-treatments-headline {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(28px, 4vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .lh-treatment-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }

  .lh-treatment-card {
    background: var(--color-paper);
    padding: clamp(32px, 4.5vw, 52px) clamp(24px, 3.5vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: background 0.3s var(--ease-out);
    text-decoration: none;
  }
  .lh-treatment-card:hover {
    background: var(--color-paper-warm);
  }

  .lh-treatment-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.2;
    letter-spacing: -0.005em;
    margin: 0;
    color: var(--color-ink);
  }

  .lh-treatment-desc {
    font-size: clamp(13px, 1.1vw, 15px);
    line-height: 1.65;
    color: var(--color-ink-soft);
    margin: 0;
    flex: 1;
  }

  .lh-treatment-arrow {
    font-size: 18px;
    color: var(--color-ink-soft);
    margin-top: 8px;
    transition: transform 0.25s var(--ease-out);
  }
  .lh-treatment-card:hover .lh-treatment-arrow {
    transform: translateX(4px);
  }

  .lh-office-section {
    background: var(--color-paper-warm);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
  }

  .lh-office-inner { max-width: 800px; }

  .lh-office-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 20px;
  }

  .lh-office-headline {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.008em;
    margin: 0 0 clamp(40px, 6vh, 64px);
  }

  .lh-office-details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(32px, 5vw, 56px);
  }

  .lh-detail-label {
    font-size: 10px;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 12px;
  }

  .lh-detail-value {
    font-family: var(--font-display);
    font-size: clamp(16px, 1.8vw, 22px);
    font-weight: 300;
    line-height: 1.4;
    color: var(--color-ink);
    margin: 0 0 8px;
    display: block;
  }

  .lh-detail-link { transition: color 0.2s; }
  .lh-detail-link:hover { color: var(--color-ink-soft); }

  .lh-detail-note {
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-ink-soft);
    margin: 8px 0 0;
  }

  .lh-hours-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lh-hours-list li {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-size: 13px;
    color: var(--color-ink-soft);
    padding: 9px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .lh-hours-list li:first-child { border-top: 1px solid var(--color-line); }

  .lh-cta-band {
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
  }

  .lh-cta-inner { max-width: 680px; }

  .lh-cta-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 28px;
  }

  .lh-cta-headline {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(28px, 4vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 20px;
  }

  .lh-cta-body {
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.68;
    color: var(--color-ink-soft);
    margin: 0 0 36px;
  }
  .lh-cta-body a { border-bottom: 1px solid currentColor; transition: opacity 0.2s; }
  .lh-cta-body a:hover { opacity: 0.6; }

  .lh-cta-btn {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 16px 36px;
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
    transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out);
  }
  .lh-cta-btn:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  @media (max-width: 960px) {
    .lh-treatment-grid { grid-template-columns: repeat(2, 1fr); }
    .lh-office-details { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 580px) {
    .lh-treatment-grid { grid-template-columns: 1fr; }
    .lh-office-details { grid-template-columns: 1fr; }
    .lh-hours-list li { flex-direction: column; gap: 2px; }
  }
</style>
