---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const technologies = [
  {
    number: '01',
    name: 'Operating Microscope',
    tagline: 'We see what cannot otherwise be seen.',
    body: 'The operating microscope changed endodontics more than any other single development. At magnifications between 4× and 25×, with coaxial illumination that follows the surgeon\'s line of sight directly into the canal, structures that were invisible become workable: calcified canal orifices, hairline cracks, missed accessory canals, separated file fragments. Every procedure — surgical and non-surgical — is performed under microscope magnification at our Laguna Hills–area office.',
    specs: ['4× to 25× magnification range', 'Coaxial LED illumination', 'Video documentation of every case', 'Used in all surgical and non-surgical procedures'],
  },
  {
    number: '02',
    name: 'Cone-Beam CT Imaging',
    tagline: 'Three dimensions before the first instrument.',
    body: 'Conventional dental X-rays are two-dimensional projections of three-dimensional anatomy. They miss things — extra canals, the true extent of resorption, the precise location of a root tip relative to the mandibular nerve or maxillary sinus. Cone-beam CT gives us a volumetric image we can navigate slice by slice. We use CBCT selectively: not as a default, but for cases where the three-dimensional picture changes the treatment decision. We use limited-field, low-dose protocols to minimize radiation exposure.',
    specs: ['Limited-field, low-dose CBCT', 'Sub-millimeter voxel resolution', 'Surgical planning and trauma assessment', 'Identifies extra canals, resorption, fractures'],
  },
  {
    number: '03',
    name: 'NiTi Rotary Instrumentation',
    tagline: 'Precision inside a curved canal.',
    body: 'Nickel-titanium rotary files are super-elastic — they follow the natural curve of a root canal without straightening it, perforating it, or breaking. We use a single-use protocol: every file set is used once, then discarded. This eliminates instrument fatigue as a failure mode entirely. Electronic apex locators confirm working length in real time throughout instrumentation. The combination of rotary NiTi files and precise length measurement has made canal preparation far more predictable than older hand-filing techniques.',
    specs: ['Reciprocating and continuous-rotation systems', 'Single-use protocol — no instrument reuse', 'Electronic apex locator throughout', 'Matched to canal anatomy case by case'],
  },
  {
    number: '04',
    name: 'Digital Radiography',
    tagline: 'Immediate, low-dose, high-resolution.',
    body: 'We use direct digital radiography for all intraoral imaging. Images appear instantly, can be adjusted and zoomed at chairside without losing resolution, and expose patients to up to 90% less radiation than conventional film. For endodontic treatment, we typically take working-length, mid-treatment, and final-obturation radiographs — all reviewed on a large monitor at the chair in real time.',
    specs: ['Up to 90% less radiation than film', 'Immediate chairside display and review', 'Digital sharing with referring dentist', 'High-contrast periapical sensors'],
  },
];
---

<BaseLayout
  title="Endodontic Technology in Laguna Hills, CA — Saddleback Valley Endodontics"
  description="Operating microscope, cone-beam CT, NiTi rotary instrumentation, and digital radiography at our Laguna Hills–area endodontic office. (949) 837-3033."
>
  <Header variant="solid" />

  <main>

    <section class="page-intro">
      <p class="page-eyebrow">Technology · Laguna Hills, CA</p>
      <h1 class="page-title">The tools that<br/>let us see.</h1>
      <p class="page-lede">
        Endodontics has been transformed by instrumentation that makes the invisible visible.
        Every procedure at our Laguna Hills–area office uses the full arsenal — selectively
        and deliberately.
      </p>
    </section>

    <section class="lhtech-list">
      {technologies.map((t, i) => (
        <article class={`lhtech-row ${i % 2 === 1 ? 'lhtech-row--reverse' : ''}`}>
          <div class="lhtech-content">
            <p class="lhtech-number">{t.number}</p>
            <h2 class="lhtech-name">{t.name}</h2>
            <p class="lhtech-tagline">{t.tagline}</p>
            <p class="lhtech-body">{t.body}</p>
            <ul class="lhtech-specs">
              {t.specs.map(s => <li>{s}</li>)}
            </ul>
          </div>
          <div class="lhtech-accent"></div>
        </article>
      ))}
    </section>

    <section class="lhtech-cta">
      <div class="lhtech-cta-inner">
        <p class="lhtech-cta-eyebrow">Serving Laguna Hills & South Orange County</p>
        <h2 class="lhtech-cta-headline">Precision endodontics, close to home.</h2>
        <p class="lhtech-cta-body">
          Call <a href="tel:+19498373033">(949) 837-3033</a> to schedule.
          Located at 25800 Jeronimo Road, Suite 300, Mission Viejo — minutes from Laguna Hills,
          Lake Forest, and Aliso Viejo.
        </p>
        <a href="/request-an-appointment/" class="lhtech-cta-btn">Request an Appointment</a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  main { padding-top: var(--header-h); }

  .page-intro {
    padding: clamp(80px, 13vh, 140px) clamp(28px, 6vw, 88px) clamp(60px, 9vh, 100px);
    max-width: 960px;
    border-bottom: 1px solid var(--color-line);
  }
  .page-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 32px;
  }
  .page-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(52px, 8vw, 104px);
    line-height: 1;
    letter-spacing: -0.015em;
    margin: 0 0 28px;
  }
  .page-lede {
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.65;
    color: var(--color-ink-soft);
    max-width: 58ch;
    margin: 0;
  }

  .lhtech-list { }

  .lhtech-row {
    display: grid;
    grid-template-columns: 1fr 420px;
    min-height: 560px;
    border-bottom: 1px solid var(--color-line);
  }
  .lhtech-row--reverse { grid-template-columns: 420px 1fr; }
  .lhtech-row--reverse .lhtech-content { order: 2; }
  .lhtech-row--reverse .lhtech-accent { order: 1; }

  .lhtech-content {
    padding: clamp(56px, 8vw, 96px) clamp(40px, 6vw, 80px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .lhtech-accent {
    background: var(--color-paper-warm);
    border-left: 1px solid var(--color-line);
  }
  .lhtech-row--reverse .lhtech-accent {
    border-left: 0;
    border-right: 1px solid var(--color-line);
  }

  .lhtech-number {
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 300;
    color: var(--color-ink-soft);
    opacity: 0.28;
    margin: 0 0 24px;
    line-height: 1;
  }
  .lhtech-name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(26px, 3.2vw, 40px);
    line-height: 1.08;
    letter-spacing: -0.005em;
    margin: 0 0 12px;
  }
  .lhtech-tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(15px, 1.5vw, 19px);
    color: var(--color-ink-soft);
    margin: 0 0 24px;
    line-height: 1.4;
  }
  .lhtech-body {
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.72;
    color: var(--color-ink-soft);
    margin: 0 0 28px;
    max-width: 58ch;
  }
  .lhtech-specs {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lhtech-specs li {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    padding: 10px 0 10px 16px;
    border-bottom: 1px solid var(--color-line);
    position: relative;
  }
  .lhtech-specs li:first-child { border-top: 1px solid var(--color-line); }
  .lhtech-specs li::before {
    content: '';
    position: absolute;
    left: 0; top: 50%;
    width: 6px; height: 1px;
    background: currentColor;
  }

  .lhtech-cta {
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
    border-top: 1px solid var(--color-line);
  }
  .lhtech-cta-inner { max-width: 640px; }
  .lhtech-cta-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 28px;
  }
  .lhtech-cta-headline {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.008em;
    margin: 0 0 20px;
  }
  .lhtech-cta-body {
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.68;
    color: var(--color-ink-soft);
    margin: 0 0 36px;
  }
  .lhtech-cta-body a { border-bottom: 1px solid currentColor; transition: opacity 0.2s; }
  .lhtech-cta-body a:hover { opacity: 0.6; }
  .lhtech-cta-btn {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 16px 36px;
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
    transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out);
  }
  .lhtech-cta-btn:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  @media (max-width: 860px) {
    .lhtech-row,
    .lhtech-row--reverse {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .lhtech-row .lhtech-content,
    .lhtech-row--reverse .lhtech-content { order: 1; }
    .lhtech-accent { display: none; }
  }
</style>
