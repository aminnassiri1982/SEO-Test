---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const sections = [
  {
    id: 'insurance-accepted',
    title: 'Insurance Accepted',
    body: 'We are in-network with most major PPO dental insurance plans, including Delta Dental PPO, Cigna DPPO, Aetna PPO, MetLife PDP, Guardian, and United Concordia. We will verify your benefits before your appointment and provide a written estimate of your expected out-of-pocket cost. We submit claims electronically on your behalf and follow up on outstanding claims. We do not participate in HMO, DHMO, or Medi-Cal/Denti-Cal plans.',
  },
  {
    id: 'payment-at-service',
    title: 'Payment Due at Time of Service',
    body: 'Patient portions — after the estimated insurance benefit — are due at the time of service. We accept Visa, Mastercard, American Express, Discover, personal checks, and cash. For patients without insurance, full payment is due at the time of treatment. We are happy to provide a superbill or itemized statement for any purpose.',
  },
  {
    id: 'payment-plans',
    title: 'Payment Plans — CareCredit',
    body: 'We accept CareCredit, a healthcare financing card that offers promotional deferred-interest and fixed-payment financing options. CareCredit applications can be completed online at carecredit.com or at our front desk. Approval is typically immediate. Extended payment plans through CareCredit allow patients to begin treatment without delaying care for financial reasons.',
  },
  {
    id: 'hsa-fsa',
    title: 'HSA & FSA',
    body: 'Health Savings Accounts (HSA) and Flexible Spending Accounts (FSA) are accepted for all dental treatment. Endodontic services are qualified medical expenses under IRS guidelines. If your employer-sponsored FSA has a use-it-or-lose-it deadline, we can help you plan appointments to maximize your benefit before it expires.',
  },
  {
    id: 'out-of-network',
    title: 'Out-of-Network Insurance',
    body: 'If we are not in-network with your plan, you may still receive care here. We will file your claim as a courtesy, and most PPO plans provide some reimbursement for out-of-network specialist services. The difference between our fee and your plan\'s allowable amount — known as the "balance" — is your responsibility. We will give you a clear estimate before treatment so there are no surprises.',
  },
  {
    id: 'fee-estimates',
    title: 'Fee Estimates',
    body: 'We provide a written fee estimate at or before every appointment. Estimates are based on the treatment plan discussed and the benefit information provided by your insurance carrier. Because actual insurance payments can differ from estimated allowances, the estimate is not a guarantee of total cost. If the scope of treatment changes during the procedure — for example, if additional canals are discovered — we will inform you before proceeding.',
  },
  {
    id: 'balance-billing',
    title: 'Balances & Collections',
    body: 'Unpaid balances remaining 60 days after insurance adjudication are due in full. We send one reminder statement before a balance is referred for collection. If you are experiencing a financial hardship, please contact our office before your balance becomes overdue — we prefer to find a workable arrangement over involving a collection process.',
  },
];
---

<BaseLayout
  title="Financial Policy — Saddleback Valley Endodontics"
  description="Saddleback Valley Endodontics accepts most PPO dental insurance, CareCredit, HSA/FSA, and all major credit cards. Transparent fee estimates before every procedure."
>
  <Header variant="solid" />

  <main>

    <section class="page-intro">
      <p class="page-eyebrow">Financial Policy</p>
      <h1 class="page-title">Clear about cost.</h1>
      <p class="page-lede">
        We believe cost transparency is part of good care. You will receive a written fee
        estimate before treatment begins — not an approximation, but a line-by-line breakdown
        of what you are expected to owe.
      </p>
    </section>

    <section class="fin-main">
      <div class="fin-list">
        {sections.map(s => (
          <div class="fin-item" id={s.id}>
            <h2 class="fin-item-title">{s.title}</h2>
            <p class="fin-item-body">{s.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="fin-cta-band">
      <div class="fin-cta-inner">
        <p class="fin-cta-eyebrow">Have a billing question?</p>
        <h2 class="fin-cta-headline">Our team is happy to walk through the numbers.</h2>
        <p class="fin-cta-body">
          Call us at <a href="tel:+19495818890">(949) 581-8890</a> during office hours and ask
          for our financial coordinator. We can verify your benefits, explain your estimate, or
          help you apply for CareCredit.
        </p>
        <a href="/contact/" class="fin-cta-btn">Contact Us</a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  main { padding-top: var(--header-h); }

  .page-intro {
    padding: clamp(80px, 13vh, 140px) clamp(28px, 6vw, 88px) clamp(60px, 9vh, 100px);
    max-width: 960px;
    border-bottom: 1px solid var(--color-line);
  }
  .page-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 32px;
  }
  .page-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(52px, 8vw, 104px);
    line-height: 1;
    letter-spacing: -0.015em;
    margin: 0 0 28px;
  }
  .page-lede {
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.65;
    color: var(--color-ink-soft);
    max-width: 58ch;
    margin: 0;
  }

  .fin-main {
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
  }

  .fin-list {
    max-width: 800px;
    display: flex;
    flex-direction: column;
  }

  .fin-item {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: clamp(24px, 4vw, 56px);
    padding: clamp(40px, 6vh, 64px) 0;
    border-bottom: 1px solid var(--color-line);
    align-items: start;
  }
  .fin-item:first-child { border-top: 1px solid var(--color-line); }

  .fin-item-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(17px, 1.8vw, 22px);
    line-height: 1.25;
    letter-spacing: -0.005em;
    margin: 0;
    padding-top: 3px;
    color: var(--color-ink);
  }

  .fin-item-body {
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.72;
    color: var(--color-ink-soft);
    margin: 0;
  }

  .fin-cta-band {
    background: var(--color-paper-warm);
    border-top: 1px solid var(--color-line);
    padding: clamp(80px, 12vh, 140px) clamp(28px, 6vw, 88px);
  }

  .fin-cta-inner { max-width: 640px; }

  .fin-cta-eyebrow {
    font-size: 11px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-ink-soft);
    margin: 0 0 28px;
  }

  .fin-cta-headline {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.008em;
    margin: 0 0 20px;
  }

  .fin-cta-body {
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.68;
    color: var(--color-ink-soft);
    margin: 0 0 36px;
  }
  .fin-cta-body a { border-bottom: 1px solid currentColor; transition: opacity 0.2s; }
  .fin-cta-body a:hover { opacity: 0.6; }

  .fin-cta-btn {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 16px 36px;
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
    transition: background 0.28s var(--ease-out), color 0.28s var(--ease-out);
  }
  .fin-cta-btn:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  @media (max-width: 680px) {
    .fin-item { grid-template-columns: 1fr; gap: 10px; }
  }
</style>
